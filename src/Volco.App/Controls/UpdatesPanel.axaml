<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Volco.App.Controls.UpdatesPanel">
  <Border Classes="Panel">
    <StackPanel Spacing="14">
      <TextBlock Text="Updates" Classes="Subtitle"/>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Name="CurrentVersionText" Text="Current version: v0.0.0"/>
          <TextBlock Name="StatusText" Classes="Secondary" TextWrapping="Wrap"
                     Text="Check for updates to see whether a newer Volco is available."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="CheckButton" Content="Check for updates"/>
          <Button Name="UpdateButton" Content="Update now" Classes="Primary" IsEnabled="False"/>
        </StackPanel>
      </Grid>

      <ProgressBar Name="Progress" IsIndeterminate="False" Minimum="0" Maximum="1" Value="0" IsVisible="False"/>

      <TextBlock Name="NotesText" Classes="Caption" TextWrapping="Wrap" IsVisible="False"/>
    </StackPanel>
  </Border>
</UserControl>
