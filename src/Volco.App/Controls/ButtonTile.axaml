<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Volco.App.ViewModels"
             xmlns:conv="using:Volco.App.Converters"
             xmlns:controls="using:Volco.App.Controls"
             x:Class="Volco.App.Controls.ButtonTile"
             x:DataType="vm:ButtonItemViewModel"
             Focusable="True" ToolTip.Tip="{Binding Heading}">
  <!-- The page fills "Swap with" when the menu opens (StagePage.OnTileContextRequested) -->
  <UserControl.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Swap with"/>
    </ContextMenu>
  </UserControl.ContextMenu>
  <!-- One button on the Controls page's drawing (spec §4.3). Its four rows (indicator, cap, main
       action, other actions) share their heights with every tile on the board, so caps and
       action lists line up whatever each button has. -->
  <!-- TileFlash adds "flash" when the controller reports the control -->
  <Panel Name="TileRoot" Classes="TileRoot">
    <Border Name="TileBorder" Classes="Tile" Classes.selected="{Binding IsSelected}">
      <Grid ColumnDefinitions="14,*,14" ColumnSpacing="4" Margin="4,8,4,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" SharedSizeGroup="BtnInd"/>
          <RowDefinition Height="Auto" SharedSizeGroup="BtnCap"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. The light or screen, in the edited mode, aligned to the bottom of its row -->
        <Panel Name="Indicator" Grid.ColumnSpan="3" Classes="Indicator ControlsLayer" HorizontalAlignment="Center"
               VerticalAlignment="Bottom" ToolTip.Tip="{Binding LightDescription}">
          <Ellipse Name="Led" Classes="Led" Classes.on="{Binding LedOn}" IsVisible="{Binding IsLed}"/>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsLedPair}">
            <Ellipse Name="LedA" Classes="Led" Classes.on="{Binding LedA}"/>
            <Ellipse Name="LedB" Classes="Led" Classes.on="{Binding LedB}"/>
          </StackPanel>
          <Panel IsVisible="{Binding IsScreen}">
            <Panel Classes="ScreenFull">
              <controls:ScreenPreview Name="ScreenPreviewTile" Scale="0.75" Screen="{Binding Screen}"/>
            </Panel>
            <Border Classes="ScreenText">
              <TextBlock Text="{Binding Screen.Main}" TextTrimming="CharacterEllipsis"/>
            </Border>
          </Panel>
        </Panel>

        <!-- During a hardware test (spec §8): the light's test state, which a click switches, or
             the test screen -->
        <Panel Name="TestIndicator" Grid.ColumnSpan="3" Classes="WiringLayer" HorizontalAlignment="Center"
               VerticalAlignment="Bottom" IsVisible="{Binding Wiring.IsTesting, FallbackValue=False}">
          <Button Name="TestLight" Classes="TestLight" Command="{Binding Wiring.AdvanceLightCommand, FallbackValue={x:Null}}"
                  IsVisible="{Binding Wiring.HasTestLight, FallbackValue=False}" ToolTip.Tip="Switch the light">
            <Panel>
              <Ellipse Name="TestLed" Classes="Led" Classes.on="{Binding Wiring.TestLedOn, FallbackValue=False}"
                       IsVisible="{Binding Wiring.IsTestLed, FallbackValue=False}"/>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Wiring.IsTestPair, FallbackValue=False}">
                <Ellipse Name="TestLedA" Classes="Led" Classes.on="{Binding Wiring.TestLedA, FallbackValue=False}"/>
                <Ellipse Name="TestLedB" Classes="Led" Classes.on="{Binding Wiring.TestLedB, FallbackValue=False}"/>
              </StackPanel>
            </Panel>
          </Button>
          <Panel IsVisible="{Binding Wiring.IsTestScreen, FallbackValue=False}">
            <Panel Classes="ScreenFull">
              <controls:ScreenPreview Name="TestScreenPreview" Scale="0.75" Screen="{Binding Wiring.TestScreen}"/>
            </Panel>
            <Border Classes="ScreenText">
              <TextBlock Text="{Binding Wiring.TestScreen.Main, FallbackValue=''}" TextTrimming="CharacterEllipsis"/>
            </Border>
          </Panel>
        </Panel>

        <!-- 2. The cap -->
        <Ellipse Name="Cap" Grid.Row="1" Grid.ColumnSpan="3" Classes="Cap" HorizontalAlignment="Center"
                 Classes.pressed="{Binding Wiring.IsPressed, FallbackValue=False}"/>

        <!-- The grip, beside the action rows: one drag moves all of this button’s actions onto
             another button, in the edited mode (spec §2.9) -->
        <Panel Grid.Row="2" Classes="ControlsLayer">
          <Border Name="Grip" Classes="TileGrip" VerticalAlignment="Top"
                  IsVisible="{Binding CanSwap}" ToolTip.Tip="Drag onto another button to swap actions">
            <PathIcon Data="{StaticResource Icon.Grip}" Width="10" Height="10"/>
          </Border>
        </Panel>

        <!-- The action rows, which a drag carries as its image. Their rows keep sharing heights
             with every tile's (a nested grid in the same shared-size scope). -->
        <Grid Name="ActionRows" Grid.Row="2" Grid.Column="1" Classes="ControlsLayer" Background="Transparent"
              Classes.new="{Binding IsNew}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" SharedSizeGroup="BtnMain"/>
            <RowDefinition Height="Auto" SharedSizeGroup="BtnSecs"/>
          </Grid.RowDefinitions>

          <!-- 3. The main action, whole: it wraps rather than ending in "…" (the row's tiles
               share its height, so they stay aligned) -->
          <TextBlock Name="MainAction" Classes="MainAction"
                     Classes.none="{Binding MainGesture, Converter={x:Static ObjectConverters.IsNull}}"
                     Text="{Binding MainLabel}" TextWrapping="Wrap" TextAlignment="Center"/>

          <!-- Dense boards: one row of three action icons instead (spec §4.4) -->
          <StackPanel Name="ActionIcons" Classes="ActionIcons"
                      Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
            <Border Classes="GestureIcon" Classes.main="{Binding Press.IsMain}" Classes.empty="{Binding !Press.CanTest}"
                    ToolTip.Tip="{Binding Press.RowTip}">
              <PathIcon Data="{Binding Press.IconKey, Converter={x:Static conv:IconConverters.Action}}"
                        IsVisible="{Binding Press.CanTest}"/>
            </Border>
            <Border Classes="GestureIcon" Classes.main="{Binding DoublePress.IsMain}" Classes.empty="{Binding !DoublePress.CanTest}"
                    ToolTip.Tip="{Binding DoublePress.RowTip}">
              <PathIcon Data="{Binding DoublePress.IconKey, Converter={x:Static conv:IconConverters.Action}}"
                        IsVisible="{Binding DoublePress.CanTest}"/>
            </Border>
            <Border Classes="GestureIcon" Classes.main="{Binding Hold.IsMain}" Classes.empty="{Binding !Hold.CanTest}"
                    ToolTip.Tip="{Binding Hold.RowTip}">
              <PathIcon Data="{Binding Hold.IconKey, Converter={x:Static conv:IconConverters.Action}}"
                        IsVisible="{Binding Hold.CanTest}"/>
            </Border>
          </StackPanel>

          <!-- 4. The other actions, each with its gesture mark, wrapped whole like the main one -->
          <Panel Grid.Row="1" Classes="SecondaryRow">
            <ItemsControl Name="SecondaryActions" ItemsSource="{Binding Secondary}" IsVisible="{Binding !IsMissing}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GestureLine">
                  <DockPanel Classes="SecondaryLine" HorizontalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Margin="0,0,4,0"
                               Text="{Binding Gesture, Converter={x:Static conv:GestureMarkConverter.Instance}}"/>
                    <TextBlock Name="SecondaryText" Text="{Binding Label}" TextWrapping="Wrap"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="MissingText" Classes="TileMissing" Text="Not on this controller"
                       IsVisible="{Binding IsMissing}"/>
          </Panel>

          <!-- A control the draft adds (controller-page spec §4.1): Volco sets it up after the
               save. It spans both rows, which keep their shared heights (the actions are hidden). -->
          <TextBlock Name="NewText" Grid.RowSpan="2" Classes="TileNew"
                     Text="New · Save to controller to set it up" IsVisible="{Binding IsNew}"/>
        </Grid>

        <!-- During a hardware test, the test state in the same row as the actions; both are always
             measured, so the tile keeps its size when a test starts. Pins stay in the inspector. -->
        <StackPanel Name="WiringRow" Grid.Row="2" Grid.ColumnSpan="3" Classes="WiringLayer WiringCaptions"
                    IsVisible="{Binding Wiring, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Name="WiringTest" Classes="TestValue" Text="{Binding Wiring.TestText}"
                     IsVisible="{Binding Wiring.IsTesting, FallbackValue=False}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Rectangle Classes="MissingOutline" IsVisible="{Binding IsMissing}"/>
    <Rectangle Classes="DropOutline"/>
    <Rectangle Classes="NewOutline" IsVisible="{Binding IsNew}"/>
    <!-- A new control's problem (its missing pin) shows only in the mark: the dashed outline stays -->
    <Rectangle Classes="ProblemOutline">
      <Rectangle.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="Wiring.HasProblem" FallbackValue="False"/>
          <Binding Path="!IsNew"/>
          <!-- Without wiring, HasProblem yields no value, which And skips -->
          <Binding Path="Wiring" Converter="{x:Static ObjectConverters.IsNotNull}"/>
        </MultiBinding>
      </Rectangle.IsVisible>
    </Rectangle>
    <!-- A wiring problem (controller-page spec §4.1): the danger outline and this mark, with the problem as its tooltip -->
    <Border Name="ProblemMark" Classes="ProblemMark" IsVisible="{Binding Wiring.HasProblem, FallbackValue=False}"
            ToolTip.Tip="{Binding Wiring.Problem, FallbackValue={x:Null}}">
      <PathIcon Data="{StaticResource Icon.Status.Warning}"/>
    </Border>
    <Border Classes="TileActive"/>
  </Panel>
</UserControl>
