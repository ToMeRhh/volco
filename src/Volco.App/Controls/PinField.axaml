<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             x:Class="Volco.App.Controls.PinField"
             x:DataType="hw:PinFieldViewModel">
  <!-- The pin field (hardware-page spec §6.3): "GPIO 5 ▾", which opens the pin dialog over the
       window (Views/Hardware/PinDialog). A problem shows under the field with its fix. The page adds
       "invalid" to the control while it has a problem. -->
  <UserControl.Styles>
    <Style Selector="Button.PinValue">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,5"/>
    </Style>
    <Style Selector="Button.PinValue.invalid /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    </Style>
  </UserControl.Styles>

  <!-- One inspector row (44 px): the label on the left, the value on the right; a problem and its
       fix sit under it -->
  <StackPanel>
    <Grid Name="PinRow" Classes="InspectorRow" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Name="LabelText" Classes="RowLabel" Text="{Binding Label}"/>
      <Panel Grid.Column="1" Classes="RowControl" VerticalAlignment="Center">
        <Button Name="ValueButton" Classes="PinValue" Classes.invalid="{Binding HasError}"
                IsEnabled="{Binding IsEditable}" Click="ValueButton_Click">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Name="ValueText" Text="{Binding ValueText}" VerticalAlignment="Center"/>
            <PathIcon Grid.Column="1" Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12"
                      Foreground="{DynamicResource TextSecondaryBrush}"/>
          </Grid>
        </Button>
      </Panel>
    </Grid>
    <StackPanel Classes="RowFooter" IsVisible="{Binding HasError}">
      <TextBlock Name="ErrorText" Classes="FieldError" Text="{Binding Error}" IsVisible="{Binding HasError}"/>
      <Button Name="FixButton" Content="{Binding FixLabel}" Command="{Binding FixCommand}" IsVisible="{Binding HasFix}"
              HorizontalAlignment="Left"/>
    </StackPanel>
  </StackPanel>
</UserControl>
