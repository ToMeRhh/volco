<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Volco.App.ViewModels"
             xmlns:conv="using:Volco.App.Converters"
             x:Class="Volco.App.Controls.ActionRow"
             x:DataType="vm:ActionSlotViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="DeviceItem" x:DataType="x:String">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Name="DeviceLabel">
          <TextBlock.Text>
            <MultiBinding Converter="{x:Static conv:DeviceLabelConverter.Instance}" ConverterParameter="label">
              <Binding/>
              <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ComboBox}"/>
              <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ComboBoxItem}"/>
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
        <TextBlock Name="DeviceSecondary" Classes="Caption" VerticalAlignment="Center">
          <TextBlock.Text>
            <MultiBinding Converter="{x:Static conv:DeviceLabelConverter.Instance}" ConverterParameter="secondary">
              <Binding/>
              <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ComboBox}"/>
              <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ComboBoxItem}"/>
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid ColumnDefinitions="110,*">
    <TextBlock Name="LabelText" Text="{Binding Label}" Classes="Secondary"
               Margin="0,6,0,0" VerticalAlignment="Top"/>
    <StackPanel Grid.Column="1" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox Name="ActionCombo" MinWidth="260"
                  ItemsSource="{Binding Choices}"
                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}">
          <ComboBox.Styles>
            <Style Selector="ComboBoxItem" x:DataType="vm:ActionChoice">
              <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
            </Style>
            <Style Selector="TextBlock.GroupHeader">
              <Setter Property="FontSize" Value="11"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            </Style>
          </ComboBox.Styles>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ActionChoice">
              <TextBlock Text="{Binding Name}" Classes.GroupHeader="{Binding IsHeader}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Name="TestButton" Content="Test" Command="{Binding TestCommand}"
                IsEnabled="{Binding CanTest}" ToolTip.Tip="Run this action once now"/>
      </StackPanel>

      <Border Name="DeviceParams" Classes="Indent" IsVisible="{Binding NeedsDevice}">
        <ComboBox Name="DeviceCombo" ContainerPrepared="DeviceCombo_ContainerPrepared" ItemTemplate="{StaticResource DeviceItem}" MinWidth="240" PlaceholderText="Choose a device"
                  ItemsSource="{Binding DeviceNames}"
                  SelectedItem="{Binding Device, Mode=TwoWay}"/>
      </Border>

      <Border Name="PairParams" Classes="Indent" IsVisible="{Binding NeedsPair}">
        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
          <TextBlock Text="A" Classes="Caption" VerticalAlignment="Center"/>
          <ComboBox Name="DeviceACombo" Grid.Column="1" ContainerPrepared="DeviceCombo_ContainerPrepared" ItemTemplate="{StaticResource DeviceItem}" MinWidth="240" PlaceholderText="Choose a device"
                    ItemsSource="{Binding DeviceNames}"
                    SelectedItem="{Binding Device, Mode=TwoWay}"/>
          <TextBlock Grid.Row="1" Text="B" Classes="Caption" VerticalAlignment="Center"/>
          <ComboBox Name="DeviceBCombo" Grid.Row="1" Grid.Column="1" ContainerPrepared="DeviceCombo_ContainerPrepared" ItemTemplate="{StaticResource DeviceItem}" MinWidth="240" PlaceholderText="Choose a device"
                    ItemsSource="{Binding DeviceNames}"
                    SelectedItem="{Binding DeviceB, Mode=TwoWay}"/>
        </Grid>
      </Border>

      <Border Name="PresetParams" Classes="Indent" IsVisible="{Binding NeedsPreset}">
        <ComboBox Name="PresetCombo" MinWidth="200" PlaceholderText="Choose a preset"
                  ItemsSource="{Binding PresetChoices}"
                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"/>
      </Border>

      <Border Name="MediaParams" Classes="Indent" IsVisible="{Binding NeedsMediaApp}">
        <StackPanel Spacing="4">
          <ComboBox Name="MediaAppCombo" MinWidth="240"
                    ItemsSource="{Binding MediaAppChoices}"
                    SelectedItem="{Binding SelectedMediaApp, Mode=TwoWay}"/>
          <TextBlock Classes="Caption" TextWrapping="Wrap"
                     Text="Apps that show in the Windows volume flyout's media controls. Play something to list it here."/>
        </StackPanel>
      </Border>

      <Border Name="CommandParams" Classes="Indent" IsVisible="{Binding NeedsCommand}">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
          <TextBlock Text="File" Classes="Caption" VerticalAlignment="Center"/>
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Name="CommandPathBox" MinWidth="240" PlaceholderText="{Binding CommandPlaceholder}"
                     Text="{Binding CommandPath, Mode=TwoWay}"/>
            <Button Name="BrowseButton" Grid.Column="1" Content="Browse…" Click="BrowseButton_Click"/>
          </Grid>
          <TextBlock Name="PathMissingText" Grid.Row="1" Grid.Column="1" Classes="Caption" TextWrapping="Wrap"
                     Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding PathMissing}"
                     Text="This file doesn't exist."/>
          <TextBlock Grid.Row="2" Text="Arguments" Classes="Caption" VerticalAlignment="Center"/>
          <TextBox Name="CommandArgumentsBox" Grid.Row="2" Grid.Column="1" PlaceholderText="Optional"
                   Text="{Binding CommandArguments, Mode=TwoWay}"/>
          <TextBlock Grid.Row="3" Text="Start in" Classes="Caption" VerticalAlignment="Center"/>
          <TextBox Name="CommandFolderBox" Grid.Row="3" Grid.Column="1" PlaceholderText="The file's own folder"
                   Text="{Binding CommandWorkingDirectory, Mode=TwoWay}"/>
          <TextBlock Grid.Row="4" Text="Name" Classes="Caption" VerticalAlignment="Center"/>
          <TextBox Name="CommandNameBox" Grid.Row="4" Grid.Column="1" PlaceholderText="Shown on the controller's screen; the file name when empty"
                   Text="{Binding CommandName, Mode=TwoWay}"/>
          <CheckBox Name="StartAnotherCheck" Grid.Row="5" Grid.Column="1" IsVisible="{Binding NeedsWhileRunning}"
                    IsChecked="{Binding StartAnother, Mode=TwoWay}"
                    Content="Start another run when pressed while it still runs"/>
          <StackPanel Grid.Row="6" Grid.Column="1" Spacing="4">
            <TextBlock Name="CommandHintText" Classes="Caption" TextWrapping="Wrap" Text="{Binding CommandHint}"/>
            <TextBlock Name="UsbOnlyText" Classes="Caption" TextWrapping="Wrap" IsVisible="{Binding ShowUsbOnly}"
                       Foreground="{DynamicResource WarningBrush}"
                       Text="Runs only for presses over USB. Presses over Wi-Fi (UDP) or the simulator are ignored, so no one on the network can run it. Test still runs it."/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
