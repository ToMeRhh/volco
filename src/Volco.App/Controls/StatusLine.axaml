<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Volco.App.Controls">
  <ControlTheme x:Key="{x:Type controls:StatusLine}" TargetType="controls:StatusLine">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*">
          <PathIcon Name="PART_Icon" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top"
                    IsVisible="{TemplateBinding ShowIcon}"
                    Data="{DynamicResource Icon.Status.Info}" Foreground="{DynamicResource TextTertiaryBrush}"/>
          <TextBlock Name="PART_Text" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="{TemplateBinding Text}"/>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.Subtitle /template/ TextBlock#PART_Text">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="^.Subtitle /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Margin" Value="0,1,8,0"/>
    </Style>
    <Style Selector="^.Caption /template/ TextBlock#PART_Text">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="^.Caption /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="Margin" Value="0,2,6,0"/>
    </Style>

    <Style Selector="^:good /template/ PathIcon#PART_Icon">
      <Setter Property="Data" Value="{DynamicResource Icon.Status.Good}"/>
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
    </Style>
    <Style Selector="^:warning /template/ PathIcon#PART_Icon">
      <Setter Property="Data" Value="{DynamicResource Icon.Status.Warning}"/>
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector="^:warning /template/ TextBlock#PART_Text">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector="^:danger /template/ PathIcon#PART_Icon">
      <Setter Property="Data" Value="{DynamicResource Icon.Status.Danger}"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="^:danger /template/ TextBlock#PART_Text">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>
