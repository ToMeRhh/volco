<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Volco.App</RootNamespace>
    <!-- AVLN3001: windows/controls built only from code with constructor arguments have no
         public parameterless constructor, so the runtime XAML loader and previewer can't
         create them. Nothing loads them that way. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Volco.Core\Volco.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Volco.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\volco.ico" />
    <AvaloniaResource Include="Assets\volco-update.ico" />
    <AvaloniaResource Include="..\..\THIRD-PARTY-NOTICES.txt" Link="Assets\Notices\THIRD-PARTY-NOTICES.txt" />
    <AvaloniaResource Include="..\..\firmware\assets\fonts\OFL.txt" Link="Assets\Notices\OFL.txt" />
    <!-- The controller's own icons and font (firmware/assets is their single source), for the
         screen previews. -->
    <AvaloniaResource Include="..\..\firmware\assets\icons\*.png" Link="Assets\Icons\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\firmware\assets\fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
