<?xml version="1.0" encoding="utf-8"?>
<!--
    VolcoStyles.axaml - the one shared styles entry point. Include with
      <StyleInclude Source="avares://Volco.App/Styles/VolcoStyles.axaml"/>
    Merges Colors, Tokens, Brushes, Icons and the SettingsCard theme, then styles the redesign's
    components (spec §3.7): cards, the segmented choice, ghost / primary / icon buttons, chips,
    the "Advanced" toggle, the activity flash and the navigation list.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Volco.App.Controls">
  <!-- Every tooltip opens just below its element, left-aligned with it, instead of wherever the
       pointer stopped (Avalonia flips it above when there is no room below). -->
  <Style Selector=":is(Control)">
    <Setter Property="ToolTip.Placement" Value="Bottom"/>
    <Setter Property="ToolTip.VerticalOffset" Value="4"/>
  </Style>
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Volco.App/Styles/Tokens.axaml"/>
        <ResourceInclude Source="avares://Volco.App/Styles/Colors.axaml"/>
        <ResourceInclude Source="avares://Volco.App/Styles/Brushes.axaml"/>
        <ResourceInclude Source="avares://Volco.App/Styles/Icons.axaml"/>
        <ResourceInclude Source="avares://Volco.App/Controls/SettingsCard.axaml"/>
        <ResourceInclude Source="avares://Volco.App/Controls/StatusLine.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <StyleInclude Source="avares://Volco.App/Styles/Typography.axaml"/>

  <!-- ── Layout helpers (older names) ─────────────────────────────────── -->
  <Style Selector="StackPanel.SectionContainer">
    <Setter Property="Orientation" Value="Vertical"/>
    <Setter Property="Spacing" Value="16"/>
    <Setter Property="Margin" Value="0,0,0,24"/>
  </Style>
  <Style Selector="StackPanel.SettingsGroup">
    <Setter Property="Orientation" Value="Vertical"/>
    <Setter Property="Spacing" Value="4"/>
  </Style>

  <!-- ── Window and pages ──────────────────────────────────────────────── -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- ── Cards ─────────────────────────────────────────────────────────── -->
  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
  </Style>
  <Style Selector="Border.CardBody">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="{StaticResource CardBodyPadding}"/>
  </Style>
  <!-- A plain panel (Connection, General). -->
  <Style Selector="Border.Panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
    <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
  </Style>
  <!-- A floating message that fits its text, up to a limit (the Controller page's save bar). -->
  <Style Selector="Border.Snackbar">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
    <Setter Property="Padding" Value="14,8,8,8"/>
    <Setter Property="BoxShadow" Value="0 6 20 0 #33000000"/>
    <Setter Property="MaxWidth" Value="560"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>
  <!-- A field with a problem: a red border, next to its red error line. -->
  <Style Selector="NumericUpDown.Invalid, ComboBox.Invalid, TextBox.Invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="TextBox.Invalid /template/ Border#PART_BorderElement, NumericUpDown.Invalid /template/ TextBox /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <!-- An indented block under a choice (action settings, "Advanced"). -->
  <Style Selector="Border.Indent">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="2,0,0,0"/>
    <Setter Property="Padding" Value="12,0,0,0"/>
  </Style>

  <!-- ── Buttons ───────────────────────────────────────────────────────── -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
  </Style>
  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
  </Style>
  <Style Selector="Button.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="Opacity" Value="0.9"/>
  </Style>
  <Style Selector="Button.Ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Padding" Value="6,4"/>
  </Style>
  <Style Selector="Button.Ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Button.Danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.Icon">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="Button.Icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
  </Style>
  <!-- A card header: the whole row toggles the card. -->
  <Style Selector="Button.CardHeader">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.CardHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- ── Segmented choice (RadioButton.Segment inside Border.SegmentTrack) ── -->
  <Style Selector="Border.SegmentTrack">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
    <Setter Property="Padding" Value="3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style Selector="RadioButton.Segment">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Border Name="PART_Segment"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,4">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.Segment:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="RadioButton.Segment:checked">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="RadioButton.Segment:checked /template/ Border#PART_Segment">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  </Style>
  <Style Selector="RadioButton.Segment:focus-visible /template/ Border#PART_Segment">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!-- ── "Advanced" toggle ─────────────────────────────────────────────── -->
  <Style Selector="ToggleButton.Advanced">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="ToggleButton.Advanced:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="ToggleButton.Advanced:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!-- ── Chips ─────────────────────────────────────────────────────────── -->
  <Style Selector="Border.Chip">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}"/>
    <Setter Property="Padding" Value="10,2,4,2"/>
  </Style>

  <!-- Device icon picker (the device dialog). -->
  <Style Selector="Button.IconChoice">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  </Style>
  <Style Selector="Button.IconChoice.selected">
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="TextBlock.auto">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>

  <!-- ── Level bar and lights ──────────────────────────────────────────── -->
  <Style Selector="ProgressBar.Level">
    <Setter Property="Height" Value="4"/>
    <Setter Property="MinHeight" Value="4"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="CornerRadius" Value="2"/>
  </Style>
  <Style Selector="Ellipse.Led">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Height" Value="10"/>
    <Setter Property="Stroke" Value="{DynamicResource BorderStrongBrush}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="Fill" Value="Transparent"/>
  </Style>
  <Style Selector="Ellipse.Led.on">
    <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}"/>
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
  </Style>

  <!-- ── Navigation ────────────────────────────────────────────────────── -->
  <Style Selector="ListBox.Nav">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem">
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="Margin" Value="0,2"/>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <!-- The sidebar is SubtleBrush, so hover steps back to the window background. -->
  <Style Selector="ListBox.Nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem Border.NavMarker">
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected Border.NavMarker">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- ── Controller page: the drawing (spec §4) ────────────────────────────
       The case holds the slider grid and the buttons' frame. Each tile is a SliderTile or a
       ButtonTile: transparent until hovered, the accent outline when selected, dashed when the
       controller doesn't have it, and the activity flash when the controller reports it.
       Border.Case.dense (more than 8 sliders or buttons) makes everything smaller. -->
  <Style Selector="Border.Case">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="14"/>
  </Style>
  <Style Selector="controls|FillWrapPanel.SliderGrid">
    <Setter Property="MinItemWidth" Value="84"/>
  </Style>
  <Style Selector="controls|FillWrapPanel.ButtonGrid">
    <Setter Property="MinItemWidth" Value="136"/>
  </Style>
  <Style Selector="Border.Case.dense controls|FillWrapPanel.SliderGrid">
    <Setter Property="MinItemWidth" Value="74"/>
  </Style>
  <Style Selector="Border.Case.dense controls|FillWrapPanel.ButtonGrid">
    <Setter Property="MinItemWidth" Value="80"/>
  </Style>

  <Style Selector="controls|SliderTile, controls|ButtonTile">
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Border.Tile">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="CornerRadius" Value="11"/>
  </Style>
  <Style Selector="Border.Tile:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
  </Style>
  <Style Selector="Border.Tile.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="controls|SliderTile:focus-visible Border.Tile, controls|ButtonTile:focus-visible Border.Tile">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Rectangle.MissingOutline">
    <Setter Property="Stroke" Value="{DynamicResource BorderStrongBrush}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="StrokeDashArray" Value="4,3"/>
    <Setter Property="RadiusX" Value="11"/>
    <Setter Property="RadiusY" Value="11"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style Selector="TextBlock.TileMissing">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- The flash when the controller reports the control (Controls/TileFlash). -->
  <Style Selector="Border.TileActive">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector="Panel.TileRoot.flash Border.TileActive">
    <Style.Animations>
      <Animation Duration="0:0:0.6" FillMode="None">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1"/>
        </KeyFrame>
        <KeyFrame Cue="40%">
          <Setter Property="Opacity" Value="1"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.TileGrip">
    <Setter Property="Padding" Value="2"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Opacity" Value="0.55"/>
    <Setter Property="Cursor" Value="SizeAll"/>
  </Style>
  <Style Selector="Border.TileGrip PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
  </Style>
  <Style Selector="controls|SliderTile:pointerover Border.TileGrip, controls|ButtonTile:pointerover Border.TileGrip">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <!-- Drag to swap (spec §2.9–10, §11): the dragged tile is dimmed (the whole tile, so the live
       VisualBrush of its action rows stays at full strength), and the tile it would swap with gets
       a dashed accent outline -->
  <Style Selector="controls|SliderTile.dragSource, controls|ButtonTile.dragSource">
    <Setter Property="Opacity" Value="0.35"/>
  </Style>
  <Style Selector="Rectangle.DropOutline">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="StrokeDashArray" Value="4,3"/>
    <Setter Property="RadiusX" Value="11"/>
    <Setter Property="RadiusY" Value="11"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style Selector="controls|SliderTile.dropTarget Rectangle.DropOutline, controls|ButtonTile.dropTarget Rectangle.DropOutline">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="Border.SwapDragImage">
    <Setter Property="Opacity" Value="0.85"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

  <!-- Sliders: a track with the live level and a knob -->
  <Style Selector="Panel.Fader">
    <Setter Property="Height" Value="140"/>
  </Style>
  <Style Selector="Border.Case.dense Panel.Fader">
    <Setter Property="Height" Value="84"/>
  </Style>
  <Style Selector="Border.Track">
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="Border.LevelFill">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Opacity" Value="0.55"/>
    <Setter Property="CornerRadius" Value="3"/>
  </Style>
  <Style Selector="Border.Knob">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="15"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="0 2 4 0 #40000000"/>
  </Style>
  <Style Selector="Border.Case.dense Border.Knob">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="12"/>
  </Style>
  <Style Selector="Border.KnobLine">
    <Setter Property="Height" Value="2"/>
    <Setter Property="Margin" Value="5,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.TileLabel">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Border.Case.dense TextBlock.TileLabel">
    <Setter Property="FontSize" Value="11"/>
  </Style>
  <!-- "Not set" -->
  <Style Selector="TextBlock.TileLabel.unset">
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>

  <!-- Buttons: the frame in the edited mode's colour, its tabs, and the tiles -->
  <Style Selector="Border.ModeFrame">
    <Setter Property="Background" Value="{DynamicResource ModeFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ModeEdge}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="8,0,8,8"/>
  </Style>
  <!-- Tabs hang from the frame's top edge; the edited one is filled with its colour. -->
  <Style Selector="RadioButton.ModeTab">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Border Name="PART_Tab" Background="{DynamicResource SubtleBrush}" CornerRadius="0,0,7,7" Padding="10,4,10,5">
          <!-- A plain (square) background, so the tab is hit even where the rounded border's
               geometry isn't (headless tests draw no geometry) -->
          <ContentPresenter Background="Transparent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.ModeTab:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="RadioButton.ModeTab:checked">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="RadioButton.ModeTab:checked /template/ Border#PART_Tab">
    <Setter Property="Background" Value="{DynamicResource ModeEdge}"/>
  </Style>
  <Style Selector="RadioButton.ModeTab:focus-visible /template/ Border#PART_Tab">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Ellipse.LiveDot">
    <Setter Property="Width" Value="7"/>
    <Setter Property="Height" Value="7"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="Button.ModeAction">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0,0,7,7"/>
    <Setter Property="Padding" Value="8,4,8,5"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="Button.ModeAction.Live">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <!-- The pencil, and its check mark while the tabs are in edit mode -->
  <Style Selector="Button.EditModes">
    <Setter Property="ToolTip.Tip" Value="Edit modes"/>
  </Style>
  <Style Selector="Button.EditModes.editing">
    <Setter Property="ToolTip.Tip" Value="Done"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <!-- Edit mode: the inline rename box, the start-up mode's label, × and a picked-up tab -->
  <Style Selector="TextBox.TabNameBox">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MinWidth" Value="80"/>
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.StartLabel">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="Button.DeleteTab">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="3"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="ItemsControl.editing RadioButton.ModeTab">
    <Setter Property="Cursor" Value="SizeAll"/>
  </Style>
  <Style Selector="ContentPresenter.dragging">
    <Setter Property="Opacity" Value="0.85"/>
  </Style>
  <!-- The rows of the mode menu -->
  <Style Selector="Button.MenuItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="8,5"/>
  </Style>
  <Style Selector="Button.MenuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
  </Style>
  <Style Selector="Button.ModeAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
  </Style>

  <Style Selector="Border.ScreenText">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="Background" Value="#05070A"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="Width" Value="64"/>
  </Style>
  <Style Selector="Border.ScreenText TextBlock">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Foreground" Value="#E8F0FF"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.Case.dense Border.ScreenText">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="Border.Case.dense Panel.ScreenFull">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Ellipse.Cap">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="46"/>
    <Setter Property="Margin" Value="0,7,0,0"/>
    <Setter Property="Fill" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Stroke" Value="{DynamicResource BorderStrongBrush}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
  </Style>
  <Style Selector="Border.Case.dense Ellipse.Cap">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
  </Style>
  <Style Selector="TextBlock.MainAction">
    <Setter Property="Margin" Value="0,6,0,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <!-- "Not set" -->
  <Style Selector="TextBlock.MainAction.none">
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="Panel.SecondaryRow">
    <Setter Property="Margin" Value="0,4,0,0"/>
  </Style>
  <Style Selector="DockPanel.SecondaryLine TextBlock">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="StackPanel.ActionIcons">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>
  <Style Selector="Border.Case.dense StackPanel.ActionIcons">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="Border.Case.dense TextBlock.MainAction, Border.Case.dense Panel.SecondaryRow">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <!-- A new button (controller-page spec §4.1): its "New · Save…" text in place of the actions -->
  <Style Selector="Grid.new TextBlock.MainAction, Grid.new StackPanel.ActionIcons, Grid.new Panel.SecondaryRow">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Border.GestureIcon">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.GestureIcon PathIcon">
    <Setter Property="Width" Value="11"/>
    <Setter Property="Height" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Border.GestureIcon.main">
    <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="Border.GestureIcon.empty">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  </Style>

  <!-- ── The tiles' two layers (controller-page spec §4.1, hardware-page spec §8) ─────────
       Each tile, the mode frame and its tabs hold a ControlsLayer and a WiringLayer in the same
       cells, both always measured. The drawing shows the ControlsLayer; while a hardware test runs
       (the stage puts "testing" on Border.Case) the WiringLayer with the test state shows instead,
       so no tile moves (Views/Stage/StageTransitions crossfades it). -->
  <Style Selector=":is(Control).WiringLayer">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <!-- Disabled too, so the faded mode tabs and buttons are out of keyboard reach (layout is kept) -->
  <Style Selector="Border.Case.testing :is(Control).ControlsLayer">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="IsEnabled" Value="False"/>
  </Style>
  <Style Selector="Border.Case.testing :is(Control).WiringLayer">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
  </Style>
  <!-- The pill-shaped chip in the title row (Controller settings) -->
  <Style Selector="Button.Chip">
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.Chip.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
  </Style>
  <!-- Hardware inspector rows (hardware-page spec §6): a 44 px Grid.InspectorRow, the label left
       and the control right; a pin field's problem and fix go in the RowFooter under it -->
  <Style Selector="Grid.InspectorRow :is(Control).RowControl">
    <Setter Property="Width" Value="160"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Grid.InspectorRow Border.SegmentTrack">
    <Setter Property="Padding" Value="2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Grid.InspectorRow RadioButton.Segment /template/ Border#PART_Segment">
    <Setter Property="Padding" Value="7,3"/>
  </Style>
  <!-- Inspector cards (controller-page spec §4.3, the Windows Settings look; user, 2026-10-22): a
       card (Border.InspectorRows) holds its rows in a CardRows, a hairline between each two. A
       collapsible group's header (Screens, Buttons, Fine tune) is a row of its card; its body sits
       under it, indented (Border.CardBody, a section's own rows) or indented and tinted
       (Border.Nested, a sub-option or a sub-group), so a child never reads as its parent's sibling. -->
  <Style Selector="controls|CardRows">
    <Setter Property="DividerBrush" Value="{DynamicResource BorderBrush}"/>
  </Style>
  <Style Selector="TextBlock.SectionLabel">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.CardBody">
    <Setter Property="Padding" Value="12,0,0,0"/>
  </Style>
  <Style Selector="Border.Nested">
    <Setter Property="Padding" Value="12,0,0,0"/>
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
  </Style>
  <Style Selector="Border.CardBody TextBlock.RowLabel, Border.Nested TextBlock.RowLabel">
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- An indented row grows with a label that wraps -->
  <Style Selector="Border.CardBody Grid.InspectorRow, Border.Nested Grid.InspectorRow">
    <Setter Property="Height" Value="NaN"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Margin" Value="12,4,8,4"/>
  </Style>
  <!-- The narrow inspector leaves an indented row's label some room -->
  <Style Selector=":is(Window).compact Border.CardBody Grid.InspectorRow :is(Control).RowControl, :is(Window).compact Border.Nested Grid.InspectorRow :is(Control).RowControl">
    <Setter Property="Width" Value="128"/>
  </Style>
  <!-- A label with its "?" in front of it (HelpTip): the "?" lines up with the other rows' labels'
       starts, and a wrapped label's lines start together beside it -->
  <Style Selector="Grid.HelpLabel">
    <Setter Property="ColumnSpacing" Value="6"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Grid.HelpLabel > controls|HelpTip">
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="0,1,0,0"/>
  </Style>
  <!-- The "?" beside a non-trivial setting's label; its tooltip explains the setting -->
  <Style Selector="controls|HelpTip">
    <Setter Property="Width" Value="15"/>
    <Setter Property="Height" Value="15"/>
    <Setter Property="CornerRadius" Value="7.5"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Help"/>
  </Style>
  <Style Selector="controls|HelpTip > TextBlock">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
  </Style>
  <Style Selector="controls|HelpTip:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="controls|HelpTip:pointerover > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="StackPanel.RowFooter">
    <Setter Property="Margin" Value="12,0,8,10"/>
    <Setter Property="Spacing" Value="6"/>
  </Style>
  <Style Selector="StackPanel.ModeFrameContent">
    <!-- The tint's border (1.5) plus the frame's padding (8,0,8,8) -->
    <Setter Property="Margin" Value="9.5,1.5,9.5,9.5"/>
  </Style>
  <Style Selector="Grid.StageTitleRow">
    <Setter Property="Height" Value="32"/>
  </Style>
  <!-- Hardware's title-row buttons fit the row's 32 px -->
  <Style Selector="Grid.StageTitleRow Button.TitleAction">
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="StackPanel.WiringCaptions">
    <Setter Property="Spacing" Value="3"/>
  </Style>
  <Style Selector="controls|ButtonTile StackPanel.WiringCaptions">
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>
  <!-- A problem with the draft's control: the danger outline and the warning mark at the top
       right, whose tooltip is the problem (controller-page spec §4.1) -->
  <Style Selector="Rectangle.ProblemOutline">
    <Setter Property="Stroke" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="RadiusX" Value="11"/>
    <Setter Property="RadiusY" Value="11"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style Selector="Border.ProblemMark">
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="0,2,2,0"/>
    <Setter Property="Padding" Value="3"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Border.ProblemMark PathIcon">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <!-- A control the draft adds (controller-page spec §4.1): dashed in the accent colour until
       the controller has it -->
  <Style Selector="Rectangle.NewOutline">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="StrokeDashArray" Value="4,3"/>
    <Setter Property="RadiusX" Value="11"/>
    <Setter Property="RadiusY" Value="11"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <!-- Where a button's main action starts -->
  <Style Selector="controls|ButtonTile TextBlock.TileNew">
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>
  <Style Selector="TextBlock.TileNew">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- The hardware test on the drawing (hardware-page spec §8): the case's accent outline (the
       padding gives back the thicker border, so no tile moves), the band under it, a held
       button's cap, the clickable test light and the test value in the label's place -->
  <Style Selector="Border.Case.testing">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="13"/>
  </Style>
  <Style Selector="Border.TestBand">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12,7"/>
  </Style>
  <Style Selector="Border.Case.testing Ellipse.Cap.pressed">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Button.TestLight">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.TestLight:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="TextBlock.TestValue">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,1,0,2"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!-- ── Controller page: the inspector (spec §5) ──────────────────────────
       A card beside the drawing: a header, then one-line rows of 44 px, in two sections that
       scroll as one. -->
  <Style Selector="Border.Inspector">
    <Setter Property="Width" Value="380"/>
    <Setter Property="Margin" Value="0,8,16,16"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector=":is(Window).compact Border.Inspector">
    <Setter Property="Width" Value="300"/>
  </Style>
  <Style Selector=":is(Panel).InspectorHeader">
    <Setter Property="Margin" Value="16,14"/>
  </Style>
  <Style Selector="TextBlock.InspectorKind">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.InspectorHeading">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBox.NameField">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="-6,0,0,0"/>
  </Style>
  <Style Selector="StackPanel.InspectorBody">
    <Setter Property="Margin" Value="16,4,16,20"/>
    <Setter Property="Spacing" Value="18"/>
  </Style>
  <Style Selector="TextBlock.GroupLabel">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- The combined inspector's two sections (controller-page spec §4.3): Controls or Actions,
       then Hardware; each a one-line header (36 px) over its body -->
  <Style Selector="StackPanel.InspectorGroupBody, StackPanel.WiringBody">
    <Setter Property="Spacing" Value="12"/>
  </Style>
  <Style Selector="Border.GroupHeader">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="16,0"/>
  </Style>
  <Style Selector="Border.GroupHeader.Divided">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>
  <Style Selector="Panel.GroupBody">
    <Setter Property="Margin" Value="16,2,16,16"/>
  </Style>
  <Style Selector="PathIcon.GroupProblem">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Border.SaveFirst">
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style Selector="Border.ModePill">
    <Setter Property="Background" Value="{DynamicResource ModeEdge}"/>
    <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}"/>
    <Setter Property="Padding" Value="7,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.ModePill TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Border.InspectorRows">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Grid.InspectorRow">
    <Setter Property="Height" Value="44"/>
    <Setter Property="Margin" Value="12,0,8,0"/>
  </Style>
  <Style Selector="Grid.ActionRowGrid">
    <Setter Property="Height" Value="44"/>
  </Style>
  <Style Selector="Button.InspectorRow">
    <Setter Property="Height" Value="44"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="12,0,8,0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.InspectorRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
  </Style>
  <Style Selector="TextBlock.RowLabel">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- The inspector's values wrap whole rather than end in "…" -->
  <Style Selector="TextBlock.RowValue">
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.RowValue.none">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
  </Style>
  <Style Selector="Border.RowIcon">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
  </Style>
  <Style Selector="Border.RowIcon PathIcon">
    <Setter Property="Width" Value="13"/>
    <Setter Property="Height" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="PathIcon.RowChevron, PathIcon.SectionChevron">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Height" Value="10"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
  </Style>
  <Style Selector="Button.InspectorRow.open PathIcon.RowChevron">
    <Setter Property="RenderTransform" Value="rotate(90deg)"/>
  </Style>
  <Style Selector="Border.UsbTag">
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.UsbTag TextBlock">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="PathIcon.InvalidIcon">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
  </Style>
  <Style Selector="Panel.TryCell">
    <Setter Property="Width" Value="38"/>
  </Style>
  <Style Selector="Button.Try">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="5"/>
  </Style>
  <Style Selector="PathIcon.RowAdd">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
  </Style>
  <Style Selector="Grid.LightRowGrid">
    <Setter Property="Height" Value="56"/>
    <Setter Property="Margin" Value="12,0"/>
    <Setter Property="ColumnSpacing" Value="12"/>
  </Style>
  <Style Selector="Border.LightPreview">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="MinWidth" Value="44"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.LightPreview > Panel">
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <!-- ── Settings window: the compact layout below 1000 px (spec §3.1) ───
       A 56 px icon-only sidebar (the entries' tooltips give the names) instead of 168 px. -->
  <Style Selector="Border.SidebarWidth">
    <Setter Property="Width" Value="168"/>
  </Style>
  <Style Selector=":is(Window).compact Border.SidebarWidth">
    <Setter Property="Width" Value="56"/>
  </Style>
  <Style Selector="DockPanel.NavPane">
    <Setter Property="Width" Value="148"/>
  </Style>
  <Style Selector=":is(Window).compact DockPanel.NavPane">
    <Setter Property="Width" Value="36"/>
  </Style>
  <Style Selector=":is(Window).compact TextBlock.NavLabel, :is(Window).compact TextBlock.Brand, :is(Window).compact StackPanel.AboutFooter">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector=":is(Window).compact ListBox.Nav ListBoxItem">
    <Setter Property="Padding" Value="9,9"/>
  </Style>
  <!-- The sidebar lies over the page, and its room in the layout (SidebarSpacer) keeps the page
       beside it. In the compact layout, the mouse on the sidebar opens it to full width, over
       the page; the icons keep their place, and it stays open while the status line's menu is ("pinned").
       These come after the compact styles above, so they win. -->
  <Style Selector="Grid.SidebarHost">
    <Setter Property="Width" Value="168"/>
  </Style>
  <Style Selector=":is(Window).compact Grid.SidebarHost">
    <Setter Property="Width" Value="56"/>
  </Style>
  <Style Selector=":is(Window).compact Grid.SidebarHost:pointerover, :is(Window).compact Grid.SidebarHost.pinned">
    <Setter Property="Width" Value="168"/>
  </Style>
  <Style Selector=":is(Window).compact Grid.SidebarHost:pointerover Border.Sidebar, :is(Window).compact Grid.SidebarHost.pinned Border.Sidebar">
    <Setter Property="BoxShadow" Value="4 0 16 0 #33000000"/>
  </Style>
  <Style Selector=":is(Window).compact Grid.SidebarHost:pointerover DockPanel.NavPane, :is(Window).compact Grid.SidebarHost.pinned DockPanel.NavPane">
    <Setter Property="Width" Value="148"/>
  </Style>
  <Style Selector=":is(Window).compact Grid.SidebarHost:pointerover TextBlock.NavLabel, :is(Window).compact Grid.SidebarHost.pinned TextBlock.NavLabel, :is(Window).compact Grid.SidebarHost:pointerover TextBlock.Brand, :is(Window).compact Grid.SidebarHost.pinned TextBlock.Brand, :is(Window).compact Grid.SidebarHost:pointerover StackPanel.AboutFooter, :is(Window).compact Grid.SidebarHost.pinned StackPanel.AboutFooter">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <!-- The controller's status line in the sidebar (controller-page spec §5): a quiet row, its dot
       under the nav icons; only the dot in the compact layout, the whole line while the sidebar
       opens over the page. -->
  <Style Selector="Button.SidebarStatus">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="17,7,8,7"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
  </Style>
  <Style Selector="Button.SidebarStatus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  </Style>
  <Style Selector=":is(Window).compact Button.SidebarStatus">
    <Setter Property="Padding" Value="0,7"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector=":is(Window).compact StackPanel.SidebarStatusText">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector=":is(Window).compact Grid.SidebarHost:pointerover Button.SidebarStatus, :is(Window).compact Grid.SidebarHost.pinned Button.SidebarStatus">
    <Setter Property="Padding" Value="17,7,8,7"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector=":is(Window).compact Grid.SidebarHost:pointerover StackPanel.SidebarStatusText, :is(Window).compact Grid.SidebarHost.pinned StackPanel.SidebarStatusText">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <!-- The status banner across the top of the content area, while the controller needs the user -->
  <Style Selector="Border.StatusBanner">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="20,8"/>
    <Setter Property="MinHeight" Value="48"/>
  </Style>

  <!-- ── Settings window chrome ────────────────────────────────────────── -->
  <!-- The client area extends into the title bar; these fill the title bar row. -->
  <Style Selector="Border.Sidebar">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
  </Style>
  <!-- A drag region must be hit-testable, so it needs a (transparent) background. -->
  <Style Selector="Border.TitleBarDrag">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Border.BrandMark">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="TextBlock.Brand">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!-- The setup chooser's cards (hardware-page spec §7.1): Volco's saved copy outlined in the
       accent, Start empty dashed -->
  <Style Selector="Button.ChooserCard">
    <Setter Property="Width" Value="200"/>
    <Setter Property="Margin" Value="6"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
  </Style>
  <Style Selector="Button.ChooserCard.primary">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="Button.ChooserCard.dashed">
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.ChooserCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
  </Style>
  <Style Selector="Rectangle.ChooserDash">
    <Setter Property="Stroke" Value="{DynamicResource BorderStrongBrush}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="StrokeDashArray" Value="4,3"/>
    <Setter Property="RadiusX" Value="12"/>
    <Setter Property="RadiusY" Value="12"/>
    <Setter Property="Margin" Value="-1"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

  <!-- ── Controller page dialogs (spec §6) ───────────────────────────────── -->
  <!-- Up to 640 × 560, smaller in a small window, centred over the page. -->
  <Style Selector="Border.DialogCard">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="24"/>
    <Setter Property="MaxWidth" Value="640"/>
    <Setter Property="MaxHeight" Value="560"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="BoxShadow" Value="0 8 28 0 #40000000"/>
  </Style>
  <Style Selector="Grid.DialogHeader">
    <Setter Property="Margin" Value="16,12,10,12"/>
  </Style>
  <Style Selector="TextBlock.DialogTitle">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.DialogSubtitle">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.DialogSearch">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,1"/>
    <Setter Property="Padding" Value="16,10"/>
  </Style>
  <Style Selector="TextBox.Search">
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <Style Selector="Grid.DialogFooter">
    <Setter Property="Margin" Value="16,10"/>
    <Setter Property="ColumnSpacing" Value="8"/>
  </Style>
  <Style Selector="Border.ActionListPane">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>
  <Style Selector="Button.ActionSectionHeader">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="6,8,6,4"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
  </Style>
  <Style Selector="Button.ActionSectionHeader PathIcon.SectionChevron">
    <Setter Property="RenderTransform" Value="none"/>
  </Style>
  <Style Selector="Button.ActionSectionHeader.open PathIcon.SectionChevron">
    <Setter Property="RenderTransform" Value="rotate(90deg)"/>
  </Style>
  <Style Selector="Button.ActionItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>
  <Style Selector="Button.ActionItem PathIcon">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="Button.ActionItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ActionItem.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
  </Style>
  <Style Selector="Button.ActionItem.picked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
  </Style>
  <Style Selector="Button.ActionItem.picked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="TextBlock.NoMatch">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    <Setter Property="Margin" Value="8,10"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- Target dialog rows: a radio or check mark, the icon, the name over its secondary text, and
       the owner pill. -->
  <Style Selector="Border.DialogCard.Narrow">
    <Setter Property="MaxWidth" Value="520"/>
  </Style>
  <!-- The pin dialog: eight pins to a row. -->
  <Style Selector="Border.DialogCard.Wide">
    <Setter Property="MaxWidth" Value="800"/>
  </Style>
  <!-- The device dialog: as tall as its fields. -->
  <Style Selector="Border.DialogCard.Small">
    <Setter Property="MaxWidth" Value="400"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- A device row's ⋯ menu shows on hover or focus (and while its menu is open). -->
  <Style Selector="Grid.TargetRowHost Button.DeviceMenu">
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector="Grid.TargetRowHost:pointerover Button.DeviceMenu, Grid.TargetRowHost:focus-within Button.DeviceMenu, Grid.TargetRowHost Button.DeviceMenu:flyout-open">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Border.TargetFooter">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>
  <Style Selector="Button.TargetRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.TargetRow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.TargetRow.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
  </Style>
  <Style Selector="Button.TargetRow.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
  </Style>
  <Style Selector="Border.Mark">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.Mark.radio">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Border.Mark.check">
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="Button.TargetRow.on Border.Mark">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Ellipse.RadioDot">
    <Setter Property="Width" Value="6"/>
    <Setter Property="Height" Value="6"/>
    <Setter Property="Fill" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector="Path.CheckGlyph">
    <Setter Property="Stroke" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="StrokeThickness" Value="1.8"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector="Button.TargetRow.on Ellipse.RadioDot, Button.TargetRow.on Path.CheckGlyph">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="TextBlock.RowSecondary">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
  </Style>
  <Style Selector="Border.Pill">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}"/>
    <Setter Property="Padding" Value="7,1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.Pill TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="StackPanel.Field">
    <Setter Property="Spacing" Value="4"/>
  </Style>
  <Style Selector="StackPanel.Field ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="TextBlock.FieldLabel">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.FieldError">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

</Styles>
