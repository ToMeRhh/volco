<?xml version="1.0" encoding="utf-8"?>
<!-- Brushes.axaml - one brush per colour token (Colors.axaml), per theme. Every variant needs its
     own copy, the high-contrast ones included: a brush found through an inherited variant's
     dictionary resolves its colour as that base variant, not as the one requested. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="using:Volco.App">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
      <SolidColorBrush x:Key="SubtleBrush" Color="{DynamicResource SubtleColor}"/>
      <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
      <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}"/>
      <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiaryColor}"/>
      <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}"/>
      <SolidColorBrush x:Key="OnAccentBrush" Color="{DynamicResource OnAccentColor}"/>
      <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
      <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
      <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
      <SolidColorBrush x:Key="SurfaceCardBrush" Color="{DynamicResource SurfaceCardColor}"/>
      <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{DynamicResource SurfaceStrokeColor}"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
      <SolidColorBrush x:Key="IconAccentBrush" Color="{DynamicResource IconAccentColor}"/>
      <SolidColorBrush x:Key="PresetFill0Brush" Color="{DynamicResource PresetFill0Color}"/>
      <SolidColorBrush x:Key="PresetEdge0Brush" Color="{DynamicResource PresetEdge0Color}"/>
      <SolidColorBrush x:Key="PresetFill1Brush" Color="{DynamicResource PresetFill1Color}"/>
      <SolidColorBrush x:Key="PresetEdge1Brush" Color="{DynamicResource PresetEdge1Color}"/>
      <SolidColorBrush x:Key="PresetFill2Brush" Color="{DynamicResource PresetFill2Color}"/>
      <SolidColorBrush x:Key="PresetEdge2Brush" Color="{DynamicResource PresetEdge2Color}"/>
      <SolidColorBrush x:Key="PresetFill3Brush" Color="{DynamicResource PresetFill3Color}"/>
      <SolidColorBrush x:Key="PresetEdge3Brush" Color="{DynamicResource PresetEdge3Color}"/>
      <SolidColorBrush x:Key="PresetFill4Brush" Color="{DynamicResource PresetFill4Color}"/>
      <SolidColorBrush x:Key="PresetEdge4Brush" Color="{DynamicResource PresetEdge4Color}"/>
      <SolidColorBrush x:Key="PresetFill5Brush" Color="{DynamicResource PresetFill5Color}"/>
      <SolidColorBrush x:Key="PresetEdge5Brush" Color="{DynamicResource PresetEdge5Color}"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
      <SolidColorBrush x:Key="SubtleBrush" Color="{DynamicResource SubtleColor}"/>
      <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
      <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}"/>
      <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiaryColor}"/>
      <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}"/>
      <SolidColorBrush x:Key="OnAccentBrush" Color="{DynamicResource OnAccentColor}"/>
      <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
      <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
      <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
      <SolidColorBrush x:Key="SurfaceCardBrush" Color="{DynamicResource SurfaceCardColor}"/>
      <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{DynamicResource SurfaceStrokeColor}"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
      <SolidColorBrush x:Key="IconAccentBrush" Color="{DynamicResource IconAccentColor}"/>
      <SolidColorBrush x:Key="PresetFill0Brush" Color="{DynamicResource PresetFill0Color}"/>
      <SolidColorBrush x:Key="PresetEdge0Brush" Color="{DynamicResource PresetEdge0Color}"/>
      <SolidColorBrush x:Key="PresetFill1Brush" Color="{DynamicResource PresetFill1Color}"/>
      <SolidColorBrush x:Key="PresetEdge1Brush" Color="{DynamicResource PresetEdge1Color}"/>
      <SolidColorBrush x:Key="PresetFill2Brush" Color="{DynamicResource PresetFill2Color}"/>
      <SolidColorBrush x:Key="PresetEdge2Brush" Color="{DynamicResource PresetEdge2Color}"/>
      <SolidColorBrush x:Key="PresetFill3Brush" Color="{DynamicResource PresetFill3Color}"/>
      <SolidColorBrush x:Key="PresetEdge3Brush" Color="{DynamicResource PresetEdge3Color}"/>
      <SolidColorBrush x:Key="PresetFill4Brush" Color="{DynamicResource PresetFill4Color}"/>
      <SolidColorBrush x:Key="PresetEdge4Brush" Color="{DynamicResource PresetEdge4Color}"/>
      <SolidColorBrush x:Key="PresetFill5Brush" Color="{DynamicResource PresetFill5Color}"/>
      <SolidColorBrush x:Key="PresetEdge5Brush" Color="{DynamicResource PresetEdge5Color}"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="{x:Static app:VolcoThemes.HighContrastDark}">
      <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
      <SolidColorBrush x:Key="SubtleBrush" Color="{DynamicResource SubtleColor}"/>
      <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
      <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}"/>
      <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiaryColor}"/>
      <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}"/>
      <SolidColorBrush x:Key="OnAccentBrush" Color="{DynamicResource OnAccentColor}"/>
      <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
      <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
      <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
      <SolidColorBrush x:Key="SurfaceCardBrush" Color="{DynamicResource SurfaceCardColor}"/>
      <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{DynamicResource SurfaceStrokeColor}"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
      <SolidColorBrush x:Key="IconAccentBrush" Color="{DynamicResource IconAccentColor}"/>
      <SolidColorBrush x:Key="PresetFill0Brush" Color="{DynamicResource PresetFill0Color}"/>
      <SolidColorBrush x:Key="PresetEdge0Brush" Color="{DynamicResource PresetEdge0Color}"/>
      <SolidColorBrush x:Key="PresetFill1Brush" Color="{DynamicResource PresetFill1Color}"/>
      <SolidColorBrush x:Key="PresetEdge1Brush" Color="{DynamicResource PresetEdge1Color}"/>
      <SolidColorBrush x:Key="PresetFill2Brush" Color="{DynamicResource PresetFill2Color}"/>
      <SolidColorBrush x:Key="PresetEdge2Brush" Color="{DynamicResource PresetEdge2Color}"/>
      <SolidColorBrush x:Key="PresetFill3Brush" Color="{DynamicResource PresetFill3Color}"/>
      <SolidColorBrush x:Key="PresetEdge3Brush" Color="{DynamicResource PresetEdge3Color}"/>
      <SolidColorBrush x:Key="PresetFill4Brush" Color="{DynamicResource PresetFill4Color}"/>
      <SolidColorBrush x:Key="PresetEdge4Brush" Color="{DynamicResource PresetEdge4Color}"/>
      <SolidColorBrush x:Key="PresetFill5Brush" Color="{DynamicResource PresetFill5Color}"/>
      <SolidColorBrush x:Key="PresetEdge5Brush" Color="{DynamicResource PresetEdge5Color}"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="{x:Static app:VolcoThemes.HighContrastLight}">
      <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
      <SolidColorBrush x:Key="SubtleBrush" Color="{DynamicResource SubtleColor}"/>
      <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
      <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}"/>
      <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiaryColor}"/>
      <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}"/>
      <SolidColorBrush x:Key="OnAccentBrush" Color="{DynamicResource OnAccentColor}"/>
      <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
      <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
      <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
      <SolidColorBrush x:Key="SurfaceCardBrush" Color="{DynamicResource SurfaceCardColor}"/>
      <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{DynamicResource SurfaceStrokeColor}"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
      <SolidColorBrush x:Key="IconAccentBrush" Color="{DynamicResource IconAccentColor}"/>
      <SolidColorBrush x:Key="PresetFill0Brush" Color="{DynamicResource PresetFill0Color}"/>
      <SolidColorBrush x:Key="PresetEdge0Brush" Color="{DynamicResource PresetEdge0Color}"/>
      <SolidColorBrush x:Key="PresetFill1Brush" Color="{DynamicResource PresetFill1Color}"/>
      <SolidColorBrush x:Key="PresetEdge1Brush" Color="{DynamicResource PresetEdge1Color}"/>
      <SolidColorBrush x:Key="PresetFill2Brush" Color="{DynamicResource PresetFill2Color}"/>
      <SolidColorBrush x:Key="PresetEdge2Brush" Color="{DynamicResource PresetEdge2Color}"/>
      <SolidColorBrush x:Key="PresetFill3Brush" Color="{DynamicResource PresetFill3Color}"/>
      <SolidColorBrush x:Key="PresetEdge3Brush" Color="{DynamicResource PresetEdge3Color}"/>
      <SolidColorBrush x:Key="PresetFill4Brush" Color="{DynamicResource PresetFill4Color}"/>
      <SolidColorBrush x:Key="PresetEdge4Brush" Color="{DynamicResource PresetEdge4Color}"/>
      <SolidColorBrush x:Key="PresetFill5Brush" Color="{DynamicResource PresetFill5Color}"/>
      <SolidColorBrush x:Key="PresetEdge5Brush" Color="{DynamicResource PresetEdge5Color}"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="OsdBackgroundBrush" Color="{DynamicResource OsdBackgroundColor}"/>
  <SolidColorBrush x:Key="OsdBorderBrush" Color="{DynamicResource OsdBorderColor}"/>
  <SolidColorBrush x:Key="OsdTextBrush" Color="{DynamicResource OsdTextColor}"/>
  <SolidColorBrush x:Key="OsdAccentBrush" Color="{DynamicResource OsdAccentColor}"/>
</ResourceDictionary>
