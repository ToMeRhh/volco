<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens.axaml - theme-independent design tokens (spec §3.7): a 4 px spacing grid, radii, widths. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="SpaceXs">4</x:Double>
  <x:Double x:Key="SpaceS">8</x:Double>
  <x:Double x:Key="SpaceM">12</x:Double>
  <x:Double x:Key="SpaceL">16</x:Double>
  <x:Double x:Key="SpaceXl">24</x:Double>
  <x:Double x:Key="SpaceXxl">32</x:Double>

  <Thickness x:Key="PagePadding">24,8,24,32</Thickness>
  <Thickness x:Key="CardPadding">16</Thickness>
  <Thickness x:Key="CardBodyPadding">32,12,16,16</Thickness>

  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>

  <x:Double x:Key="PageMaxWidth">760</x:Double>
  <x:Double x:Key="FieldLabelWidth">150</x:Double>
  <x:Double x:Key="SettingsCardMinWidth">320</x:Double>
  <x:Double x:Key="SettingsCardMaxWidth">640</x:Double>
  <x:Double x:Key="ComboBoxStandardWidth">240</x:Double>
  <x:Double x:Key="SliderStandardWidth">240</x:Double>
</ResourceDictionary>
