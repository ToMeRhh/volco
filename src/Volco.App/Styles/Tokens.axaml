<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens.axaml - theme-independent design tokens, ported 1:1 from the WinUI Tokens.xaml. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="SpaceXs">4</x:Double>
  <x:Double x:Key="SpaceS">8</x:Double>
  <x:Double x:Key="SpaceM">12</x:Double>
  <x:Double x:Key="SpaceL">16</x:Double>
  <x:Double x:Key="SpaceXl">24</x:Double>

  <Thickness x:Key="PagePadding">24</Thickness>
  <Thickness x:Key="CardPadding">12</Thickness>

  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>

  <x:Double x:Key="SettingsCardMinWidth">320</x:Double>
  <x:Double x:Key="SettingsCardMaxWidth">640</x:Double>
  <x:Double x:Key="ComboBoxStandardWidth">200</x:Double>
  <x:Double x:Key="SliderStandardWidth">200</x:Double>
</ResourceDictionary>
