<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Volco.App.Osd.VolumeOsdWindow"
        Title="Volco OSD"
        Width="360" Height="56"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        IsHitTestVisible="False">
  <!-- Always dark, whatever the app theme (Osd* tokens): solid surface, hairline border. -->
  <Border Name="Root"
          Background="{DynamicResource OsdBackgroundBrush}"
          BorderBrush="{DynamicResource OsdBorderBrush}"
          BorderThickness="1"
          CornerRadius="8"
          IsHitTestVisible="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
      <Panel Width="20" Height="20" VerticalAlignment="Center">
        <PathIcon Name="VolumeIcon" Data="{StaticResource Icon.Volume}" Width="20" Height="20"
                  Foreground="{DynamicResource OsdTextBrush}"/>
        <PathIcon Name="SpeakerIcon" Data="{StaticResource Icon.Speaker}" Width="20" Height="20"
                  Foreground="{DynamicResource OsdTextBrush}" IsVisible="False"/>
        <PathIcon Name="MutedIcon" Data="{StaticResource Icon.Muted}" Width="20" Height="20"
                  Foreground="{DynamicResource OsdTextBrush}" IsVisible="False"/>
        <PathIcon Name="ModeIcon" Data="{StaticResource Icon.Mode}" Width="20" Height="20"
                  Foreground="{DynamicResource OsdTextBrush}" IsVisible="False"/>
        <!-- The device's own icon (the vector art, ScreenIcons.Geometry). Muted, it is dimmed and
             struck through (the slash is outlined in the surface colour to stand out against the
             icon). -->
        <PathIcon Name="DeviceIcon" Width="20" Height="20" IsVisible="False"
                  Foreground="{DynamicResource OsdTextBrush}"/>
        <!-- An apps slider's app icon (AppIconLookup), when Volco has seen one; it replaces the
             glyph, and is dimmed and struck through like the device icon while muted. -->
        <Image Name="AppIcon" Width="20" Height="20" IsVisible="False"/>
        <Panel Name="DeviceMuteSlash" IsVisible="False">
          <Line StartPoint="2,2" EndPoint="18,18" StrokeThickness="4" StrokeLineCap="Round"
                Stroke="{DynamicResource OsdBackgroundBrush}"/>
          <Line StartPoint="2,2" EndPoint="18,18" StrokeThickness="1.5" StrokeLineCap="Round"
                Stroke="{DynamicResource OsdTextBrush}"/>
        </Panel>
      </Panel>
      <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="12,0,0,0" Width="210">
        <TextBlock Name="LabelText" Text="Output" Foreground="{DynamicResource OsdTextBrush}" FontSize="12"
                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
        <ProgressBar Name="LevelBar" Minimum="0" Maximum="100" Value="0" Height="4" MinHeight="4" Margin="0,4,0,0"
                     Foreground="{DynamicResource OsdAccentBrush}" Background="{DynamicResource OsdBorderBrush}"/>
      </StackPanel>
      <TextBlock Name="ValueText" Text="0%" Foreground="{DynamicResource OsdTextBrush}" FontSize="13"
                 VerticalAlignment="Center" TextAlignment="Right" Width="52" Margin="12,0,4,0"/>
    </StackPanel>
  </Border>
</Window>
