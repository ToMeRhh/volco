<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Volco.App.Views"
        xmlns:vm="using:Volco.App.ViewModels"
        xmlns:conv="using:Volco.App.Converters"
        x:Class="Volco.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Volco Settings"
        Width="860" Height="660" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full">
  <Window.Resources>
    <conv:ConnectionStatusToBrushConverter x:Key="StatusToBrush"/>
  </Window.Resources>

  <!-- The client area extends into the title bar: Windows still draws the caption buttons
       over the top-right corner, and the top row of each pane is the drag region. -->
  <Grid ColumnDefinitions="208,*" RowDefinitions="40,*">
    <!-- Sidebar, running up to the top edge, with the brand in the title bar row -->
    <Border Grid.Column="0" Grid.RowSpan="2" Classes="Sidebar"/>
    <Border Grid.Column="0" Name="SidebarTitleBar" Classes="TitleBarDrag"
            WindowDecorationProperties.ElementRole="TitleBar">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center"
                  IsHitTestVisible="False">
        <Border Classes="BrandMark">
          <PathIcon Data="{StaticResource Icon.Sliders}" Width="12" Height="12"
                    Foreground="{DynamicResource OnAccentBrush}"/>
        </Border>
        <TextBlock Name="BrandText" Text="Volco" Classes="Brand" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <Border Grid.Column="1" Name="PageTitleBar" Classes="TitleBarDrag"
            WindowDecorationProperties.ElementRole="TitleBar"/>

    <!-- Navigation, with the connection state always visible at the bottom -->
    <DockPanel Grid.Column="0" Grid.Row="1" Margin="10,4,10,12">
      <StackPanel Name="ConnectionFooter" DockPanel.Dock="Bottom" Orientation="Horizontal"
                  Spacing="8" Margin="12,8">
        <Ellipse Name="FooterDot" Width="8" Height="8" VerticalAlignment="Center"
                 Fill="{Binding Connection.Status, Converter={StaticResource StatusToBrush}}"/>
        <TextBlock Name="FooterText" Classes="Caption" VerticalAlignment="Center"
                   Text="{Binding Connection.FooterText}"/>
      </StackPanel>
      <ListBox Name="NavList" Classes="Nav">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="views:NavItem">
            <Grid ColumnDefinitions="Auto,Auto,*">
              <Border Classes="NavMarker" Width="3" Height="16" CornerRadius="2" Margin="-10,0,8,0"
                      Background="{DynamicResource AccentBrush}"/>
              <PathIcon Grid.Column="1" Data="{Binding Icon}" Width="16" Height="16"
                        Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="2" Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- The page, with the undo message floating over its bottom edge -->
    <Panel Grid.Column="1" Grid.Row="1">
      <ContentControl Name="PageHost"/>
      <Border Name="Toast" IsVisible="{Binding Toast.IsOpen}"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
              Background="{DynamicResource TextBrush}" CornerRadius="{StaticResource ControlCornerRadius}"
              Padding="14,6,6,6" BoxShadow="0 6 20 0 #33000000">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Name="ToastText" Text="{Binding Toast.Message}" VerticalAlignment="Center"
                     Foreground="{DynamicResource BgBrush}"/>
          <Button Name="UndoButton" Content="Undo" Command="{Binding Toast.UndoCommand}"
                  Background="Transparent" BorderThickness="0" FontWeight="SemiBold"
                  Foreground="{DynamicResource BgBrush}"/>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</Window>
