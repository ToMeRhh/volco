<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Volco.App.Views"
        xmlns:vm="using:Volco.App.ViewModels"
        xmlns:conv="using:Volco.App.Converters"
        x:Class="Volco.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Volco Settings"
        Width="1100" Height="720" MinWidth="820" MinHeight="520"
        Classes.compact="{Binding $self.Bounds.Width, Converter={x:Static conv:LayoutConverters.IsCompact}}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        WindowDecorationsTheme="{DynamicResource SettingsWindowDecorations}">
  <Window.Resources>
    <conv:LinkToneToBrushConverter x:Key="ToneToBrush"/>
    <!-- Avalonia draws the caption buttons itself. Fluent's decorations also draw the window
         title (over our brand) and a fullscreen button (with no way back out), so hide both.
         The title panel's IsVisible is template-bound, which beats a style, so hide its text. -->
    <ControlTheme x:Key="SettingsWindowDecorations" TargetType="WindowDrawnDecorations"
                  BasedOn="{StaticResource {x:Type WindowDrawnDecorations}}">
      <Style Selector="^ /template/ Panel#PART_TitleTextPanel > TextBlock">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^ /template/ Button#PART_FullScreenButton">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
    </ControlTheme>
  </Window.Resources>

  <!-- The client area extends into the title bar: the caption buttons are drawn over the
       top-right corner, and the top row of each pane is the drag region. -->
  <Grid ColumnDefinitions="Auto,*" RowDefinitions="40,*">
    <!-- The sidebar's room in the layout: 168 px, or 56 in the compact layout -->
    <Border Name="SidebarSpacer" Grid.Column="0" Grid.RowSpan="2" Classes="SidebarWidth"/>

    <!-- The sidebar, running up to the top edge, with the brand in the title bar row. It lies over
         the page: in the compact layout it shows icons only, and opens over the page while the
         mouse is on it. -->
    <Grid Name="SidebarHost" Grid.ColumnSpan="2" Grid.RowSpan="2" RowDefinitions="40,*" ZIndex="1"
          HorizontalAlignment="Left" Classes="SidebarHost">
      <Border Name="Sidebar" Grid.RowSpan="2" Classes="Sidebar"/>
      <Border Name="SidebarTitleBar" Classes="TitleBarDrag"
              WindowDecorationProperties.ElementRole="TitleBar">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center"
                    IsHitTestVisible="False">
          <Border Classes="BrandMark">
            <PathIcon Data="{StaticResource Icon.Sliders}" Width="12" Height="12"
                      Foreground="{DynamicResource OnAccentBrush}"/>
          </Border>
          <TextBlock Name="BrandText" Text="Volco" Classes="Brand" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <DockPanel Grid.Row="1" Margin="10,4,10,12" Classes="NavPane">
        <StackPanel Name="ConnectionFooter" DockPanel.Dock="Bottom" Orientation="Horizontal" Classes="ConnectionFooter"
                    ToolTip.Tip="{Binding Connection.FooterText}"
                    Spacing="8" Margin="12,8">
          <Ellipse Name="FooterDot" Width="8" Height="8" VerticalAlignment="Center"
                   Fill="{Binding Connection.StatusTone, Converter={StaticResource ToneToBrush}}"/>
          <TextBlock Name="FooterText" Classes="Caption FooterLabel" VerticalAlignment="Center"
                     Text="{Binding Connection.FooterText}"/>
        </StackPanel>
        <StackPanel Name="AboutFooter" DockPanel.Dock="Bottom" Spacing="2" Margin="12,8,12,0" Classes="AboutFooter">
          <!-- Non-release builds carry their branch, commit and build time as the tooltip -->
          <TextBlock Name="VersionText" Classes="Caption" Text="{Binding About.VersionText}"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding About.BuildDetails}"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <HyperlinkButton Name="RepoLink" Padding="0" FontSize="12" Content="GitHub"
                             NavigateUri="{Binding About.RepoUri}" ToolTip.Tip="{Binding About.RepoUri}"/>
            <HyperlinkButton Name="NoticesLink" Padding="0" FontSize="12" Content="Notices"
                             ToolTip.Tip="Third-party notices" Command="{Binding About.OpenNoticesCommand}"/>
          </StackPanel>
        </StackPanel>
        <ListBox Name="NavList" Classes="Nav">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="views:NavItem">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ToolTip.Tip="{Binding Label}">
                <Border Classes="NavMarker" Width="3" Height="16" CornerRadius="2" Margin="-10,0,8,0"
                        Background="{DynamicResource AccentBrush}"/>
                <PathIcon Grid.Column="1" Data="{Binding Icon}" Width="16" Height="16"
                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Classes="NavLabel" Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Ellipse Name="NavDot" Grid.Column="3" Width="7" Height="7" Margin="8,0,4,0" VerticalAlignment="Center"
                         Fill="{DynamicResource AccentBrush}"
                         AutomationProperties.Name="Controller needs attention"
                         IsVisible="{Binding ShowDot}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>

    <Border Grid.Column="1" Name="PageTitleBar" Classes="TitleBarDrag"
            WindowDecorationProperties.ElementRole="TitleBar"/>

    <!-- The page, with the undo message floating over its bottom edge -->
    <Panel Grid.Column="1" Grid.Row="1">
      <!-- Controls and Hardware share one stage (hardware-page spec §3.3); General crossfades in -->
      <TransitioningContentControl Name="PageHost"/>
      <Border Name="Toast" IsVisible="{Binding Toast.IsOpen}"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
              Background="{DynamicResource TextBrush}" CornerRadius="{StaticResource ControlCornerRadius}"
              Padding="14,6,6,6" BoxShadow="0 6 20 0 #33000000">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Name="ToastText" Text="{Binding Toast.Message}" VerticalAlignment="Center"
                     Foreground="{DynamicResource BgBrush}"/>
          <Button Name="UndoButton" Content="Undo" Command="{Binding Toast.UndoCommand}"
                  Background="Transparent" BorderThickness="0" FontWeight="SemiBold"
                  Foreground="{DynamicResource BgBrush}"/>
        </StackPanel>
      </Border>
    </Panel>

    <!-- Third-party notices: a modal card over the whole window; Escape or a click outside closes it -->
    <Border Name="NoticesOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" ZIndex="2" Background="#66000000"
            IsVisible="{Binding About.IsNoticesOpen}">
      <Border Name="NoticesCard" Classes="Panel" Padding="24" Margin="40" MaxWidth="720"
              HorizontalAlignment="Center" BoxShadow="0 8 28 0 #40000000">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
            <TextBlock Classes="Subtitle" Text="Third-party notices"/>
            <!-- The controller firmware Volco carries is built from these components (spec 9.3). -->
            <TextBlock Classes="Caption" TextWrapping="Wrap"
                       Text="The controller firmware that Volco installs is built from these components."/>
          </StackPanel>
          <Button Name="CloseNoticesButton" DockPanel.Dock="Bottom" HorizontalAlignment="Right"
                  Margin="0,14,0,0" Content="Close" Command="{Binding About.CloseNoticesCommand}"/>
          <TextBox Name="NoticesBox" IsReadOnly="True" TextWrapping="Wrap"
                   FontFamily="Consolas, Menlo, monospace" FontSize="11"/>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</Window>
