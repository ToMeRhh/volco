<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Volco.App.Views"
        xmlns:vm="using:Volco.App.ViewModels"
        xmlns:conv="using:Volco.App.Converters"
        xmlns:hw="using:Volco.App.ViewModels.Hardware"
        xmlns:hwviews="using:Volco.App.Views.Hardware"
        x:Class="Volco.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Volco Settings"
        Width="1540" Height="900" MinWidth="820" MinHeight="520"
        Classes.compact="{Binding $self.Bounds.Width, Converter={x:Static conv:LayoutConverters.IsCompact}}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        WindowDecorationsTheme="{DynamicResource SettingsWindowDecorations}">
  <Window.Resources>
    <conv:LinkToneToBrushConverter x:Key="ToneToBrush"/>
    <!-- Avalonia draws the caption buttons itself. Fluent's decorations also draw the window
         title (over our brand) and a fullscreen button (with no way back out), so hide both.
         The title panel's IsVisible is template-bound, which beats a style, so hide its text. -->
    <ControlTheme x:Key="SettingsWindowDecorations" TargetType="WindowDrawnDecorations"
                  BasedOn="{StaticResource {x:Type WindowDrawnDecorations}}">
      <Style Selector="^ /template/ Panel#PART_TitleTextPanel > TextBlock">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^ /template/ Button#PART_FullScreenButton">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
    </ControlTheme>
  </Window.Resources>

  <!-- The client area extends into the title bar: the caption buttons are drawn over the
       top-right corner, and the top row of each pane is the drag region. -->
  <Grid ColumnDefinitions="Auto,*" RowDefinitions="40,*">
    <!-- The sidebar's room in the layout: 168 px, or 56 in the compact layout -->
    <Border Name="SidebarSpacer" Grid.Column="0" Grid.RowSpan="2" Classes="SidebarWidth"/>

    <!-- The sidebar, running up to the top edge, with the brand in the title bar row. It lies over
         the page: in the compact layout it shows icons only, and opens over the page while the
         mouse is on it. -->
    <Grid Name="SidebarHost" Grid.ColumnSpan="2" Grid.RowSpan="2" RowDefinitions="40,*" ZIndex="1"
          HorizontalAlignment="Left" Classes="SidebarHost">
      <Border Name="Sidebar" Grid.RowSpan="2" Classes="Sidebar"/>
      <Border Name="SidebarTitleBar" Classes="TitleBarDrag"
              WindowDecorationProperties.ElementRole="TitleBar">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center"
                    IsHitTestVisible="False">
          <Border Classes="BrandMark">
            <PathIcon Data="{StaticResource Icon.Sliders}" Width="12" Height="12"
                      Foreground="{DynamicResource OnAccentBrush}"/>
          </Border>
          <TextBlock Name="BrandText" Text="Volco" Classes="Brand" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <DockPanel Grid.Row="1" Margin="10,4,10,12" Classes="NavPane">
        <StackPanel Name="AboutFooter" DockPanel.Dock="Bottom" Spacing="2" Margin="12,8,12,0" Classes="AboutFooter">
          <!-- Non-release builds carry their branch, commit and build time as the tooltip -->
          <TextBlock Name="VersionText" Classes="Caption" Text="{Binding About.VersionText}"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding About.BuildDetails}"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <HyperlinkButton Name="RepoLink" Padding="0" FontSize="12" Content="GitHub"
                             NavigateUri="{Binding About.RepoUri}" ToolTip.Tip="{Binding About.RepoUri}"/>
            <HyperlinkButton Name="NoticesLink" Padding="0" FontSize="12" Content="Notices"
                             ToolTip.Tip="Third-party notices" Command="{Binding About.OpenNoticesCommand}"/>
          </StackPanel>
        </StackPanel>
        <!-- The controller's status line (controller-page spec §5), above the version and links on every page -->
        <hwviews:SidebarStatus Name="StatusLine" DockPanel.Dock="Bottom" Margin="0,8,0,0" DataContext="{Binding Hardware.Status}"/>
        <ListBox Name="NavList" Classes="Nav">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="views:NavItem">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ToolTip.Tip="{Binding Label}">
                <Border Classes="NavMarker" Width="3" Height="16" CornerRadius="2" Margin="-10,0,8,0"
                        Background="{DynamicResource AccentBrush}"/>
                <PathIcon Grid.Column="1" Data="{Binding Icon}" Width="16" Height="16"
                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Classes="NavLabel" Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Ellipse Name="NavDot" Grid.Column="3" Width="7" Height="7" Margin="8,0,4,0" VerticalAlignment="Center"
                         Fill="{DynamicResource AccentBrush}"
                         AutomationProperties.Name="Controller needs attention"
                         IsVisible="{Binding ShowDot}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>

    <Border Grid.Column="1" Name="PageTitleBar" Classes="TitleBarDrag"
            WindowDecorationProperties.ElementRole="TitleBar"/>

    <!-- The page, under the status banner when the controller needs the user (controller-page
         spec §5), with the undo message floating over its bottom edge -->
    <DockPanel Grid.Column="1" Grid.Row="1">
      <hwviews:StatusBanner Name="StatusBanner" DockPanel.Dock="Top" DataContext="{Binding Hardware.Status}"/>
      <Panel>
        <!-- General and the Controller page; going between them crossfades -->
        <TransitioningContentControl Name="PageHost"/>
        <Border Name="Toast" IsVisible="{Binding Toast.IsOpen}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Background="{DynamicResource TextBrush}" CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="14,6,6,6" BoxShadow="0 6 20 0 #33000000">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Name="ToastText" Text="{Binding Toast.Message}" VerticalAlignment="Center"
                       Foreground="{DynamicResource BgBrush}"/>
            <Button Name="UndoButton" Content="Undo" Command="{Binding Toast.UndoCommand}"
                    Background="Transparent" BorderThickness="0" FontWeight="SemiBold"
                    Foreground="{DynamicResource BgBrush}"/>
          </StackPanel>
        </Border>
      </Panel>
    </DockPanel>

    <!-- The status's dialogs, over the whole window since the status is on every page
         (controller-page spec §5): modal cards; Escape or a click on the scrim closes them, and
         the focus moves in and back. Compare (hardware-page spec §7.2): -->
    <Border Name="CompareOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" ZIndex="2" Background="#66000000" IsVisible="False">
      <Border Name="CompareCard" Classes="Panel DialogCard" KeyboardNavigation.TabNavigation="Cycle"
              VerticalAlignment="Center" Focusable="True">
        <ContentControl Name="CompareHost">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type hw:CompareViewModel}" x:DataType="hw:CompareViewModel">
              <hwviews:CompareDialog/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>
    </Border>

    <!-- The Connection dialog (hardware-page spec §10) -->
    <Border Name="ConnectionOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" ZIndex="2" Background="#66000000" IsVisible="False">
      <Border Name="ConnectionCard" Classes="Panel DialogCard Narrow" KeyboardNavigation.TabNavigation="Cycle"
              VerticalAlignment="Center" Focusable="True">
        <ContentControl Name="ConnectionHost">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type hw:ConnectionDialogViewModel}" x:DataType="hw:ConnectionDialogViewModel">
              <hwviews:ConnectionDialog/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>
    </Border>

    <!-- A slider's Re-calibrate sweep (slider-calibration spec, "The sweep"): Escape and a click on
         the scrim are Cancel -->
    <Border Name="CalibrationOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" ZIndex="2" Background="#66000000" IsVisible="False">
      <Border Name="CalibrationCard" Classes="Panel DialogCard Narrow" KeyboardNavigation.TabNavigation="Cycle"
              VerticalAlignment="Center" Focusable="True">
        <ContentControl Name="CalibrationHost">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type hw:CalibrationDialogViewModel}" x:DataType="hw:CalibrationDialogViewModel">
              <hwviews:CalibrationDialog/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>
    </Border>

    <!-- The I2C buses dialog (controller-page spec §4.3): its edits are already in the draft, so
         Escape and a click on the scrim close it like Done -->
    <Border Name="BusesOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" ZIndex="2" Background="#66000000" IsVisible="False">
      <Border Name="BusesCard" Classes="Panel DialogCard Narrow" KeyboardNavigation.TabNavigation="Cycle"
              VerticalAlignment="Center" Focusable="True">
        <ContentControl Name="BusesHost">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type hw:I2cBusesViewModel}" x:DataType="hw:I2cBusesViewModel">
              <hwviews:I2cBusesDialog/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>
    </Border>

    <!-- A pin field's pin dialog (hardware-page spec §6.3), after the I2C buses dialog so it opens
         over it (a bus's SDA and SCL): Escape and a click on the scrim are Cancel -->
    <Border Name="PinOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" ZIndex="2" Background="#66000000" IsVisible="False">
      <Border Name="PinCard" Classes="Panel DialogCard Wide" KeyboardNavigation.TabNavigation="Cycle"
              VerticalAlignment="Center" Focusable="True">
        <ContentControl Name="PinHost">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type hw:PinFieldViewModel}" x:DataType="hw:PinFieldViewModel">
              <hwviews:PinDialog/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>
    </Border>

    <!-- Leaving the Controller page with unsaved changes (controller-page spec §4.4): over the
         whole window, sidebar included, so neither the nav nor the status's actions change the draft
         under it; Escape or a click outside is Stay -->
    <Border Name="LeaveOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" ZIndex="2" Background="#66000000" IsVisible="False">
      <Border Name="LeaveCard" Classes="Panel DialogCard Narrow" KeyboardNavigation.TabNavigation="Cycle"
              VerticalAlignment="Center" Focusable="True">
        <ContentControl Name="LeaveHost">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type hw:LeavePromptViewModel}" x:DataType="hw:LeavePromptViewModel">
              <hwviews:LeavePrompt/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>
    </Border>

    <!-- The install confirmation (the status menu's Reinstall firmware…, the banner's or the progress
         dialog's Install firmware): it erases the setup, or replaces what a board without Volco's
         firmware runs -->
    <Border Name="ReinstallOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" ZIndex="2" Background="#66000000"
            IsVisible="{Binding Hardware.Status.Controller.ConfirmInstallPending}">
      <Border Name="ReinstallConfirm" Classes="Panel DialogCard Small" Padding="20" KeyboardNavigation.TabNavigation="Cycle"
              Focusable="True">
        <StackPanel Spacing="14">
          <TextBlock Name="ReinstallQuestion" TextWrapping="Wrap"
                     Text="{Binding Hardware.Status.Controller.InstallQuestion}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelReinstallButton" Content="Cancel" Command="{Binding Hardware.Status.Controller.CancelInstallCommand}"/>
            <Button Name="ConfirmReinstallButton" Classes.Danger="{Binding !Hardware.Status.Controller.OfferFreshInstall}"
                    Classes.Primary="{Binding Hardware.Status.Controller.OfferFreshInstall}"
                    Content="{Binding Hardware.Status.Controller.InstallConfirmLabel}"
                    Command="{Binding Hardware.Status.Controller.ConfirmInstallCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- The controller can't be used (controller-page spec §5): no controller answers, or its
         firmware is too old. Opens once each time the state begins, over every other status dialog
         but under the progress dialog, which takes over when its button starts an operation. Not
         now, Escape or a click on the scrim closes it; the banner stays. -->
    <Border Name="AttentionOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" ZIndex="2" Background="#66000000" IsVisible="False">
      <Border Name="AttentionCard" Classes="Panel DialogCard Small" Padding="20" KeyboardNavigation.TabNavigation="Cycle"
              Focusable="True">
        <StackPanel Spacing="10">
          <TextBlock Name="AttentionTitle" Classes="DialogTitle" TextWrapping="Wrap"
                     Text="{Binding Hardware.Status.State.Status}"/>
          <TextBlock Name="AttentionDetail" TextWrapping="Wrap" Text="{Binding Hardware.Status.State.Detail}"
                     IsVisible="{Binding Hardware.Status.State.Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Name="AttentionNotNowButton" Content="Not now" Command="{Binding Hardware.Status.NotNowCommand}"/>
            <Button Name="AttentionActionButton" Classes="Primary" Content="{Binding Hardware.Status.ActionLabel}"
                    IsVisible="{Binding Hardware.Status.HasAction}"
                    Command="{Binding Hardware.Status.AttentionActCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- A firmware install, update or check, or a save, runs (controller-page spec §5, "Running,
         don't interrupt"): above every other dialog, over the whole window. Nothing closes it while
         the operation runs; afterwards Close, Escape or a click on the scrim does. -->
    <Border Name="ProgressOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" ZIndex="3" Background="#66000000"
            IsVisible="{Binding Hardware.Status.Progress.IsOpen}">
      <Border Name="ProgressCard" Classes="Panel DialogCard Narrow" KeyboardNavigation.TabNavigation="Cycle"
              VerticalAlignment="Center" Focusable="True">
        <hwviews:ProgressDialog Name="ProgressDialog" DataContext="{Binding Hardware.Status.Progress}"/>
      </Border>
    </Border>

    <!-- Third-party notices: a modal card over the whole window; Escape or a click outside closes it -->
    <Border Name="NoticesOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" ZIndex="2" Background="#66000000"
            IsVisible="{Binding About.IsNoticesOpen}">
      <Border Name="NoticesCard" Classes="Panel" Padding="24" Margin="40" MaxWidth="720"
              HorizontalAlignment="Center" BoxShadow="0 8 28 0 #40000000">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
            <TextBlock Classes="Subtitle" Text="Third-party notices"/>
            <!-- The controller firmware Volco carries is built from these components (spec 9.3). -->
            <TextBlock Classes="Caption" TextWrapping="Wrap"
                       Text="The controller firmware that Volco installs is built from these components."/>
          </StackPanel>
          <Button Name="CloseNoticesButton" DockPanel.Dock="Bottom" HorizontalAlignment="Right"
                  Margin="0,14,0,0" Content="Close" Command="{Binding About.CloseNoticesCommand}"/>
          <TextBox Name="NoticesBox" IsReadOnly="True" TextWrapping="Wrap"
                   FontFamily="Consolas, Menlo, monospace" FontSize="11"/>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</Window>
