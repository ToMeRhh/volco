<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             x:Class="Volco.App.Views.Hardware.SaveBar"
             x:DataType="hw:HardwareViewModel">
  <!-- The save bar (hardware-page spec §6.5): across the top of the drawing in amber, with a warning
       sign, what is unsaved, what saving does, Discard and Save -->
  <Border Name="SaveBarBorder" Classes="SaveBar">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
      <PathIcon Name="SaveBarIcon" Data="{StaticResource Icon.Status.Warning}" Width="18" Height="18"
                Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Name="SaveBarText" Classes="SaveBarText" Text="{Binding SaveBarText}" VerticalAlignment="Center"/>
        <TextBlock Name="SaveBarNote" Classes="Secondary" Text="{Binding SaveBarNote}" VerticalAlignment="Center"
                   IsVisible="{Binding SaveBarNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
      <Button Name="DiscardButton" Grid.Column="2" Content="Discard" Command="{Binding DiscardCommand}"/>
      <Button Name="SaveButton" Grid.Column="3" Classes="Primary" Content="Save" Command="{Binding SaveCommand}"/>
    </Grid>
  </Border>
</UserControl>
