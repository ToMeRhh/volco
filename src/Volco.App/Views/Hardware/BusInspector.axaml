<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             xmlns:controls="using:Volco.App.Controls"
             x:Class="Volco.App.Views.Hardware.BusInspector"
             x:DataType="hw:BusWiringViewModel">
  <!-- An I2C bus (hardware-page spec §6.4): its SDA and SCL pins and its clock -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Classes="InspectorHeader">
      <TextBlock Name="HeadingText" Classes="InspectorHeading" Text="{Binding Title}"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="InspectorBody">
        <controls:PinField Name="SdaField" DataContext="{Binding Sda}"/>
        <controls:PinField Name="SclField" DataContext="{Binding Scl}"/>
        <StackPanel Classes="Field">
          <TextBlock Classes="FieldLabel" Text="Clock"/>
          <ComboBox Name="ClockBox" HorizontalAlignment="Stretch" ItemsSource="{x:Static hw:BusWiringViewModel.ClockChoices}"
                    SelectedIndex="{Binding ClockIndex, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
