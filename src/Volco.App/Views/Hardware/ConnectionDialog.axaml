<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Volco.App.ViewModels"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             xmlns:controls="using:Volco.App.Controls"
             x:Class="Volco.App.Views.Hardware.ConnectionDialog"
             x:DataType="hw:ConnectionDialogViewModel">
  <!-- Connection (hardware-page spec §10): how Volco reaches the controller, one card per transport.
       A card's header opens it (and closes the open one) and switches nothing; only the button in
       a card switches. A closed card shows its summary; the card in use has an In use badge. -->
  <UserControl.Styles>
    <!-- A header with a summary under its title grows to fit both lines -->
    <Style Selector="Button.ConnectionHeader">
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="12,8,12,8"/>
    </Style>
    <Style Selector="Border.ConnectionCard.open">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Border.InUseBadge">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}"/>
      <Setter Property="Padding" Value="8,1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.InUseBadge TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="StackPanel.ConnectionBody">
      <Setter Property="Spacing" Value="10"/>
      <Setter Property="Margin" Value="12,10,12,12"/>
    </Style>
    <Style Selector="TextBlock.FieldLabel">
      <Setter Property="Width" Value="120"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="16,12,16,16">
    <TextBlock Name="ConnectionTitle" DockPanel.Dock="Top" Margin="0,0,0,14" Classes="DialogTitle" Text="{Binding Title}"/>
    <Button Name="ConnectionClose" DockPanel.Dock="Bottom" Margin="0,14,0,0" Content="Close" HorizontalAlignment="Right"
            Command="{Binding CloseCommand}"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="10">
      <!-- USB cable (§10.2) -->
      <Border Name="UsbCard" Classes="InspectorRows ConnectionCard" Classes.open="{Binding IsOpen}"
              DataContext="{Binding UsbCard}" x:DataType="hw:UsbCardViewModel">
        <controls:CardRows>
          <Button Name="UsbCardHeader" Classes="InspectorRow ConnectionHeader" Command="{Binding OpenCommand}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <TextBlock Classes="SectionLabel" Text="{Binding Title}"/>
              <Border Grid.Column="1" Classes="InUseBadge" IsVisible="{Binding IsInUse}">
                <TextBlock Name="UsbInUse" Text="In use"/>
              </Border>
              <TextBlock Name="UsbCardSummary" Grid.Row="1" Grid.ColumnSpan="2" Classes="Caption" TextWrapping="Wrap"
                         Text="{Binding Summary}" IsVisible="{Binding ShowsSummary}"/>
            </Grid>
          </Button>
          <StackPanel Name="UsbCardBody" Classes="ConnectionBody" IsVisible="{Binding IsOpen}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="FieldLabel" Text="Port"/>
              <ComboBox Name="PortCombo" Width="{StaticResource ComboBoxStandardWidth}"
                        PlaceholderText="Select port…"
                        ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PortChoice"><TextBlock Text="{Binding Label}"/></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Name="RefreshPortsButton" Classes="Icon" Margin="4,0,0,0"
                      Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh the port list">
                <PathIcon Data="{StaticResource Icon.Refresh}" Width="14" Height="14"/>
              </Button>
            </StackPanel>
            <TextBlock Name="TurnOffPendingText" Classes="Caption" TextWrapping="Wrap" IsVisible="{Binding TurnOffPending}"
                       Text="The controller's Wi-Fi goes off once it answers over USB."/>
            <controls:StatusLine Name="UsbErrorText" Classes="Caption" Tone="Danger" Text="{Binding Error}"
                                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Button Name="SwitchToUsbButton" HorizontalAlignment="Left" Content="{Binding SwitchLabel}"
                    Command="{Binding SwitchCommand}" IsVisible="{Binding ShowsSwitch}"/>
            <!-- From Wi-Fi, Switch to USB asks first, here in the card -->
            <StackPanel Name="WifiOffPanel" Spacing="10" IsVisible="{Binding ConfirmingWifiOff}">
              <TextBlock Name="WifiOffQuestion" TextWrapping="Wrap" Text="{Binding WifiOffQuestion}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="CancelSwitchButton" Content="Cancel" Command="{Binding CancelSwitchCommand}"/>
                <Button Name="ConfirmSwitchButton" Classes="Primary" Content="Switch to USB and turn Wi-Fi off"
                        Command="{Binding ConfirmSwitchCommand}"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </controls:CardRows>
      </Border>

      <!-- Wi-Fi (§10.3): the controller's Wi-Fi settings, no numbered headings -->
      <Border Name="WifiCard" Classes="InspectorRows ConnectionCard" Classes.open="{Binding IsOpen}"
              DataContext="{Binding WifiCard}" x:DataType="hw:WifiCardViewModel">
        <controls:CardRows>
          <Button Name="WifiCardHeader" Classes="InspectorRow ConnectionHeader" Command="{Binding OpenCommand}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <TextBlock Classes="SectionLabel" Text="{Binding Title}"/>
              <Border Grid.Column="1" Classes="InUseBadge" IsVisible="{Binding IsInUse}">
                <TextBlock Name="WifiInUse" Text="In use"/>
              </Border>
              <TextBlock Name="WifiCardSummary" Grid.Row="1" Grid.ColumnSpan="2" Classes="Caption" TextWrapping="Wrap"
                         Text="{Binding Summary}" IsVisible="{Binding ShowsSummary}"/>
            </Grid>
          </Button>
          <StackPanel Name="WifiCardBody" Classes="ConnectionBody" IsVisible="{Binding IsOpen}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="FieldLabel" Text="Network"/>
              <TextBox Name="SsidBox" Width="220" MaxLength="32"
                       Text="{Binding Ssid, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="FieldLabel" Text="Password"/>
              <TextBox Name="PasswordBox" Width="220" MaxLength="64"
                       PasswordChar="{Binding PasswordChar}" Text="{Binding Password, Mode=TwoWay}"/>
              <CheckBox Name="ShowPasswordBox" Content="Show" Margin="8,0,0,0" IsChecked="{Binding ShowPassword, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="FieldLabel" Text="This PC's address"/>
              <ComboBox Name="AddressCombo" Width="220"
                        ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="hw:LocalAddress"><TextBlock Text="{Binding Label}"/></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <!-- Ports ›: Volco's listen port (the controller's PC port) and the controller's own -->
            <Border Classes="InspectorRows">
              <controls:CardRows>
                <Button Name="PortsHeader" Classes="InspectorRow" Classes.open="{Binding PortsOpen}"
                        Command="{Binding TogglePortsCommand}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="RowLabel" VerticalAlignment="Center" Text="Ports"/>
                    <PathIcon Grid.Column="1" Classes="RowChevron" Data="{StaticResource Icon.ChevronRight}"/>
                  </Grid>
                </Button>
                <StackPanel Name="PortsBody" Classes="ConnectionBody" IsVisible="{Binding PortsOpen}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" Text="Volco listens on"/>
                    <NumericUpDown Name="ListenPortBox" Width="140" Minimum="1024" Maximum="65535" FormatString="0"
                                   Value="{Binding ListenPort, Mode=TwoWay}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" Text="Controller's port"/>
                    <NumericUpDown Name="ControllerPortBox" Width="140" Minimum="1" Maximum="65535" FormatString="0"
                                   Value="{Binding ControllerPort, Mode=TwoWay}"/>
                  </StackPanel>
                </StackPanel>
              </controls:CardRows>
            </Border>
            <controls:StatusLine Name="WifiErrorText" Classes="Caption" Tone="Danger" Text="{Binding Error}"
                                 IsVisible="{Binding HasError}"/>
            <TextBlock Name="WifiNote" Classes="Caption" TextWrapping="Wrap" IsVisible="{Binding ShowsNote}"
                       Text="Sent over USB, then Volco switches to Wi-Fi."/>
            <Button Name="WifiSaveButton" Classes="Primary" HorizontalAlignment="Left" Content="{Binding ButtonLabel}"
                    Command="{Binding SaveCommand}"/>
            <TextBlock Name="WifiDisabledReason" Classes="Caption" TextWrapping="Wrap" Text="{Binding DisabledReason}"
                       IsVisible="{Binding HasDisabledReason}"/>
          </StackPanel>
        </controls:CardRows>
      </Border>

      <!-- Simulator (§10.4) -->
      <Border Name="SimulatorCard" Classes="InspectorRows ConnectionCard" Classes.open="{Binding IsOpen}"
              DataContext="{Binding SimulatorCard}" x:DataType="hw:SimulatorCardViewModel">
        <controls:CardRows>
          <Button Name="SimulatorCardHeader" Classes="InspectorRow ConnectionHeader" Command="{Binding OpenCommand}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <TextBlock Classes="SectionLabel" Text="{Binding Title}"/>
              <Border Grid.Column="1" Classes="InUseBadge" IsVisible="{Binding IsInUse}">
                <TextBlock Name="SimulatorInUse" Text="In use"/>
              </Border>
              <TextBlock Name="SimulatorCardSummary" Grid.Row="1" Grid.ColumnSpan="2" Classes="Caption" TextWrapping="Wrap"
                         Text="{Binding Summary}" IsVisible="{Binding ShowsSummary}"/>
            </Grid>
          </Button>
          <StackPanel Name="SimulatorCardBody" Classes="ConnectionBody" IsVisible="{Binding IsOpen}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="FieldLabel" Text="Port"/>
              <NumericUpDown Name="WebSocketPortBox" Width="140" Minimum="1024" Maximum="65535" FormatString="0"
                             Value="{Binding Port, Mode=TwoWay}"/>
            </StackPanel>
            <Button Name="SwitchToSimulatorButton" HorizontalAlignment="Left" Content="Switch to the simulator"
                    Command="{Binding SwitchCommand}" IsVisible="{Binding !IsInUse}"/>
          </StackPanel>
        </controls:CardRows>
      </Border>
    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
