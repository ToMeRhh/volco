<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             xmlns:views="using:Volco.App.Views.Hardware"
             x:Class="Volco.App.Views.Hardware.HardwareInspectorHost"
             x:DataType="hw:HardwareViewModel">
  <!-- The Hardware side panel (hardware-page spec §3.2): the device card (§4) at the top, then the
       inspector (§6): the selected tile's or bus's wiring, and an inline question ("Remove Slider 3?")
       at the bottom -->
  <DockPanel>
    <views:DeviceCard Name="Card" DockPanel.Dock="Top" DataContext="{Binding Card}"/>
    <Border Name="ConfirmPanel" DockPanel.Dock="Bottom" Classes="InspectorRows" Margin="16,0,16,16"
            Padding="12" IsVisible="{Binding Confirmation, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="10">
        <TextBlock Name="ConfirmText" TextWrapping="Wrap" Text="{Binding Confirmation.Message, FallbackValue=''}"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Name="CancelConfirmButton" Content="Cancel"
                  Command="{Binding Confirmation.CancelCommand, FallbackValue={x:Null}}"/>
          <!-- Red only for a question that loses something (Remove); the Wi-Fi warning and Load a
               preset use the primary style -->
          <Button Name="ConfirmButton"
                  Classes.Danger="{Binding Confirmation.IsDestructive, FallbackValue=False}"
                  Classes.Primary="{Binding !Confirmation.IsDestructive, FallbackValue=False}"
                  Content="{Binding Confirmation.ConfirmLabel, FallbackValue=''}"
                  Command="{Binding Confirmation.ConfirmCommand, FallbackValue={x:Null}}"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- Hidden while a hardware test runs (spec §8): editing is paused -->
    <ContentControl Name="InspectedContent" Content="{Binding Inspected}" IsVisible="{Binding !IsTesting}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="{x:Type hw:SliderWiringViewModel}" x:DataType="hw:SliderWiringViewModel">
          <views:SliderWiringInspector/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type hw:ButtonWiringViewModel}" x:DataType="hw:ButtonWiringViewModel">
          <views:ButtonWiringInspector/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type hw:BusWiringViewModel}" x:DataType="hw:BusWiringViewModel">
          <views:BusInspector/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type hw:ControllerSettingsViewModel}" x:DataType="hw:ControllerSettingsViewModel">
          <views:ControllerSettingsInspector/>
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </DockPanel>
</UserControl>
