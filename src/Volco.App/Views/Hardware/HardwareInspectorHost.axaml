<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             xmlns:views="using:Volco.App.Views.Hardware"
             xmlns:ctl="using:Volco.Core.Controller"
             x:Class="Volco.App.Views.Hardware.HardwareInspectorHost"
             x:DataType="hw:HardwareViewModel">
  <!-- The controller's part of the side panel (hardware-page spec §3.2): the status menu's preset
       chooser (controller-page spec §5) and Controller settings
       (or a bus) when selected. A selected tile's inspector, with its Hardware section, sits under
       it, and an inline question ("Remove Slider 3?") at the bottom of the side panel
       (InlineConfirmation, StagePage, controller-page spec §4.3). -->
  <DockPanel>
    <!-- The status menu's Load a preset…: a small chooser; the draft's wiring is replaced (asked first when it has controls) -->
    <Border Name="PresetChooser" DockPanel.Dock="Top" Classes="InspectorRows" Margin="16,16,16,0" Padding="12"
            DataContext="{Binding Status}" x:DataType="hw:ControllerStatusViewModel" IsVisible="{Binding IsPresetChooserOpen}">
      <StackPanel Spacing="4">
        <TextBlock Name="PresetChooserTitle" Classes="InspectorHeading" Text="Load a preset"/>
        <ItemsControl Name="PresetList" ItemsSource="{Binding Presets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ctl:ControllerPreset">
              <Button Name="PresetButton" Classes="InspectorRow" Content="{Binding DisplayName}"
                      Command="{Binding $parent[ItemsControl].((hw:ControllerStatusViewModel)DataContext).ChoosePresetCommand, FallbackValue={x:Null}}"
                      CommandParameter="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Name="ClosePresetsButton" HorizontalAlignment="Right" Content="Cancel"
                Command="{Binding ClosePresetChooserCommand}"/>
      </StackPanel>
    </Border>
    <!-- Hidden while a hardware test runs (spec §8): editing is paused -->
    <ContentControl Name="InspectedContent" Content="{Binding InspectedPanel}" IsVisible="{Binding !IsTesting}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="{x:Type hw:ControllerSettingsViewModel}" x:DataType="hw:ControllerSettingsViewModel">
          <views:ControllerSettingsInspector/>
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </DockPanel>
</UserControl>
