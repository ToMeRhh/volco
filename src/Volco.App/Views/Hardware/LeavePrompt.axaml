<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             x:Class="Volco.App.Views.Hardware.LeavePrompt"
             x:DataType="hw:LeavePromptViewModel">
  <!-- Leaving Hardware with unsaved changes (hardware-page spec §3.3): Save and continue waits for
       the controller's confirmation, with the progress here -->
  <StackPanel Spacing="14" Margin="16,12,16,16">
    <TextBlock Name="LeaveTitle" Classes="DialogTitle" Text="{Binding Title}"/>
    <TextBlock Name="LeaveProgress" Classes="Secondary" Text="{Binding ProgressText}"
               IsVisible="{Binding IsSaving}"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Name="StayButton" Content="Stay" Command="{Binding StayCommand}"/>
      <Button Name="DiscardAndContinueButton" Content="Discard and continue" Command="{Binding DiscardAndContinueCommand}"/>
      <Button Name="SaveAndContinueButton" Classes="Primary" Content="Save and continue"
              Command="{Binding SaveAndContinueCommand}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
