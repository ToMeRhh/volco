<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             xmlns:views="using:Volco.App.Views.Hardware"
             x:Class="Volco.App.Views.Hardware.CompareDialog"
             x:DataType="hw:CompareViewModel">
  <!-- Compare (hardware-page spec §7.2): the controller's setup and Volco's copy side by side, each
       a small picture and only the lines that differ, with a button under each -->
  <StackPanel Spacing="14" Margin="16,12,16,16">
    <TextBlock Name="CompareTitle" Classes="DialogTitle" Text="{Binding Title}"/>

    <TextBlock Name="CompareReading" Classes="Secondary" Text="Reading the controller's setup…"
               IsVisible="{Binding IsReading}"/>
    <StackPanel Name="CompareError" Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasError}">
      <TextBlock Name="CompareErrorText" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"
                 Text="{Binding Error}"/>
      <Button Name="CompareRetryButton" Content="Retry" Command="{Binding RetryCommand}"/>
    </StackPanel>

    <Grid Name="CompareColumns" ColumnDefinitions="*,24,*" IsVisible="{Binding HasComparison}">
      <StackPanel Spacing="10">
        <TextBlock Classes="Subtitle" Text="On the controller"/>
        <views:MiniDrawing Name="ControllerPicture" Config="{Binding ControllerPicture}" HorizontalAlignment="Left"
                           Stroke="{DynamicResource TextSecondaryBrush}"/>
        <ItemsControl Name="ControllerLines" ItemsSource="{Binding ControllerLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock TextWrapping="Wrap" Text="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Name="KeepButton" Classes="Primary" Content="Keep the controller's setup" Command="{Binding KeepCommand}"/>
        <TextBlock Classes="Caption" Text="The controller is untouched."/>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="10">
        <TextBlock Classes="Subtitle" Text="Volco's copy"/>
        <views:MiniDrawing Name="VolcoPicture" Config="{Binding VolcoPicture}" HorizontalAlignment="Left"
                           Stroke="{DynamicResource TextSecondaryBrush}"/>
        <ItemsControl Name="VolcoLines" ItemsSource="{Binding VolcoLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock TextWrapping="Wrap" Text="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Name="SendButton" Content="Send Volco's copy" Command="{Binding SendCommand}"/>
        <TextBlock Classes="Caption" Text="The controller restarts with it."/>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
