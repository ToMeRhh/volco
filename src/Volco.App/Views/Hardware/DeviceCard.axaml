<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             xmlns:conv="using:Volco.App.Converters"
             x:Class="Volco.App.Views.Hardware.DeviceCard"
             x:DataType="hw:DeviceCardViewModel">
  <UserControl.Resources>
    <conv:LinkToneToBrushConverter x:Key="ToneToBrush"/>
  </UserControl.Resources>
  <!-- The device card in the sidebar (controller-page spec §5, hardware-page spec §4): the name,
       one status line with its dot (the › opens the Connection dialog), one detail line, at most
       one primary button, and the ⋯ menu. It fits the 148 px sidebar; the compact (56 px) sidebar
       shows only the dot (CardDot), and the full card while the sidebar opens over the page. -->
  <Panel>
    <Ellipse Name="CardDot" Classes="CardDot" Width="8" Height="8" Margin="0,8" HorizontalAlignment="Center"
             Fill="{Binding State.Tone, Converter={StaticResource ToneToBrush}}"
             ToolTip.Tip="{Binding State.Status}" AutomationProperties.Name="{Binding State.Status}"/>
    <Border Name="CardBorder" Classes="InspectorRows SidebarCard" Padding="10">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Name="CardName" Classes="InspectorHeading" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Text="{Binding Name}"/>
          <Button Name="MoreButton" Grid.Column="1" Classes="Icon" Margin="0,-4,-6,-4" ToolTip.Tip="More">
            <PathIcon Data="{StaticResource Icon.More}" Width="14" Height="14"/>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Name="ConnectionMenuItem" Header="Connection…" Command="{Binding OpenConnectionCommand}"/>
                <MenuItem Name="ReconnectMenuItem" Header="Reconnect" Command="{Binding ReconnectCommand}"/>
                <MenuItem Name="DisconnectMenuItem" Header="Disconnect" Command="{Binding DisconnectCommand}"/>
                <Separator/>
                <MenuItem Name="CheckFirmwareMenuItem" Header="Check firmware" Command="{Binding CheckFirmwareCommand}"/>
                <MenuItem Name="ReinstallMenuItem" Header="Reinstall firmware…" Foreground="{DynamicResource DangerBrush}"
                          Command="{Binding ReinstallFirmwareCommand}"/>
                <Separator/>
                <MenuItem Name="LoadPresetMenuItem" Header="Load a preset…" Command="{Binding LoadPresetCommand}"/>
                <MenuItem Name="StartOverMenuItem" Header="Start over…" Command="{Binding StartOverCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>

        <Button Name="StatusButton" Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Command="{Binding OpenConnectionCommand}" IsHitTestVisible="{Binding State.StatusOpensConnection}"
                Focusable="{Binding State.StatusOpensConnection}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Ellipse Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                     Fill="{Binding State.Tone, Converter={StaticResource ToneToBrush}}"/>
            <TextBlock Name="StatusText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="{Binding State.Status}"/>
            <PathIcon Name="StatusChevron" Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Width="10" Height="10"
                      Margin="4,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                      IsVisible="{Binding State.StatusOpensConnection}"/>
          </Grid>
        </Button>

        <ProgressBar Name="CardProgress" Minimum="0" Maximum="1" Height="4" MinHeight="4" MinWidth="0"
                     Value="{Binding State.Progress, TargetNullValue=0, FallbackValue=0}" IsVisible="{Binding HasProgress}"/>

        <!-- A not-set-up state's detail ("Choose how to start.") goes to the chooser on the Controller page -->
        <Button Name="DetailButton" Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Command="{Binding OpenChooserCommand}" IsVisible="{Binding HasDetail}"
                IsHitTestVisible="{Binding DetailOpensChooser}" Focusable="{Binding DetailOpensChooser}">
          <TextBlock Name="DetailText" Classes="Secondary" TextWrapping="Wrap"
                     Classes.Link="{Binding DetailOpensChooser}" Text="{Binding State.Detail}"/>
        </Button>

        <Button Name="ActionButton" Classes="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsVisible="{Binding HasAction}">
          <Button.ContentTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
            </DataTemplate>
          </Button.ContentTemplate>
        </Button>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
