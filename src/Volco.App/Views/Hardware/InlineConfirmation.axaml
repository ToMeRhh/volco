<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             x:Class="Volco.App.Views.Hardware.InlineConfirmation"
             x:DataType="hw:HardwareViewModel">
  <!-- The draft's inline question ("Remove Slider 3?", hardware-page spec §6.5) at the bottom of
       the side panel, near the Remove that asked, under the selected tile's inspector or
       Controller settings (controller-page spec §4.3) -->
  <Border Name="ConfirmPanel" Classes="InspectorRows" Margin="16,16,16,16"
          Padding="12" IsVisible="{Binding Confirmation, Converter={x:Static ObjectConverters.IsNotNull}}">
    <StackPanel Spacing="10">
      <TextBlock Name="ConfirmText" TextWrapping="Wrap" Text="{Binding Confirmation.Message, FallbackValue=''}"/>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Name="CancelConfirmButton" Content="Cancel"
                Command="{Binding Confirmation.CancelCommand, FallbackValue={x:Null}}"/>
        <!-- Red only for a question that loses something (Remove); the Wi-Fi warning and Load a
             preset use the primary style -->
        <Button Name="ConfirmButton"
                Classes.Danger="{Binding Confirmation.IsDestructive, FallbackValue=False}"
                Classes.Primary="{Binding !Confirmation.IsDestructive, FallbackValue=False}"
                Content="{Binding Confirmation.ConfirmLabel, FallbackValue=''}"
                Command="{Binding Confirmation.ConfirmCommand, FallbackValue={x:Null}}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
