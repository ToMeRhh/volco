<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             x:Class="Volco.App.Views.Hardware.CalibrationDialog"
             x:DataType="hw:CalibrationDialogViewModel">
  <!-- Re-calibrate (slider-calibration spec, "The sweep"): a bar of 0-4095 with the range the
       controller has learned so far and its two ends; Done once the span is learned, Cancel -->
  <StackPanel Spacing="14" Margin="16,12,16,16">
    <TextBlock Name="CalibrationTitle" Classes="DialogTitle" Text="{Binding Title}"/>
    <TextBlock Name="CalibrationInstruction" TextWrapping="Wrap" Text="{Binding Instruction}"/>

    <StackPanel Spacing="6">
      <Border Name="CalibrationTrack" Height="10" CornerRadius="5" ClipToBounds="True"
              Background="{DynamicResource SubtleBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border Name="CalibrationFill" HorizontalAlignment="Left" Width="0"
                Background="{DynamicResource AccentBrush}" IsVisible="{Binding HasRange}"/>
      </Border>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Name="CalibrationLow" Classes="Caption" Text="{Binding LowText}"/>
        <TextBlock Name="CalibrationHigh" Grid.Column="2" Classes="Caption" Text="{Binding HighText}"/>
      </Grid>
    </StackPanel>

    <TextBlock Name="CalibrationKeepMoving" Classes="Secondary" TextWrapping="Wrap" Text="{Binding KeepMovingText}"
               IsVisible="{Binding !IsLearned}"/>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Name="CalibrationCancelButton" Content="Cancel" Command="{Binding CancelCommand}"/>
      <Button Name="CalibrationDoneButton" Classes="Primary" Content="Done" Command="{Binding DoneCommand}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
