<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             xmlns:controls="using:Volco.App.Controls"
             x:Class="Volco.App.Views.Hardware.SliderWiringInspector"
             x:DataType="hw:SliderWiringViewModel">
  <!-- The body of a slider's Hardware section (controller-page spec §4.3, hardware-page spec §6.1):
       its pin, Auto-calibrate and its calibration with Re-calibrate (slider-calibration spec), then
       Remove Slider N -->
  <StackPanel Classes="WiringBody">
    <Border Classes="InspectorRows">
      <controls:CardRows Name="Rows">
        <controls:PinField Name="PinField" DataContext="{Binding Pin}"/>

        <!-- A draft field: until saved, the caption says that saving forgets the calibration -->
        <Grid Name="AutoCalibrateRow" Classes="InspectorRow" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <Grid Classes="HelpLabel" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <controls:HelpTip Name="AutoCalibrateHelp"
                              Text="Some sliders never reach their ends' readings, so the volume never gets to 0 or 100%. With this on, the controller learns where this slider's travel really ends, all the time, and stretches the reading between those ends; it only ever widens what it learned. Off, it learns only during Re-calibrate."/>
            <TextBlock Name="AutoCalibrateLabel" Grid.Column="1" Classes="RowLabel" Text="Auto-calibrate"/>
            <TextBlock Name="AutoCalibrateNote" Grid.Column="1" Grid.Row="1" Classes="Caption" FontSize="11" TextTrimming="CharacterEllipsis"
                       Text="{Binding AutoCalibrateNote}" ToolTip.Tip="{Binding AutoCalibrateNote}"
                       IsVisible="{Binding AutoCalibrateNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <ToggleSwitch Name="AutoCalibrateToggle" Grid.Column="1" OnContent="" OffContent=""
                        IsChecked="{Binding AutoCalibrate, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"/>
        </Grid>

        <!-- What the controller reports, and the sweep -->
        <Grid Name="CalibrationRow" Classes="InspectorRow" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Name="CalibrationText" Classes="RowLabel" TextWrapping="NoWrap" MaxLines="1"
                     TextTrimming="CharacterEllipsis" Text="{Binding CalibrationText}" ToolTip.Tip="{Binding CalibrationText}"/>
          <!-- A disabled button gets no tooltip, so the tooltip is on a panel around it -->
          <Panel Grid.Column="1" VerticalAlignment="Center" Background="Transparent"
                 ToolTip.Tip="{Binding RecalibrateTooltip}" ToolTip.ShowOnDisabled="True">
            <Button Name="RecalibrateButton" Content="Re-calibrate" Command="{Binding RecalibrateCommand}"/>
          </Panel>
        </Grid>
      </controls:CardRows>
    </Border>
    <Button Name="HardwareRemoveButton" Classes="Danger" HorizontalAlignment="Left"
            Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" IsEnabled="{Binding IsEditable}"/>
  </StackPanel>
</UserControl>
