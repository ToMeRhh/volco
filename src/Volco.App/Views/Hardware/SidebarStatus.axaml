<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             xmlns:conv="using:Volco.App.Converters"
             x:Class="Volco.App.Views.Hardware.SidebarStatus"
             x:DataType="hw:ControllerStatusViewModel">
  <UserControl.Resources>
    <conv:LinkToneToBrushConverter x:Key="ToneToBrush"/>
  </UserControl.Resources>
  <!-- The controller's status at the bottom of the sidebar (controller-page spec §5): a dot and one
       short line ("Connected", "Connecting…", or what needs the user), with the whole line as the
       tooltip, and under it the connected controller's hardware ("ESP32 · 5 sliders, 4 buttons"); a click opens the menu of the rare actions (hardware-page spec §4.2). The compact
       (56 px) sidebar shows only the dot, and the whole line while the sidebar opens over the page. -->
  <Button Name="StatusLineButton" Classes="SidebarStatus" HorizontalAlignment="Stretch"
          ToolTip.Tip="{Binding FullText}" AutomationProperties.Name="{Binding FullText}">
    <Grid ColumnDefinitions="Auto,*">
      <!-- The dot sits beside the status's first line; the controller's hardware is under it -->
      <Ellipse Name="StatusDot" Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0"
               Fill="{Binding State.Tone, Converter={StaticResource ToneToBrush}}"/>
      <StackPanel Grid.Column="1" Classes="SidebarStatusText" Margin="10,0,0,0" Spacing="1">
        <TextBlock Name="StatusText" TextTrimming="CharacterEllipsis" MaxLines="1"
                   Text="{Binding ShortText}"/>
        <!-- Wraps rather than ending in "…" (its spaces are no-break but the one after the comma
             and the one after the chip) -->
        <TextBlock Name="HardwareText" Classes="Caption" TextWrapping="Wrap"
                   Text="{Binding HardwareText}"
                   IsVisible="{Binding HardwareText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
    </Grid>
    <Button.Flyout>
      <MenuFlyout Placement="TopEdgeAlignedLeft">
        <MenuItem Name="ConnectionMenuItem" Header="Connection…" Command="{Binding OpenConnectionCommand}"/>
        <MenuItem Name="ReconnectMenuItem" Header="Reconnect" Command="{Binding ReconnectCommand}"/>
        <MenuItem Name="DisconnectMenuItem" Header="Disconnect" Command="{Binding DisconnectCommand}"/>
        <Separator/>
        <MenuItem Name="CheckFirmwareMenuItem" Header="Check firmware" Command="{Binding CheckFirmwareCommand}"/>
        <MenuItem Name="ReinstallMenuItem" Header="Reinstall firmware…" Foreground="{DynamicResource DangerBrush}"
                  Command="{Binding ReinstallFirmwareCommand}"/>
        <Separator/>
        <MenuItem Name="LoadPresetMenuItem" Header="Load a preset…" Command="{Binding LoadPresetCommand}"/>
        <MenuItem Name="StartOverMenuItem" Header="Start over…" Command="{Binding StartOverCommand}"/>
      </MenuFlyout>
    </Button.Flyout>
  </Button>
</UserControl>
