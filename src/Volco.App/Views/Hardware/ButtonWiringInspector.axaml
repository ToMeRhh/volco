<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hw="using:Volco.App.ViewModels.Hardware"
             xmlns:controls="using:Volco.App.Controls"
             x:Class="Volco.App.Views.Hardware.ButtonWiringInspector"
             x:DataType="hw:ButtonWiringViewModel">
  <!-- A button's wiring (hardware-page spec §6.2): its main action, then one row each for its pin
       and its light (the choice reshapes only the rows under it), and Remove at the bottom -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Classes="InspectorHeader" Spacing="2">
      <TextBlock Name="HeadingText" Classes="InspectorHeading" Text="{Binding Title}"/>
      <TextBlock Name="SubtitleText" Classes="Secondary" TextWrapping="Wrap" Text="{Binding Subtitle}"/>
    </StackPanel>
    <Button Name="RemoveButton" DockPanel.Dock="Bottom" Classes="Danger" Margin="16,8,16,16"
            Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" IsEnabled="{Binding IsEditable}"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="InspectorBody">
        <Border Classes="InspectorRows">
          <StackPanel Name="Rows">
            <controls:PinField Name="PinField" DataContext="{Binding Pin}"/>

            <Grid Name="LightRow" Classes="InspectorRow" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Name="LightLabel" Classes="RowLabel" Text="Light"/>
              <Border Name="LightSegment" Grid.Column="1" Classes="SegmentTrack" IsEnabled="{Binding IsEditable}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <RadioButton Name="LightNone" Classes="Segment" Content="None" IsChecked="{Binding IsNone, Mode=TwoWay}"/>
                  <RadioButton Name="LightLed" Classes="Segment" Content="LED" IsChecked="{Binding IsLed, Mode=TwoWay}"/>
                  <RadioButton Name="LightPair" Classes="Segment" Content="2 LEDs" IsChecked="{Binding IsPair, Mode=TwoWay}"/>
                  <RadioButton Name="LightScreen" Classes="Segment" Content="Screen" IsChecked="{Binding IsScreen, Mode=TwoWay}"/>
                </StackPanel>
              </Border>
            </Grid>

            <Panel Name="LightPinRow" IsVisible="{Binding IsLed}">
              <controls:PinField Name="LightPinField" DataContext="{Binding LightPin}"/>
            </Panel>
            <Panel Name="LightAPinRow" IsVisible="{Binding IsPair}">
              <controls:PinField Name="LightAPinField" DataContext="{Binding LightAPin}"/>
            </Panel>
            <Panel Name="LightBPinRow" IsVisible="{Binding IsPair}">
              <controls:PinField Name="LightBPinField" DataContext="{Binding LightBPin}"/>
            </Panel>

            <Grid Name="LitRow" Classes="InspectorRow" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding HasLeds}">
              <TextBlock Name="LitLabel" Classes="RowLabel" Text="Lit when pin is"/>
              <Border Name="LitSegment" Grid.Column="1" Classes="SegmentTrack" IsEnabled="{Binding IsEditable}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <RadioButton Name="LitHigh" Classes="Segment" Content="High" IsChecked="{Binding LitWhenHigh, Mode=TwoWay}"/>
                  <RadioButton Name="LitLow" Classes="Segment" Content="Low" IsChecked="{Binding LitWhenLow, Mode=TwoWay}"/>
                </StackPanel>
              </Border>
            </Grid>

            <Grid Name="BusRow" Classes="InspectorRow" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsScreen}">
              <TextBlock Name="BusLabel" Classes="RowLabel" Text="Bus"/>
              <ComboBox Name="BusBox" Grid.Column="1" Classes="RowControl"
                        ItemsSource="{x:Static hw:ButtonWiringViewModel.BusChoices}"
                        SelectedIndex="{Binding BusIndex, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"/>
            </Grid>
            <Grid Name="AddressRow" Classes="InspectorRow" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsScreen}">
              <TextBlock Name="AddressLabel" Classes="RowLabel" Text="Address"/>
              <ComboBox Name="AddressBox" Grid.Column="1" Classes="RowControl"
                        ItemsSource="{x:Static hw:ButtonWiringViewModel.AddressChoices}"
                        SelectedIndex="{Binding AddressIndex, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
