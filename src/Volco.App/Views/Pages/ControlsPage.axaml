<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Volco.App.ViewModels"
             xmlns:controls="using:Volco.App.Controls"
             xmlns:inspector="using:Volco.App.Views.Inspector"
             xmlns:dialogs="using:Volco.App.Views.Dialogs"
             x:Class="Volco.App.Views.Pages.ControlsPage"
             x:DataType="vm:ControlsViewModel">
  <!-- The Controls page (spec docs/design/controls-page.md): the title, a drawing of the
       controller (sliders, then the buttons in the edited mode's frame) and an inspector for the
       selected control. Only the drawing scrolls. -->
  <Panel>
    <Grid ColumnDefinitions="*,Auto">
      <ScrollViewer Name="DrawingScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,8,20,20" Spacing="14">
          <TextBlock Name="PageTitle" Classes="Title" Text="Controls"/>

          <Border Name="Case" Classes="Case" Classes.dense="{Binding IsDense}">
            <StackPanel Spacing="14">
              <ItemsControl Name="SliderList" ItemsSource="{Binding Sliders.Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:FillWrapPanel Name="SliderGrid" Classes="SliderGrid"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SliderItemViewModel">
                    <controls:SliderTile/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- The buttons, framed in the edited mode's colour, with the mode tabs on its top edge
                   (spec §9): a click edits a mode, a right-click opens its menu; the pencil turns on
                   edit mode (drag to reorder, click to rename, × to delete). -->
              <Border Name="ButtonFrame" Classes="ModeFrame"
                      controls:ModeTint.Index="{Binding Buttons.EditingTintIndex}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <ItemsControl Name="ModeTabs" ItemsSource="{Binding Buttons.Modes}"
                                  Classes.editing="{Binding Buttons.IsEditingModes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModeTabViewModel">
                          <RadioButton Name="ModeTab" Classes="ModeTab" GroupName="ControlsModeTabs"
                                       controls:ModeTint.Index="{Binding TintIndex}"
                                       IsChecked="{Binding IsEditing, Mode=OneWay}"
                                       Command="{Binding SelectCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Ellipse Name="LiveDot" Classes="LiveDot" IsVisible="{Binding IsLive}"
                                       ToolTip.Tip="Live on the controller"/>
                              <TextBlock Name="TabName" Text="{Binding Name}" IsVisible="{Binding ShowName}"
                                         VerticalAlignment="Center"/>
                              <TextBox Name="TabNameBox" Classes="TabNameBox" IsVisible="{Binding IsRenaming}"/>
                              <TextBlock Name="StartLabel" Classes="StartLabel" Text="start"
                                         IsVisible="{Binding ShowStartLabel}"/>
                              <Button Name="DeleteTabButton" Classes="DeleteTab" Command="{Binding DeleteCommand}"
                                      IsVisible="{Binding ShowDelete}" ToolTip.Tip="Delete mode">
                                <PathIcon Data="{StaticResource Icon.Close}" Width="8" Height="8"/>
                              </Button>
                            </StackPanel>
                          </RadioButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                      <FlyoutBase.AttachedFlyout>
                        <!-- The mode's menu (spec §9.2); the code-behind fills it when it opens -->
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel Name="ModeMenuPanel" Spacing="6" Width="200">
                            <TextBox Name="MenuNameBox"/>
                            <Button Name="MenuMakeLive" Classes="MenuItem" Content="Make live"/>
                            <Button Name="MenuCopyFrom" Classes="MenuItem">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Copy actions from"/>
                                <PathIcon Grid.Column="1" Data="{StaticResource Icon.ChevronRight}" Width="10" Height="10"/>
                              </Grid>
                              <Button.Flyout>
                                <MenuFlyout Placement="RightEdgeAlignedTop"/>
                              </Button.Flyout>
                            </Button>
                          </StackPanel>
                        </Flyout>
                      </FlyoutBase.AttachedFlyout>
                    </ItemsControl>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                      <Button Name="MakeLiveButton" Classes="ModeAction Live" Content="Make live"
                              Command="{Binding Buttons.MakeLiveCommand}" IsVisible="{Binding !Buttons.IsEditingLive}"
                              ToolTip.Tip="{Binding Buttons.MakeLiveText}"/>
                      <Button Name="AddModeButton" Classes="ModeAction" Command="{Binding Buttons.AddModeCommand}"
                              ToolTip.Tip="Add an empty mode">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <PathIcon Data="{StaticResource Icon.Plus}" Width="10" Height="10"/>
                          <TextBlock Text="Add mode"/>
                        </StackPanel>
                      </Button>
                      <Button Name="EditModesButton" Classes="ModeAction EditModes"
                              Classes.editing="{Binding Buttons.IsEditingModes}"
                              Command="{Binding Buttons.ToggleEditModesCommand}">
                        <Panel>
                          <PathIcon Name="PencilIcon" Data="{StaticResource Icon.Pencil}" Width="12" Height="12"
                                    IsVisible="{Binding !Buttons.IsEditingModes}"/>
                          <PathIcon Name="CheckIcon" Data="{StaticResource Icon.Check}" Width="12" Height="12"
                                    IsVisible="{Binding Buttons.IsEditingModes}"/>
                        </Panel>
                      </Button>
                    </StackPanel>
                  </Grid>

                  <ItemsControl Name="ButtonList" ItemsSource="{Binding Buttons.Items}" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:FillWrapPanel Name="ButtonGrid" Classes="ButtonGrid"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ButtonItemViewModel">
                        <controls:ButtonTile/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Name="ConnectLineText" Classes="Secondary" TextWrapping="Wrap"
                     Text="{Binding ConnectLine}" IsVisible="{Binding ShowConnectLine}"/>
        </StackPanel>
      </ScrollViewer>

      <!-- The inspector keeps its place and size; only its body scrolls -->
      <Border Name="Inspector" Grid.Column="1" Classes="Inspector">
        <ContentControl Name="InspectorContent" Content="{Binding Selected}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type vm:SliderItemViewModel}" x:DataType="vm:SliderItemViewModel">
              <inspector:SliderInspector/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ButtonItemViewModel}" x:DataType="vm:ButtonItemViewModel">
              <inspector:ButtonInspector/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>
    </Grid>

    <!-- The page's dialogs: a modal card over the page; Escape or a click outside closes it, and
         Tab stays inside it -->
    <Border Name="DialogOverlay" Background="#66000000" IsVisible="{Binding HasDialog}">
      <Border Name="DialogCard" Classes="Panel DialogCard" KeyboardNavigation.TabNavigation="Cycle">
        <ContentControl Name="DialogHost" Content="{Binding Dialog}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type vm:ActionDialogViewModel}" x:DataType="vm:ActionDialogViewModel">
              <dialogs:ActionDialog/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TargetDialogViewModel}" x:DataType="vm:TargetDialogViewModel">
              <dialogs:TargetDialog/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>
    </Border>

    <!-- The device dialog, over the dialog that opened it, with its own scrim: Escape or a click
         on that scrim closes only this one -->
    <Border Name="DeviceOverlay" Background="#33000000" IsVisible="{Binding HasDeviceDialog}">
      <Border Name="DeviceCard" Classes="Panel DialogCard Small" KeyboardNavigation.TabNavigation="Cycle">
        <ContentControl Name="DeviceHost" Content="{Binding DeviceDialog}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type vm:DeviceDialogViewModel}" x:DataType="vm:DeviceDialogViewModel">
              <dialogs:DeviceDialog/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>
    </Border>
  </Panel>
</UserControl>
