<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Volco.App.ViewModels"
             xmlns:controls="using:Volco.App.Controls"
             xmlns:conv="using:Volco.App.Converters"
             x:Class="Volco.App.Views.Pages.ButtonsPage"
             x:DataType="vm:ButtonsViewModel">
  <UserControl.Resources>
    <conv:IntToDecimalConverter x:Key="IntToDecimal"/>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource PagePadding}"
                Spacing="{StaticResource SpaceL}"
                MaxWidth="{StaticResource PageMaxWidth}">

      <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <StackPanel Spacing="2">
          <TextBlock Text="Buttons" Classes="Title"/>
          <TextBlock Classes="Secondary" TextWrapping="Wrap"
                     Text="What each button does when you press it, double-press it, or hold it, in the order the controller numbers them."/>
        </StackPanel>
        <Button Name="AddButton" Grid.Column="1" Classes="Primary" Margin="16,0,0,0"
                VerticalAlignment="Bottom" Command="{Binding AddCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.Plus}" Width="12" Height="12"/>
            <TextBlock Text="Add button"/>
          </StackPanel>
        </Button>
      </Grid>

      <Border Name="CountHintPanel" Classes="Panel" Padding="12,8" IsVisible="{Binding HasCountHint}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Name="CountHintText" Classes="Secondary" TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="{Binding CountHint}"/>
          <Button Name="AddMissingButton" Grid.Column="1" Margin="12,0,0,0" Content="{Binding AddMissingText}"
                  Command="{Binding AddMissingCommand}" IsVisible="{Binding CanAddMissing}"/>
        </Grid>
      </Border>

      <!-- Presets: one tab per preset; the edited preset's tab holds its buttons, in its colour -->
      <StackPanel Name="PresetBar">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10" IsVisible="{Binding !HasMultiplePresets}">
          <TextBlock Classes="Caption" VerticalAlignment="Center"
                     Text="Presets let one button change what the other buttons do."/>
          <Button Name="AddFirstPresetButton" Classes="Ghost" Command="{Binding AddPresetCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Data="{StaticResource Icon.Plus}" Width="10" Height="10"/>
              <TextBlock Text="Add preset"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- The tabs overlap the frame's top edge by a pixel, so the checked one joins it; too many
             for one line wrap onto more. -->
        <Grid Name="PresetTabStrip" ColumnDefinitions="*,Auto" ZIndex="1" Margin="0,0,0,-1"
              IsVisible="{Binding HasMultiplePresets}">
          <ItemsControl Name="PresetTabs" ItemsSource="{Binding Presets}" VerticalAlignment="Bottom">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PresetTabViewModel">
                <RadioButton Name="PresetTab" Classes="PresetTab"
                             controls:PresetTint.Index="{Binding TintIndex}"
                             IsChecked="{Binding IsEditing, Mode=OneWay}"
                             Command="{Binding SelectCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Name="LiveDot" Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsLive}"
                             ToolTip.Tip="Live on the controller"/>
                    <TextBlock Text="{Binding Name}"/>
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Name="AddPresetButton" Grid.Column="1" Classes="Ghost" Margin="6,0,0,4" VerticalAlignment="Bottom"
                  Command="{Binding AddPresetCommand}" ToolTip.Tip="Add a preset that starts as a copy of this one">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Data="{StaticResource Icon.Plus}" Width="10" Height="10"/>
              <TextBlock Text="Add preset"/>
            </StackPanel>
          </Button>
        </Grid>

        <Border Name="PresetBody" Classes="PresetBody" Classes.framed="{Binding HasMultiplePresets}"
                controls:PresetTint.Index="{Binding EditingTintIndex}">
          <StackPanel Spacing="12">
            <!-- A wrap, not a grid: when narrow, the buttons go under the text rather than
                 squeezing it to a letter per line. -->
            <WrapPanel Name="Banner" Margin="4,0,0,0" IsVisible="{Binding HasMultiplePresets}">
              <DockPanel Margin="0,4,16,4" VerticalAlignment="Center">
                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsEditingLive}"/>
                <TextBlock Name="BannerText" Classes="Secondary" TextWrapping="Wrap"
                           VerticalAlignment="Center" Text="{Binding BannerText}"/>
              </DockPanel>
              <Button Name="MakeLiveButton" Margin="0,0,8,0"
                      Content="{Binding MakeLiveText}" Command="{Binding MakeLiveCommand}"
                      IsVisible="{Binding !IsEditingLive}"/>
              <Button Name="RenamePresetButton" Classes="Ghost" Margin="0,0,8,0" Content="Rename"
                      Command="{Binding StartRenameCommand}" IsVisible="{Binding !IsRenaming}"/>
              <TextBox Name="PresetNameBox" Width="180" Margin="0,0,8,0" IsVisible="{Binding IsRenaming}"
                       Text="{Binding RenameText, Mode=TwoWay}"/>
              <Button Name="DeletePresetButton" Classes="Ghost Danger" Content="Delete"
                      Command="{Binding DeletePresetCommand}"/>
            </WrapPanel>

            <!-- Button cards -->
            <ItemsControl Name="ButtonList" ItemsSource="{Binding Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ButtonItemViewModel">
                  <Border Name="Card" Classes="Card"
                          Classes.unset="{Binding IsNotSetUp}"
                          Classes.active="{Binding IsActive}">
                    <Panel>
                      <StackPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="4,8,8,8">
                          <Border Name="Grip" Classes="Grip" Grid.Column="0" VerticalAlignment="Center"
                                  ToolTip.Tip="Drag to move these actions to another button (Alt+Up / Alt+Down)">
                            <PathIcon Data="{StaticResource Icon.Grip}" Width="12" Height="12"
                                      Foreground="{DynamicResource TextTertiaryBrush}"/>
                          </Border>
                          <Button Name="ExpandButton" Grid.Column="1" Classes="CardHeader"
                                  Command="{Binding ToggleExpandedCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <TextBlock Name="TitleText" Classes="Subtitle CardTitleText"
                                         Text="{Binding Title}" VerticalAlignment="Center"/>
                              <TextBlock Name="SummaryText" Classes="Secondary" Text="{Binding Summary}"
                                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>

                          <!-- What the controller's light shows for this button right now -->
                          <Panel Name="LightPreview" Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding LightDescription}">
                            <Ellipse Name="Led" Classes="Led" Classes.on="{Binding LedOn}" IsVisible="{Binding IsLed}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsLedPair}">
                              <TextBlock Text="A" Classes="Caption" VerticalAlignment="Center"/>
                              <Ellipse Name="LedA" Classes="Led" Classes.on="{Binding LedA}"/>
                              <Ellipse Name="LedB" Classes="Led" Classes.on="{Binding LedB}"/>
                              <TextBlock Text="B" Classes="Caption" VerticalAlignment="Center"/>
                            </StackPanel>
                            <controls:ScreenPreview Name="ScreenPreviewSmall" Scale="1" Screen="{Binding Screen}"
                                                    IsVisible="{Binding IsScreen}"/>
                          </Panel>

                          <Button Name="MenuButton" Grid.Column="3" Classes="Icon" ToolTip.Tip="More options">
                            <PathIcon Data="{StaticResource Icon.More}" Width="14" Height="14"/>
                            <Button.Flyout>
                              <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Name="MoveUpItem" Header="Move up" Command="{Binding MoveUpCommand}"/>
                                <MenuItem Name="MoveDownItem" Header="Move down" Command="{Binding MoveDownCommand}"/>
                                <Separator/>
                                <MenuItem Name="ResetItem" Header="Reset" Command="{Binding ResetCommand}"/>
                                <MenuItem Name="RemoveLastItem" Header="Remove last button"
                                          Command="{Binding RemoveLastCommand}" IsVisible="{Binding IsLast}"/>
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                          <Button Grid.Column="4" Classes="Icon" Focusable="False"
                                  Command="{Binding ToggleExpandedCommand}">
                            <Panel>
                              <PathIcon Data="{StaticResource Icon.ChevronRight}" Width="12" Height="12"
                                        IsVisible="{Binding !IsExpanded}"/>
                              <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12"
                                        IsVisible="{Binding IsExpanded}"/>
                            </Panel>
                          </Button>
                        </Grid>

                        <Border Name="Body" Classes="CardBody" IsVisible="{Binding IsExpanded}">
                          <StackPanel Spacing="12">
                            <controls:ActionRow Name="PressRow" DataContext="{Binding Press}"/>
                            <controls:ActionRow Name="DoubleRow" DataContext="{Binding DoublePress}"/>
                            <controls:ActionRow Name="HoldRow" DataContext="{Binding Hold}"/>

                            <Border Name="LightLine" Background="{DynamicResource SubtleBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" Padding="12,8">
                              <StackPanel Spacing="8">
                                <TextBlock Name="IndicatorText" Classes="Secondary" FontWeight="SemiBold" Text="{Binding IndicatorText}"/>
                                <TextBlock Name="LightDescriptionText" Classes="Secondary" TextWrapping="Wrap"
                                           Text="{Binding LightDescription}" IsVisible="{Binding ShowLightDescription}"/>
                                <controls:ScreenPreview Name="ScreenPreviewLarge" Scale="2" Screen="{Binding Screen}"
                                                        IsVisible="{Binding IsScreen}"/>
                              </StackPanel>
                            </Border>

                            <ToggleButton Name="AdvancedToggle" Classes="Advanced"
                                          IsChecked="{Binding IsAdvancedOpen, Mode=TwoWay}">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Advanced"/>
                                <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="10" Height="10"/>
                              </StackPanel>
                            </ToggleButton>

                            <Border Name="AdvancedSection" Classes="Indent" IsVisible="{Binding IsAdvancedOpen}">
                              <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="150,Auto,Auto">
                                  <TextBlock Text="Hold after" Classes="Secondary" VerticalAlignment="Center"/>
                                  <NumericUpDown Name="LongPressBox" Grid.Column="1" Width="140"
                                                 Minimum="200" Maximum="2000" Increment="50" FormatString="0"
                                                 Value="{Binding LongPressMs, Mode=TwoWay, Converter={StaticResource IntToDecimal}}"/>
                                  <TextBlock Grid.Column="2" Text="ms" Classes="Caption" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="150,Auto,Auto">
                                  <TextBlock Text="Double-press window" Classes="Secondary" VerticalAlignment="Center"/>
                                  <NumericUpDown Name="DoublePressBox" Grid.Column="1" Width="140"
                                                 Minimum="100" Maximum="1000" Increment="50" FormatString="0"
                                                 Value="{Binding DoublePressWindowMs, Mode=TwoWay, Converter={StaticResource IntToDecimal}}"/>
                                  <TextBlock Grid.Column="2" Text="ms" Classes="Caption" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Classes="Caption" Text="Timing and position are shared by every preset."/>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                      <Border Classes="ActiveOutline"/>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
