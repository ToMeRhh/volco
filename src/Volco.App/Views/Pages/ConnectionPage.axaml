<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Volco.App.Converters"
             xmlns:vm="using:Volco.App.ViewModels"
             x:Class="Volco.App.Views.Pages.ConnectionPage"
             x:DataType="vm:ConnectionViewModel">
  <UserControl.Resources>
    <conv:ConnectionStatusToBrushConverter x:Key="StatusToBrush"/>
    <conv:IntToDecimalConverter x:Key="IntToDecimal"/>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource PagePadding}"
                Spacing="{StaticResource SpaceM}"
                MaxWidth="{StaticResource PageMaxWidth}">

      <StackPanel Spacing="2" Margin="0,8,0,4">
        <TextBlock Text="Connection" Classes="Title"/>
        <TextBlock Classes="Secondary" Text="How Volco talks to your controller."/>
      </StackPanel>

      <!-- Status first -->
      <Border Name="StatusPanel" Classes="Panel">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto">
          <Ellipse Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center"
                   Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
          <TextBlock Name="StatusLabel" Grid.Column="1" Classes="Subtitle" Margin="8,0,16,0"
                     VerticalAlignment="Center" Text="{Binding StatusText}"/>
          <TextBlock Name="TransportDetails" Grid.Column="2" Classes="Secondary"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Text="{Binding TransportDetails}"/>
          <Button Name="ReconnectButton" Grid.Column="3" Command="{Binding ReconnectCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.Refresh}" Width="12" Height="12"/>
              <TextBlock Text="Reconnect"/>
            </StackPanel>
          </Button>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="18,6,0,0" Spacing="2">
            <TextBlock Name="HardwareSummaryText" Classes="Caption" Text="{Binding HardwareSummary}"
                       IsVisible="{Binding HasHardwareSummary}"/>
            <TextBlock Name="ControllerErrorText" Classes="Caption" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Text="{Binding ControllerError}" IsVisible="{Binding HasControllerError}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="Panel">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="150,*">
            <TextBlock Text="Connect using" Classes="Secondary" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Classes="SegmentTrack">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton Name="SerialOption" Classes="Segment" Content="USB cable"
                             IsChecked="{Binding IsSerial, Mode=TwoWay}"/>
                <RadioButton Name="UdpOption" Classes="Segment" Content="Wi-Fi (UDP)"
                             IsChecked="{Binding IsUdp, Mode=TwoWay}"/>
                <RadioButton Name="WebSocketOption" Classes="Segment" Content="WebSocket"
                             IsChecked="{Binding IsWebSocket, Mode=TwoWay}"/>
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel Name="SerialSection" Spacing="12" IsVisible="{Binding IsSerial}">
            <Grid ColumnDefinitions="150,Auto,Auto">
              <TextBlock Text="Port" Classes="Secondary" VerticalAlignment="Center"/>
              <ComboBox Name="PortCombo" Grid.Column="1" Width="{StaticResource ComboBoxStandardWidth}"
                        PlaceholderText="Select port…"
                        ItemsSource="{Binding ComPorts}"
                        SelectedItem="{Binding ComPort, Mode=TwoWay}"/>
              <Button Name="RefreshPortsButton" Grid.Column="2" Classes="Icon" Margin="4,0,0,0"
                      Command="{Binding RefreshComPortsCommand}" ToolTip.Tip="Refresh the port list">
                <PathIcon Data="{StaticResource Icon.Refresh}" Width="14" Height="14"/>
              </Button>
            </Grid>
          </StackPanel>

          <StackPanel Name="UdpSection" Spacing="12" IsVisible="{Binding IsUdp}">
            <Grid ColumnDefinitions="150,Auto">
              <TextBlock Text="Listen port" Classes="Secondary" VerticalAlignment="Center"/>
              <NumericUpDown Name="UdpPortBox" Grid.Column="1" Width="160"
                             Minimum="1024" Maximum="65535" FormatString="0"
                             Value="{Binding UdpListenPort, Mode=TwoWay, Converter={StaticResource IntToDecimal}}"/>
            </Grid>
          </StackPanel>

          <StackPanel Name="WebSocketSection" Spacing="12" IsVisible="{Binding IsWebSocket}">
            <Grid ColumnDefinitions="150,Auto">
              <TextBlock Text="Server port" Classes="Secondary" VerticalAlignment="Center"/>
              <NumericUpDown Name="WebSocketPortBox" Grid.Column="1" Width="160"
                             Minimum="1024" Maximum="65535" FormatString="0"
                             Value="{Binding WebSocketPort, Mode=TwoWay, Converter={StaticResource IntToDecimal}}"/>
            </Grid>
          </StackPanel>

          <TextBlock Classes="Caption" Text="These must match the values in your controller's firmware."/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
