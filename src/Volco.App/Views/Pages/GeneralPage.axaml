<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Volco.App.ViewModels"
             x:Class="Volco.App.Views.Pages.GeneralPage"
             x:DataType="vm:GeneralViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource PagePadding}"
                Spacing="{StaticResource SpaceM}"
                MaxWidth="{StaticResource PageMaxWidth}">

      <TextBlock Text="General" Classes="Title" Margin="0,8,0,4"/>

      <Border Name="StartupPanel" Classes="Panel" IsVisible="{Binding ShowStartAtSignIn}">
        <StackPanel Spacing="14">
          <TextBlock Text="Startup" Classes="Subtitle"/>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Start Volco when you sign in"/>
              <TextBlock Classes="Caption" TextWrapping="Wrap"
                         Text="It starts in the tray, without this window. Opening Volco yourself shows the window."/>
            </StackPanel>
            <ToggleSwitch Name="StartAtSignInToggle" Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding StartAtSignIn, Mode=TwoWay}"
                          OnContent="On" OffContent="Off"/>
          </Grid>
          <TextBlock Name="StartAtSignInErrorText" Classes="Caption" TextWrapping="Wrap"
                     Foreground="{DynamicResource DangerBrush}" Text="{Binding StartAtSignInError}"
                     IsVisible="{Binding StartAtSignInError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>
      </Border>

      <!-- The Updates panel goes here on release builds (code-behind). -->
      <ContentControl Name="UpdatesHost"/>

      <!-- Device nicknames and icons (code-behind) -->
      <ContentControl Name="DevicesHost"/>

      <Border Name="TroubleshootingPanel" Classes="Panel">
        <StackPanel Spacing="14">
          <TextBlock Text="Troubleshooting" Classes="Subtitle"/>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Detailed logging"/>
              <TextBlock Classes="Caption" Text="Writes extra detail to the log file."/>
            </StackPanel>
            <ToggleSwitch Name="DebugToggle" Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding DebugLogging, Mode=TwoWay}"
                          OnContent="On" OffContent="Off"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Log file"/>
              <TextBlock Name="LogPathText" Classes="Caption" Text="{Binding LogPath}"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Name="OpenLogFolderButton" Grid.Column="1" VerticalAlignment="Center"
                    Content="Open folder" Command="{Binding OpenLogFolderCommand}"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Name="AboutPanel" Classes="Panel">
        <StackPanel Spacing="14">
          <TextBlock Text="About" Classes="Subtitle"/>
          <StackPanel Spacing="2">
            <TextBlock Name="VersionText" Text="{Binding VersionText}"/>
            <TextBlock Name="BuildDetailsText" Classes="Caption" Text="{Binding BuildDetails}"
                       IsVisible="{Binding BuildDetails, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          </StackPanel>
          <HyperlinkButton Name="RepoLink" Padding="0" NavigateUri="{Binding RepoUri}"
                           Content="Volco on GitHub" ToolTip.Tip="{Binding RepoUri}"/>
          <!-- The controller firmware Volco carries is built from these components (spec 9.3). -->
          <Expander Name="NoticesExpander" Header="Third-party notices (controller firmware)">
            <TextBox Name="NoticesBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="320"
                     FontFamily="Consolas, Menlo, monospace" FontSize="11"/>
          </Expander>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
