<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Volco.App.ViewModels"
             xmlns:ctl="using:Volco.Core.Controller"
             xmlns:controls="using:Volco.App.Controls"
             xmlns:conv="using:Volco.App.Converters"
             x:Class="Volco.App.Views.Pages.ControllerPage"
             x:DataType="vm:ControllerViewModel">
  <UserControl.Resources>
    <conv:IntToDecimalConverter x:Key="IntToDecimal"/>
    <!-- Show the unit, but accept a typed number with or without it -->
    <conv:NumberWithUnitConverter x:Key="Seconds" Unit="s"/>
    <conv:NumberWithUnitConverter x:Key="Milliseconds" Unit="ms"/>
    <conv:NumberWithUnitConverter x:Key="PixelsPerSecond" Unit="px/s"/>
    <conv:NumberWithUnitConverter x:Key="Percent" Unit="%"/>
    <conv:NumberWithUnitConverter x:Key="Kilohertz" Unit="kHz"/>
  </UserControl.Resources>

  <Grid>
  <DockPanel IsEnabled="{Binding !HasDialog}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <!-- The bottom margin keeps the last section clear of the snackbar -->
      <StackPanel Margin="24,8,24,96" Spacing="{StaticResource SpaceM}"
                  MaxWidth="{StaticResource PageMaxWidth}">

        <StackPanel Spacing="2" Margin="0,8,0,4">
          <TextBlock Text="Hardware" Classes="Title"/>
          <TextBlock Classes="Secondary" Text="How Volco talks to your controller, and the hardware and behaviour stored on it."/>
        </StackPanel>

        <!-- 1. Connection: how Volco reaches the controller (saved in Volco, not on the controller) -->
        <Border Name="ConnectionPanel" Classes="Panel">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Connection" Classes="Subtitle" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Name="ReconnectButton" Command="{Binding Connection.ReconnectCommand}"
                        IsVisible="{Binding !Connection.IsUserDisconnected}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.Refresh}" Width="12" Height="12"/>
                    <TextBlock Text="Reconnect"/>
                  </StackPanel>
                </Button>
                <Button Name="DisconnectButton" Content="Disconnect" Command="{Binding Connection.DisconnectCommand}"
                        IsVisible="{Binding !Connection.IsUserDisconnected}"/>
                <Button Name="ConnectButton" Classes="Primary" Content="Connect" Command="{Binding Connection.ConnectCommand}"
                        IsVisible="{Binding Connection.IsUserDisconnected}"/>
              </StackPanel>
            </Grid>
            <!-- A wrap: in the narrowest window the choice goes under its label. -->
            <WrapPanel>
              <TextBlock Text="Connect using" Classes="Secondary" Width="150" Margin="0,4" VerticalAlignment="Center"/>
              <Border Classes="SegmentTrack" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <RadioButton Name="SerialOption" Classes="Segment" Content="USB cable"
                               IsChecked="{Binding Connection.IsSerial, Mode=TwoWay}"/>
                  <RadioButton Name="UdpOption" Classes="Segment" Content="Wi-Fi (UDP)"
                               IsChecked="{Binding Connection.IsUdp, Mode=TwoWay}"/>
                  <RadioButton Name="WebSocketOption" Classes="Segment" Content="WebSocket"
                               IsChecked="{Binding Connection.IsWebSocket, Mode=TwoWay}"/>
                </StackPanel>
              </Border>
            </WrapPanel>

            <StackPanel Name="SerialSection" Spacing="12" IsVisible="{Binding Connection.IsSerial}">
              <Grid ColumnDefinitions="150,Auto,Auto">
                <TextBlock Text="Port" Classes="Secondary" VerticalAlignment="Center"/>
                <ComboBox Name="PortCombo" Grid.Column="1" Width="{StaticResource ComboBoxStandardWidth}"
                          PlaceholderText="Select port…"
                          ItemsSource="{Binding Connection.ComPorts}"
                          SelectedItem="{Binding Connection.ComPort, Mode=TwoWay}"/>
                <Button Name="RefreshPortsButton" Grid.Column="2" Classes="Icon" Margin="4,0,0,0"
                        Command="{Binding Connection.RefreshComPortsCommand}" ToolTip.Tip="Refresh the port list">
                  <PathIcon Data="{StaticResource Icon.Refresh}" Width="14" Height="14"/>
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel Name="UdpSection" Spacing="12" IsVisible="{Binding Connection.IsUdp}">
              <Grid ColumnDefinitions="150,Auto">
                <TextBlock Text="Listen port" Classes="Secondary" VerticalAlignment="Center"/>
                <NumericUpDown Name="UdpPortBox" Grid.Column="1" Width="160"
                               Minimum="1024" Maximum="65535" FormatString="0"
                               Value="{Binding Connection.UdpListenPort, Mode=TwoWay, Converter={StaticResource IntToDecimal}}"/>
              </Grid>
            </StackPanel>

            <StackPanel Name="WebSocketSection" Spacing="12" IsVisible="{Binding Connection.IsWebSocket}">
              <Grid ColumnDefinitions="150,Auto">
                <TextBlock Text="Server port" Classes="Secondary" VerticalAlignment="Center"/>
                <NumericUpDown Name="WebSocketPortBox" Grid.Column="1" Width="160"
                               Minimum="1024" Maximum="65535" FormatString="0"
                               Value="{Binding Connection.WebSocketPort, Mode=TwoWay, Converter={StaticResource IntToDecimal}}"/>
              </Grid>
            </StackPanel>

            <TextBlock Classes="Caption" TextWrapping="Wrap"
                       Text="For Wi-Fi, this must match the controller's Wi-Fi settings (Advanced, below)."/>
          </StackPanel>
        </Border>

        <!-- 2. Status: the link, the controller and its firmware -->
        <Border Name="StatusPanel" Classes="Panel">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*">
              <controls:StatusLine Name="StatusLabel" Classes="Subtitle" VerticalAlignment="Center"
                                   Text="{Binding Connection.StatusText}" Tone="{Binding Connection.StatusTone}"/>
              <TextBlock Name="TransportDetails" Grid.Column="1" Classes="Secondary" Margin="12,0,12,0"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Text="{Binding Connection.TransportDetails}"/>
            </Grid>
            <ProgressBar Name="WaitingBar" IsIndeterminate="True" IsVisible="{Binding IsWaiting}" Height="3" MinHeight="3"/>
            <StackPanel Spacing="4" Margin="24,0,0,0">
              <TextBlock Name="HardwareSummaryText" Classes="Caption" Text="{Binding Connection.HardwareSummary}"
                         IsVisible="{Binding Connection.HasHardwareSummary}"/>
              <controls:StatusLine Name="StatusExplanationText" Classes="Caption"
                                   Text="{Binding Connection.StatusExplanation}" Tone="{Binding Connection.StatusTone}"
                                   IsVisible="{Binding Connection.HasStatusExplanation}"/>
              <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasFirmwareText}">
                <TextBlock Name="ChipText" Classes="Secondary" VerticalAlignment="Center" Text="{Binding ChipText}"/>
                <!-- An icon only when the firmware needs something: Volco's own build is plain text -->
                <controls:StatusLine Name="FirmwareText" VerticalAlignment="Center" ShowIcon="{Binding FirmwareNeedsAttention}"
                                     Text="{Binding FirmwareText}" Tone="{Binding FirmwareTone}"/>
              </StackPanel>
            </StackPanel>
            <Border Name="BannerPanel" Classes="Indent" IsVisible="{Binding HasBanner}">
              <StackPanel Spacing="8">
                <controls:StatusLine Name="BannerText" Text="{Binding BannerText}" Tone="{Binding BannerTone}"/>
                <WrapPanel Orientation="Horizontal">
                  <Button Name="CheckFirmwareBannerButton" Classes="Primary" Content="Check firmware" Margin="0,0,8,0"
                          Command="{Binding CheckWhatsConnectedCommand}" IsVisible="{Binding ShowCheckFirmware}"/>
                  <Button Name="UseControllersButton" Content="Use the controller's" Margin="0,0,8,0"
                          Command="{Binding UseControllersCommand}" IsVisible="{Binding ShowUseControllers}"/>
                  <Button Name="ApplyMineButton" Content="Apply mine" Margin="0,0,8,0"
                          Command="{Binding ApplyMineCommand}" IsVisible="{Binding ShowApplyMine}"/>
                  <Button Name="RetryButton" Content="Retry" Margin="0,0,8,0"
                          Command="{Binding RetryCommand}" IsVisible="{Binding ShowRetry}"/>
                  <Button Name="ApplySavedButton" Content="Apply my saved setup" Margin="0,0,8,0"
                          Command="{Binding ApplySavedCommand}" IsVisible="{Binding ShowApplySaved}"/>
                  <Button Name="SetUpButton" Classes="Primary" Content="Set up" Margin="0,0,8,0"
                          Command="{Binding SetUpCommand}" IsVisible="{Binding ShowSetUp}"/>
                  <Button Name="SetUpFromScratchButton" Content="Set up from scratch" Margin="0,0,8,0"
                          Command="{Binding SetUpFromScratchCommand}" IsVisible="{Binding ShowSetUpFromScratch}"/>
                  <Button Name="FixItButton" Classes="Primary" Content="Fix it" Margin="0,0,8,0"
                          Command="{Binding FixItCommand}" IsVisible="{Binding ShowFixIt}"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <controls:StatusLine Name="NoticeText" Classes="Caption" Tone="Warning"
                                 Text="{Binding Notice}" IsVisible="{Binding HasNotice}"/>

            <!-- Firmware: install, update, check (spec 8.6), on the port the Connection section picks -->
            <StackPanel Name="FirmwarePanel" Spacing="8">
              <WrapPanel Name="FirmwareButtons" Orientation="Horizontal" IsVisible="{Binding IsSerial}">
                <Button Name="UpdateFirmwareButton" Classes="Primary" Content="Update firmware" Margin="0,0,8,0"
                        Command="{Binding UpdateFirmwareCommand}" IsVisible="{Binding ShowUpdateFirmware}"
                        IsEnabled="{Binding CanUseFirmware}"/>
                <Button Name="InstallFirmwareButton" Content="Install firmware…" Margin="0,0,8,0"
                        Command="{Binding InstallFirmwareCommand}" IsEnabled="{Binding CanUseFirmware}"/>
                <Button Name="CheckFirmwareButton" Content="Check firmware" Margin="0,0,8,0"
                        Command="{Binding CheckFirmwareCommand}" IsEnabled="{Binding CanUseFirmware}"/>
              </WrapPanel>
              <controls:StatusLine Name="FirmwareHintText" Classes="Caption" Tone="Neutral" Text="{Binding FirmwareHint}"
                                   IsVisible="{Binding FirmwareHint, Converter={x:Static ObjectConverters.IsNotNull}}"/>
              <StackPanel Name="FirmwareProgressPanel" Spacing="4" IsVisible="{Binding IsFirmwareRunning}">
                <TextBlock Name="FirmwareStageText" Text="{Binding FirmwareStage}"/>
                <Grid ColumnDefinitions="*,Auto">
                  <ProgressBar Name="FirmwareProgressBar" Minimum="0" Maximum="1" Value="{Binding FirmwareProgress}"
                               VerticalAlignment="Center"/>
                  <Button Name="CancelFirmwareButton" Grid.Column="1" Margin="12,0,0,0" Content="Cancel"
                          Command="{Binding CancelFirmwareCommand}" IsVisible="{Binding CanCancelFirmware}"/>
                </Grid>
                <TextBlock Classes="Caption" Text="Don't unplug the controller until this finishes."/>
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding HasFirmwareMessage}">
                <controls:StatusLine Name="FirmwareMessageText" VerticalAlignment="Center"
                                     Text="{Binding FirmwareMessage}" Tone="{Binding FirmwareMessageTone}"/>
                <Button Name="OfferInstallButton" Grid.Column="1" Classes="Primary" Margin="12,0,0,0" Content="Install"
                        Command="{Binding InstallFirmwareCommand}" IsVisible="{Binding OfferInstall}"/>
                <Button Name="TestNowButton" Grid.Column="2" Classes="Primary" Margin="12,0,0,0" Content="Test your controller now"
                        Command="{Binding TestNowCommand}" IsVisible="{Binding OfferTest}"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Name="EditorPlaceholderText" Classes="Secondary" TextWrapping="Wrap" Margin="4,0"
                   Text="{Binding EditorPlaceholder}" IsVisible="{Binding !ShowEditor}"/>

        <StackPanel Name="EditorSections" Spacing="{StaticResource SpaceM}" IsVisible="{Binding ShowEditor}">
        <Border Name="SetupGuidePanel" Classes="Indent" BorderBrush="{DynamicResource AccentBrush}" IsVisible="{Binding IsSettingUp}">
          <TextBlock Name="SetupGuideText" TextWrapping="Wrap" Text="{Binding SetupGuideText}"/>
        </Border>
        <!-- 3. Layout: the inputs and outputs wired to the board -->
        <Border Name="HardwarePanel" Classes="Panel">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Layout" Classes="Subtitle" VerticalAlignment="Center"/>
              <Button Name="StartTestButton" Grid.Column="1" Content="Test controller…" Command="{Binding StartTestCommand}"
                      IsEnabled="{Binding CanStartTest}"
                      ToolTip.Tip="Try the sliders, buttons and lights. The controller doesn't change volume or run actions meanwhile."/>
            </Grid>
            <controls:StatusLine Name="PageErrorText" Classes="Caption" Tone="Danger"
                                 Text="{Binding PageError}" IsVisible="{Binding PageError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Grid ColumnDefinitions="150,Auto,*">
              <TextBlock Text="Start from" Classes="Secondary" VerticalAlignment="Center"/>
              <ComboBox Name="PresetCombo" Grid.Column="1" Width="{StaticResource ComboBoxStandardWidth}"
                        ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                        IsEnabled="{Binding CanEdit}" PlaceholderText="Choose a preset…">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="ctl:ControllerPreset">
                    <TextBlock Text="{Binding DisplayName}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Name="BasedOnText" Grid.Column="2" Classes="Caption" Margin="12,0,0,0"
                         VerticalAlignment="Center" Text="{Binding BasedOnText}"/>
            </Grid>

            <!-- Sliders -->
            <StackPanel Spacing="6">
              <TextBlock Text="Sliders" Classes="Secondary"/>
              <ItemsControl Name="SliderRows" ItemsSource="{Binding Sliders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HwSliderRowViewModel">
                    <StackPanel Spacing="2" Margin="0,2">
                      <Grid ColumnDefinitions="150,Auto,Auto">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                        <NumericUpDown Name="PinBox" Classes.Invalid="{Binding PinInvalid}" Grid.Column="1" Width="140" Minimum="0" Maximum="63"
                                       FormatString="0" Value="{Binding Pin, Mode=TwoWay}"
                                       IsEnabled="{Binding CanEdit}"/>
                        <Button Name="RemoveSliderButton" Grid.Column="2" Classes="Ghost" Margin="6,0,0,0" Content="Remove"
                                Command="{Binding RemoveCommand}" IsEnabled="{Binding CanEdit}"/>
                      </Grid>
                      <controls:StatusLine Name="RowError" Classes="Caption" Margin="150,0,0,0" Tone="Danger"
                                           Text="{Binding ErrorText}" IsVisible="{Binding HasError}"/>
                      <controls:StatusLine Classes="Caption" Margin="150,0,0,0" Tone="Neutral"
                                           Text="{Binding HintText}" IsVisible="{Binding HasHint}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Name="AddSliderButton" Content="Add slider" Command="{Binding AddSliderCommand}" IsEnabled="{Binding CanEdit}"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Spacing="6">
              <TextBlock Text="Buttons" Classes="Secondary"/>
              <ItemsControl Name="ButtonRows" ItemsSource="{Binding Buttons}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HwButtonRowViewModel">
                    <StackPanel Spacing="4" Margin="0,4">
                      <Grid ColumnDefinitions="150,Auto,Auto,Auto">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                        <NumericUpDown Name="PinBox" Classes.Invalid="{Binding PinInvalid}" Grid.Column="1" Width="140" Minimum="0" Maximum="63"
                                       FormatString="0" Value="{Binding Pin, Mode=TwoWay}"
                                       IsEnabled="{Binding CanEdit}"/>
                        <ComboBox Name="IndicatorCombo" Grid.Column="2" Width="130" Margin="8,0,0,0"
                                  ItemsSource="{x:Static vm:HwButtonRowViewModel.IndicatorChoices}"
                                  SelectedIndex="{Binding IndicatorIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                        <Button Name="RemoveButtonButton" Grid.Column="3" Classes="Ghost" Margin="6,0,0,0" Content="Remove"
                                Command="{Binding RemoveCommand}" IsEnabled="{Binding CanEdit}"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="150,0,0,0" IsVisible="{Binding IsLed}">
                        <TextBlock Text="LED pin" Classes="Secondary" VerticalAlignment="Center"/>
                        <NumericUpDown Name="LedPinBox" Classes.Invalid="{Binding LedPinInvalid}" Width="140" Minimum="0" Maximum="63" FormatString="0"
                                       Value="{Binding LedPin, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                        <TextBlock Text="Lights when the pin is" Classes="Secondary" VerticalAlignment="Center"/>
                        <ComboBox Name="LedPolarityCombo" Width="90"
                                  ItemsSource="{x:Static vm:HwButtonRowViewModel.PolarityChoices}"
                                  SelectedIndex="{Binding LedPolarityIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="150,0,0,0" IsVisible="{Binding IsPair}">
                        <TextBlock Text="Pin A" Classes="Secondary" VerticalAlignment="Center"/>
                        <NumericUpDown Name="PairPinABox" Classes.Invalid="{Binding PairPinAInvalid}" Width="120" Minimum="0" Maximum="63" FormatString="0"
                                       Value="{Binding PairPinA, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                        <TextBlock Text="Pin B" Classes="Secondary" VerticalAlignment="Center"/>
                        <NumericUpDown Name="PairPinBBox" Classes.Invalid="{Binding PairPinBInvalid}" Width="120" Minimum="0" Maximum="63" FormatString="0"
                                       Value="{Binding PairPinB, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                        <ComboBox Name="PairPolarityCombo" Width="90"
                                  ItemsSource="{x:Static vm:HwButtonRowViewModel.PolarityChoices}"
                                  SelectedIndex="{Binding PairPolarityIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="150,0,0,0" IsVisible="{Binding IsScreen}">
                        <ComboBox Name="ScreenBusCombo" Classes.Invalid="{Binding ScreenBusInvalid}" Width="160"
                                  ItemsSource="{x:Static vm:HwButtonRowViewModel.BusChoices}"
                                  SelectedIndex="{Binding ScreenBusIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                        <ComboBox Name="ScreenAddressCombo" Classes.Invalid="{Binding ScreenAddressInvalid}" Width="100"
                                  ItemsSource="{x:Static vm:HwButtonRowViewModel.AddressChoices}"
                                  SelectedIndex="{Binding ScreenAddressIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                      </StackPanel>
                      <controls:StatusLine Name="RowError" Classes="Caption" Margin="150,0,0,0" Tone="Danger"
                                           Text="{Binding ErrorText}" IsVisible="{Binding HasError}"/>
                      <controls:StatusLine Classes="Caption" Margin="150,0,0,0" Tone="Neutral"
                                           Text="{Binding HintText}" IsVisible="{Binding HasHint}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Name="AddButtonButton" Content="Add button" Command="{Binding AddButtonCommand}" IsEnabled="{Binding CanEdit}"/>
            </StackPanel>

            <!-- I2C buses some screen uses -->
            <StackPanel Spacing="6" IsVisible="{Binding HasBuses}">
              <TextBlock Text="Screen buses (I2C)" Classes="Secondary"/>
              <ItemsControl Name="BusRows" ItemsSource="{Binding Buses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:I2cBusRowViewModel">
                    <StackPanel Spacing="2" Margin="0,2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}" Width="150" VerticalAlignment="Center"/>
                        <TextBlock Text="SDA" Classes="Secondary" VerticalAlignment="Center"/>
                        <NumericUpDown Name="SdaBox" Classes.Invalid="{Binding PinsInvalid}" Width="120" Minimum="0" Maximum="63" FormatString="0"
                                       Value="{Binding Sda, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                        <TextBlock Text="SCL" Classes="Secondary" VerticalAlignment="Center"/>
                        <NumericUpDown Name="SclBox" Classes.Invalid="{Binding PinsInvalid}" Width="120" Minimum="0" Maximum="63" FormatString="0"
                                       Value="{Binding Scl, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                      </StackPanel>
                      <controls:StatusLine Name="RowError" Classes="Caption" Margin="150,0,0,0" Tone="Danger"
                                           Text="{Binding ErrorText}" IsVisible="{Binding HasError}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 4. Behaviour -->
        <Border Name="BehaviourPanel" Classes="Panel">
          <StackPanel Spacing="12">
            <TextBlock Text="Screens" Classes="Subtitle"/>
            <TextBlock Name="NoScreensText" Classes="Secondary" IsVisible="{Binding !ShowBehaviour}"
                       Text="These settings apply to screens. None of the buttons has one."/>
            <StackPanel Name="BehaviourBody" Spacing="12" IsVisible="{Binding ShowBehaviour}" IsEnabled="{Binding CanEdit}">
              <Grid ColumnDefinitions="200,Auto,Auto">
                <TextBlock Text="Brightness" Classes="Secondary" VerticalAlignment="Center"/>
                <NumericUpDown Name="BrightnessBox" Grid.Column="1" Width="140" Minimum="0" Maximum="255" FormatString="0"
                               Value="{Binding Brightness, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Text="0 to 255" Classes="Caption" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
              <!-- Each idle timer reads as a sentence: "Dim when idle [on] after [120 s]" -->
              <Grid ColumnDefinitions="200,Auto,Auto,Auto">
                <TextBlock Text="Dim when idle" Classes="Secondary" VerticalAlignment="Center"/>
                <ToggleSwitch Name="DimToggle" Grid.Column="1" IsChecked="{Binding DimEnabled, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Text="after" Classes="Secondary" VerticalAlignment="Center" Margin="8,0"/>
                <NumericUpDown Name="DimAfterBox" Grid.Column="3" Width="130" Minimum="1" Maximum="86400" TextConverter="{StaticResource Seconds}"
                               Value="{Binding DimAfterS, Mode=TwoWay}" IsEnabled="{Binding DimEnabled}"/>
              </Grid>
              <Grid ColumnDefinitions="200,Auto,Auto">
                <TextBlock Text="Dimmed brightness" Classes="Secondary" VerticalAlignment="Center"/>
                <NumericUpDown Name="DimBrightnessBox" Grid.Column="1" Width="140" Minimum="0" Maximum="255" FormatString="0"
                               Value="{Binding DimBrightness, Mode=TwoWay}" IsEnabled="{Binding DimEnabled}"/>
                <TextBlock Grid.Column="2" Text="The brightness while dimmed, 0 to 255" Classes="Caption"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
              <Grid ColumnDefinitions="200,Auto,Auto,Auto">
                <TextBlock Text="Turn off when idle" Classes="Secondary" VerticalAlignment="Center"/>
                <ToggleSwitch Name="OffToggle" Grid.Column="1" IsChecked="{Binding OffEnabled, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Text="after" Classes="Secondary" VerticalAlignment="Center" Margin="8,0"/>
                <NumericUpDown Name="OffAfterBox" Grid.Column="3" Width="130" Minimum="1" Maximum="86400" TextConverter="{StaticResource Seconds}"
                               Value="{Binding OffAfterS, Mode=TwoWay}" IsEnabled="{Binding OffEnabled}"/>
              </Grid>
              <Grid ColumnDefinitions="200,Auto,Auto,Auto">
                <TextBlock Text="Pixel shift" Classes="Secondary" VerticalAlignment="Center"/>
                <ToggleSwitch Name="PixelShiftToggle" Grid.Column="1" IsChecked="{Binding PixelShiftEnabled, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Text="every" Classes="Secondary" VerticalAlignment="Center" Margin="8,0"/>
                <NumericUpDown Name="PixelShiftBox" Grid.Column="3" Width="130" Minimum="1" Maximum="86400" TextConverter="{StaticResource Seconds}"
                               Value="{Binding PixelShiftEveryS, Mode=TwoWay}" IsEnabled="{Binding PixelShiftEnabled}"/>
              </Grid>
              <Grid ColumnDefinitions="200,Auto">
                <TextBlock Text="A press that wakes the screens isn't sent to the PC" Classes="Secondary"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <ToggleSwitch Name="WakeToggle" Grid.Column="1" IsChecked="{Binding WakeSwallowsPress, Mode=TwoWay}"/>
              </Grid>
              <Grid ColumnDefinitions="200,Auto,Auto,Auto">
                <TextBlock Text="Scrolling (hold, speed, end hold)" Classes="Secondary" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <NumericUpDown Name="ScrollHoldBox" Grid.Column="1" Width="120" Minimum="0" Maximum="10000" TextConverter="{StaticResource Milliseconds}"
                               Value="{Binding ScrollHoldMs, Mode=TwoWay}"/>
                <NumericUpDown Name="ScrollSpeedBox" Grid.Column="2" Width="120" Minimum="5" Maximum="200" TextConverter="{StaticResource PixelsPerSecond}"
                               Value="{Binding ScrollSpeed, Mode=TwoWay}" Margin="8,0,0,0"/>
                <NumericUpDown Name="ScrollEndHoldBox" Grid.Column="3" Width="120" Minimum="0" Maximum="10000" TextConverter="{StaticResource Milliseconds}"
                               Value="{Binding ScrollEndHoldMs, Mode=TwoWay}" Margin="8,0,0,0"/>
              </Grid>
              <Grid ColumnDefinitions="200,Auto">
                <TextBlock Text="Slide duration" Classes="Secondary" VerticalAlignment="Center"/>
                <NumericUpDown Name="TransitionBox" Grid.Column="1" Width="120" Minimum="0" Maximum="2000" TextConverter="{StaticResource Milliseconds}"
                               Value="{Binding TransitionMs, Mode=TwoWay}"/>
              </Grid>
              <controls:StatusLine Name="BehaviourErrorText" Classes="Caption" Tone="Danger" Text="{Binding BehaviourError}"
                                   IsVisible="{Binding BehaviourError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 5. Advanced -->
        <StackPanel Spacing="8">
          <ToggleButton Name="AdvancedToggle" Classes="Advanced" IsChecked="{Binding IsAdvancedOpen, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Advanced"/>
              <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="10" Height="10"/>
            </StackPanel>
          </ToggleButton>
          <Border Name="AdvancedSection" Classes="Panel" IsVisible="{Binding IsAdvancedOpen}">
            <StackPanel Spacing="12" IsEnabled="{Binding CanEdit}">
              <TextBlock Text="Input tuning" Classes="Secondary"/>
              <Grid ColumnDefinitions="200,Auto">
                <TextBlock Text="Debounce" VerticalAlignment="Center"/>
                <NumericUpDown Name="DebounceBox" Grid.Column="1" Width="120" Minimum="1" Maximum="200" TextConverter="{StaticResource Milliseconds}"
                               Value="{Binding DebounceMs, Mode=TwoWay}"/>
              </Grid>
              <Grid ColumnDefinitions="200,Auto">
                <TextBlock Text="Slider sample interval" VerticalAlignment="Center"/>
                <NumericUpDown Name="SliderIntervalBox" Grid.Column="1" Width="120" Minimum="1" Maximum="100" TextConverter="{StaticResource Milliseconds}"
                               Value="{Binding SliderIntervalMs, Mode=TwoWay}"/>
              </Grid>
              <Grid ColumnDefinitions="200,Auto">
                <TextBlock Text="Smoothing" VerticalAlignment="Center"/>
                <NumericUpDown Name="SmoothingBox" Grid.Column="1" Width="120" Minimum="1" Maximum="100" TextConverter="{StaticResource Percent}"
                               Value="{Binding SmoothingPct, Mode=TwoWay}"/>
              </Grid>
              <Grid ColumnDefinitions="200,Auto">
                <TextBlock Text="Deadband" VerticalAlignment="Center"/>
                <NumericUpDown Name="DeadbandBox" Grid.Column="1" Width="120" Minimum="0" Maximum="500" FormatString="0"
                               Value="{Binding Deadband, Mode=TwoWay}"/>
              </Grid>
              <controls:StatusLine Name="InputErrorText" Classes="Caption" Tone="Danger" Text="{Binding InputError}"
                                   IsVisible="{Binding InputError, Converter={x:Static ObjectConverters.IsNotNull}}"/>

              <TextBlock Text="Screen bus clock" Classes="Secondary" IsVisible="{Binding HasBuses}"/>
              <ItemsControl Name="BusClockRows" ItemsSource="{Binding Buses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:I2cBusRowViewModel">
                    <Grid ColumnDefinitions="200,Auto" Margin="0,2">
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                      <NumericUpDown Name="ClockBox" Classes.Invalid="{Binding ClockInvalid}" Grid.Column="1" Width="120" Minimum="100" Maximum="1000"
                                     TextConverter="{StaticResource Kilohertz}" Value="{Binding ClockKhz, Mode=TwoWay}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="Wi-Fi (UDP)" Classes="Secondary"/>
              <Grid ColumnDefinitions="200,Auto">
                <TextBlock Text="Use Wi-Fi" VerticalAlignment="Center"/>
                <ToggleSwitch Name="UdpToggle" Grid.Column="1" IsChecked="{Binding UdpEnabled, Mode=TwoWay}"/>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding UdpEnabled}">
                <Grid ColumnDefinitions="200,Auto">
                  <TextBlock Text="Network name (SSID)" VerticalAlignment="Center"/>
                  <TextBox Name="SsidBox" Classes.Invalid="{Binding SsidInvalid}" Grid.Column="1" Width="220" MaxLength="32" Text="{Binding Ssid, Mode=TwoWay}"/>
                </Grid>
                <Grid ColumnDefinitions="200,Auto,Auto">
                  <TextBlock Text="Password" VerticalAlignment="Center"/>
                  <TextBox Name="PasswordBox" Classes.Invalid="{Binding PasswordInvalid}" Grid.Column="1" Width="220" MaxLength="64" PasswordChar="{Binding PasswordChar}"
                           Text="{Binding Password, Mode=TwoWay}"/>
                  <CheckBox Name="ShowPasswordBox" Grid.Column="2" Content="Show" Margin="8,0,0,0"
                            IsChecked="{Binding ShowPassword, Mode=TwoWay}"/>
                </Grid>
                <Grid ColumnDefinitions="200,Auto">
                  <TextBlock Text="PC IP address" VerticalAlignment="Center"/>
                  <TextBox Name="PcIpBox" Classes.Invalid="{Binding PcIpInvalid}" Grid.Column="1" Width="220" PlaceholderText="192.168.1.10"
                           Text="{Binding PcIp, Mode=TwoWay}"/>
                </Grid>
                <Grid ColumnDefinitions="200,Auto">
                  <TextBlock Text="PC port" VerticalAlignment="Center"/>
                  <NumericUpDown Name="PcPortBox" Classes.Invalid="{Binding PortsInvalid}" Grid.Column="1" Width="140" Minimum="1" Maximum="65535" FormatString="0"
                                 Value="{Binding PcPort, Mode=TwoWay}"/>
                </Grid>
                <Grid ColumnDefinitions="200,Auto">
                  <TextBlock Text="Controller port" VerticalAlignment="Center"/>
                  <NumericUpDown Name="LocalPortBox" Classes.Invalid="{Binding PortsInvalid}" Grid.Column="1" Width="140" Minimum="1" Maximum="65535" FormatString="0"
                                 Value="{Binding LocalPort, Mode=TwoWay}"/>
                </Grid>
                <TextBlock Classes="Caption" TextWrapping="Wrap"
                           Text="USB keeps working. If the Wi-Fi settings are wrong, fix them over USB."/>
              </StackPanel>
              <controls:StatusLine Name="WifiErrorText" Classes="Caption" Tone="Danger" Text="{Binding WifiError}"
                                   IsVisible="{Binding WifiError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
          </Border>
        </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>

  <!-- The snackbar: a question, a save's progress or result, or unsaved changes -->
  <Border Name="Footer" Classes="Snackbar" Margin="24,0,24,16" IsVisible="{Binding ShowFooter}">
    <Panel>
      <Grid Name="ConfirmPanel" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding HasConfirmation}">
        <TextBlock Name="ConfirmText" TextWrapping="Wrap" VerticalAlignment="Center"
                   Text="{Binding Confirmation.Message, FallbackValue=''}"/>
        <Button Name="ConfirmButton" Grid.Column="1" Classes="Primary" Margin="12,0,0,0"
                Content="{Binding Confirmation.ConfirmLabel, FallbackValue=''}"
                Command="{Binding Confirmation.ConfirmCommand, FallbackValue={x:Null}}"/>
        <Button Name="CancelConfirmButton" Grid.Column="2" Margin="8,0,0,0" Content="Cancel"
                Command="{Binding Confirmation.CancelCommand, FallbackValue={x:Null}}"/>
      </Grid>
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" IsVisible="{Binding !HasConfirmation}">
        <controls:StatusLine Name="ProgressText" VerticalAlignment="Center"
                             Text="{Binding FooterText}" Tone="{Binding FooterTone}"/>
        <Button Name="RevertButton" Grid.Column="1" Content="Revert" Margin="12,0,0,0"
                Command="{Binding RevertCommand}" IsVisible="{Binding IsDirty}"/>
        <Button Name="SaveButton" Grid.Column="2" Classes="Primary" Content="Save to controller" Margin="8,0,0,0"
                Command="{Binding SaveCommand}" IsVisible="{Binding IsDirty}"/>
        <Button Name="DismissFooterButton" Grid.Column="3" Classes="Icon" Margin="4,0,0,0" ToolTip.Tip="Close"
                VerticalAlignment="Center" Command="{Binding DismissFooterCommand}" IsVisible="{Binding CanDismissFooter}">
          <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12"/>
        </Button>
      </Grid>
    </Panel>
  </Border>

  <!-- Modal dialogs: a scrim over the page, one card at a time -->
  <Border Name="DialogOverlay" Background="#66000000" IsVisible="{Binding HasDialog}">
    <Border Name="DialogCard" Classes="Panel" Padding="24" MaxWidth="560" Margin="24"
            HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 8 28 0 #40000000">
      <Panel>
        <!-- Install firmware: asks first, since Install wipes the controller's setup -->
        <StackPanel Name="InstallDialog" Spacing="16" IsVisible="{Binding ConfirmInstallPending}">
          <TextBlock Classes="Subtitle" Text="Install Volco's firmware?"/>
          <TextBlock TextWrapping="Wrap"
                     Text="Installing erases the setup stored on the controller. Volco keeps a copy you can apply afterwards."/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelInstallButton" Content="Cancel" Command="{Binding CancelInstallCommand}"/>
            <Button Name="ConfirmInstallButton" Classes="Primary" Content="Install" Command="{Binding ConfirmInstallCommand}"/>
          </StackPanel>
        </StackPanel>

        <!-- The hardware test (spec 8.5): open while testing; closing it ends the test -->
        <StackPanel Name="TestDialog" Spacing="14" IsVisible="{Binding IsTesting}" MinWidth="400">
          <TextBlock Classes="Subtitle" Text="Test controller"/>
          <TextBlock Classes="Secondary" TextWrapping="Wrap"
                     Text="Move a slider or press a button and it shows here. Each press switches the button's light or changes its screen."/>
          <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
              <ItemsControl Name="TestSliderRows" ItemsSource="{Binding TestSliders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TestSliderViewModel">
                    <Grid ColumnDefinitions="110,*,60" Margin="0,3">
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                      <ProgressBar Grid.Column="1" Classes="Level" Minimum="0" Maximum="1" Value="{Binding Level}"
                                   VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Classes="Caption" Margin="10,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding Value}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl Name="TestButtonRows" ItemsSource="{Binding TestButtons}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TestButtonViewModel">
                    <Grid ColumnDefinitions="110,Auto,*" Margin="0,3">
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                      <Ellipse Grid.Column="1" Classes="Led" Classes.on="{Binding IsPressed}" VerticalAlignment="Center"
                               ToolTip.Tip="Lit while the button is held"/>
                      <TextBlock Name="TestStateText" Grid.Column="2" Classes="Secondary" Margin="16,0,0,0"
                                 VerticalAlignment="Center" Text="{Binding StateText}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <TextBlock Classes="Caption" TextWrapping="Wrap"
                     Text="While testing, the controller doesn't change volume or run actions."/>
          <Button Name="StopTestButton" Classes="Primary" HorizontalAlignment="Right" Content="Done"
                  Command="{Binding StopTestCommand}"/>
        </StackPanel>
      </Panel>
    </Border>
  </Border>
  </Grid>
</UserControl>
