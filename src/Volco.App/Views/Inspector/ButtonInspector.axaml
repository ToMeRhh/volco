<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Volco.App.ViewModels"
             xmlns:conv="using:Volco.App.Converters"
             xmlns:controls="using:Volco.App.Controls"
             xmlns:stage="using:Volco.App.Views.Stage"
             xmlns:inspector="using:Volco.App.Views.Inspector"
             x:Class="Volco.App.Views.Inspector.ButtonInspector"
             x:DataType="vm:ButtonItemViewModel">
  <UserControl.Resources>

    <!-- One gesture's row: its action (a click opens the action dialog), the USB tag, a warning
         for a saved action with a problem, and Try. An empty row shows "—" and a +, which opens the dialog too. -->
    <DataTemplate x:Key="ActionRowTemplate" x:DataType="vm:ActionSlotViewModel">
      <Grid ColumnDefinitions="*,Auto" Classes="ActionRowGrid">
        <Button Name="RowButton" Classes="InspectorRow"
                Command="{Binding $parent[stage:StagePage].((vm:ControlsViewModel)DataContext).OpenActionCommand}"
                CommandParameter="{Binding}">
          <Grid ColumnDefinitions="78,Auto,*,Auto,Auto">
            <TextBlock Name="GestureText" Classes="RowLabel" Text="{Binding Label}"/>
            <Border Grid.Column="1" Classes="RowIcon" IsVisible="{Binding CanTest}">
              <PathIcon Data="{Binding IconKey, Converter={x:Static conv:IconConverters.Action}}"/>
            </Border>
            <TextBlock Name="ActionText" Grid.Column="2" Classes="RowValue" Classes.none="{Binding !CanTest}"
                       Text="{Binding RowText}"/>
            <Border Name="UsbTag" Grid.Column="3" Classes="UsbTag" IsVisible="{Binding IsUsb}"
                    ToolTip.Tip="Runs only for presses over the USB cable">
              <TextBlock Text="USB"/>
            </Border>
            <PathIcon Name="InvalidIcon" Grid.Column="4" Classes="InvalidIcon" Data="{StaticResource Icon.Status.Warning}"
                      IsVisible="{Binding HasProblem}" ToolTip.Tip="{Binding Problem}"/>
          </Grid>
        </Button>
        <Panel Grid.Column="1" Classes="TryCell">
          <Button Name="TryButton" Classes="Try" Command="{Binding TestCommand}" IsVisible="{Binding CanTest}"
                  ToolTip.Tip="Try">
            <PathIcon Data="{StaticResource Icon.Device.Play}" Width="10" Height="10"/>
          </Button>
          <Button Name="AddButton" Classes="Try" IsVisible="{Binding !CanTest}" ToolTip.Tip="Set an action"
                  Command="{Binding $parent[stage:StagePage].((vm:ControlsViewModel)DataContext).OpenActionCommand}"
                  CommandParameter="{Binding}">
            <PathIcon Classes="RowAdd" Data="{StaticResource Icon.Plus}"/>
          </Button>
        </Panel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The selected button (controller-page spec §4.3): the Actions section (its actions in the
       edited mode, its light, its timing) over the Hardware section (its wiring, Remove),
       scrolling as one (TileInspector). -->
  <StackPanel>
    <!-- At least the page's InspectorTopHeight, so Hardware starts where it does for every tile -->
    <Panel Name="Top" MinHeight="{Binding $parent[stage:StagePage].InspectorTopHeight, FallbackValue=0}">
      <StackPanel Name="TopContent" VerticalAlignment="Top">
        <Grid Classes="InspectorHeader" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Name="KindText" Classes="InspectorKind" Text="{Binding KindText}"
                       IsVisible="{Binding KindText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Name="HeadingText" Classes="InspectorHeading" Text="{Binding DisplayHeading}"/>
          </StackPanel>
          <Button Name="ClearButton" Grid.Column="1" VerticalAlignment="Center" Content="Clear"
                  Command="{Binding $parent[stage:StagePage].((vm:ControlsViewModel)DataContext).ClearCommand}"
                  CommandParameter="{Binding}" IsEnabled="{Binding CanClear}"/>
        </Grid>

        <!-- Actions, labelled with the edited mode as a coloured pill: the gestures, the light or
             screen and the timing; a button only the draft has is set up once the controller has it -->
        <StackPanel Name="ActionsSection">
          <Border Name="ActionsHeader" Classes="GroupHeader">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBlock Classes="GroupLabel" Text="Actions"/>
              <Border Name="ModePill" Grid.Column="1" Classes="ModePill" HorizontalAlignment="Left"
                      controls:ModeTint.Index="{Binding $parent[stage:StagePage].((vm:ControlsViewModel)DataContext).Buttons.EditingTintIndex}">
                <TextBlock Text="{Binding $parent[stage:StagePage].((vm:ControlsViewModel)DataContext).Buttons.EditingName}"/>
              </Border>
            </Grid>
          </Border>
          <Panel Name="ActionsBody" Classes="GroupBody">
            <Border Name="SaveFirstPanel" Classes="InspectorRows SaveFirst" IsVisible="{Binding IsNew}">
              <StackPanel Spacing="10">
                <TextBlock Name="SaveFirstText" Classes="Secondary" TextWrapping="Wrap" Text="Save to controller to set it up"/>
                <Button Name="SaveFirstButton" Classes="Primary" HorizontalAlignment="Left" Content="Save to controller"
                        Command="{Binding $parent[stage:StagePage].Hardware.SaveCommand, FallbackValue={x:Null}}"/>
              </StackPanel>
            </Border>
            <StackPanel Name="ActionsContent" Classes="InspectorGroupBody" IsVisible="{Binding !IsNew}">
              <!-- One card: the three gestures -->
              <Border Name="GestureCard" Classes="InspectorRows">
                <controls:CardRows>
                  <ContentControl Name="ActionRow_Press" Content="{Binding Press}" ContentTemplate="{StaticResource ActionRowTemplate}"/>
                  <ContentControl Name="ActionRow_Double" Content="{Binding DoublePress}" ContentTemplate="{StaticResource ActionRowTemplate}"/>
                  <ContentControl Name="ActionRow_Hold" Content="{Binding Hold}" ContentTemplate="{StaticResource ActionRowTemplate}"/>
                </controls:CardRows>
              </Border>

              <!-- The light or screen follows the main action; not editable -->
              <Border Name="LightRow" Classes="InspectorRows" IsVisible="{Binding HasLightRow}">
                <Grid ColumnDefinitions="Auto,*" Classes="LightRowGrid">
                  <Border Classes="LightPreview" ToolTip.Tip="{Binding LightDescription}">
                    <Panel>
                      <Ellipse Classes="Led" Classes.on="{Binding LedOn}" IsVisible="{Binding IsLed}"/>
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsLedPair}">
                        <Ellipse Classes="Led" Classes.on="{Binding LedA}"/>
                        <Ellipse Classes="Led" Classes.on="{Binding LedB}"/>
                      </StackPanel>
                      <controls:ScreenPreview Scale="0.5" Screen="{Binding Screen}" IsVisible="{Binding IsScreen}"/>
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Name="LightLabel" Classes="Secondary" Text="{Binding LightRowLabel}"/>
                    <TextBlock Name="LightText" Text="{Binding LightRowText}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Panel>
        </StackPanel>
      </StackPanel>
    </Panel>

    <!-- Hardware: its pin, its light's wiring and Remove, from the controller draft -->
    <inspector:HardwareSection Name="HardwareSection"
                               Wiring="{Binding $parent[stage:StagePage].Hardware.InspectedButton, FallbackValue={x:Null}}"
                               HasProblem="{Binding $parent[stage:StagePage].Hardware.InspectedButton.HasProblem, FallbackValue=False}"
                               IsMissing="{Binding IsMissing}"
                               RemoveMissingCommand="{Binding RemoveLastCommand}">
      <inspector:HardwareSection.IsVisible>
        <!-- A control the controller lacks says so even on a stage without the draft -->
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="IsMissing"/>
          <Binding Path="$parent[stage:StagePage].Hardware" Converter="{x:Static ObjectConverters.IsNotNull}"/>
        </MultiBinding>
      </inspector:HardwareSection.IsVisible>
      <inspector:HardwareSection.CanRemoveMissing>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsMissing"/>
          <Binding Path="IsLast"/>
        </MultiBinding>
      </inspector:HardwareSection.CanRemoveMissing>
    </inspector:HardwareSection>
  </StackPanel>
</UserControl>
