<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Volco.App.ViewModels"
             xmlns:conv="using:Volco.App.Converters"
             xmlns:controls="using:Volco.App.Controls"
             xmlns:stage="using:Volco.App.Views.Stage"
             xmlns:inspector="using:Volco.App.Views.Inspector"
             x:Class="Volco.App.Views.Inspector.SliderInspector"
             x:DataType="vm:SliderItemViewModel">
  <!-- The selected slider (controller-page spec §4.3): its name, then the Controls section (what
       it controls, its response) over the Hardware section (its pin, Remove), scrolling as one
       (TileInspector). -->
  <StackPanel>
    <!-- At least the page's InspectorTopHeight, so Hardware starts where it does for every tile -->
    <Panel Name="Top" MinHeight="{Binding $parent[stage:StagePage].InspectorTopHeight, FallbackValue=0}">
      <StackPanel Name="TopContent" VerticalAlignment="Top">
        <StackPanel Classes="InspectorHeader" Spacing="2">
          <TextBlock Name="HeadingText" Classes="InspectorKind" Text="{Binding DisplayHeading}"/>
          <!-- A new slider's config is thrown away until the controller has it: no name yet -->
          <TextBox Name="NameBox" Classes="NameField" Text="{Binding Name, Mode=TwoWay}"
                   PlaceholderText="{Binding TargetLabel}" IsEnabled="{Binding !IsNew}"/>
        </StackPanel>

        <!-- Controls: what it controls and its response; a slider only the draft has is set up
             once the controller has it -->
        <StackPanel Name="ControlsSection">
          <Border Name="ControlsHeader" Classes="GroupHeader">
            <TextBlock Classes="GroupLabel" Text="Controls"/>
          </Border>
          <Panel Name="ControlsBody" Classes="GroupBody">
            <Border Name="SaveFirstPanel" Classes="InspectorRows SaveFirst" IsVisible="{Binding IsNew}">
              <StackPanel Spacing="10">
                <TextBlock Name="SaveFirstText" Classes="Secondary" TextWrapping="Wrap" Text="Save to controller to set it up"/>
                <Button Name="SaveFirstButton" Classes="Primary" HorizontalAlignment="Left" Content="Save to controller"
                        Command="{Binding $parent[stage:StagePage].Hardware.SaveCommand, FallbackValue={x:Null}}"/>
              </StackPanel>
            </Border>
            <StackPanel Name="ControlsContent" Classes="InspectorGroupBody" IsVisible="{Binding !IsNew}">
              <!-- One card: the Controls row, then Response's header and, open, its settings
                   nested under it -->
              <Border Classes="InspectorRows">
                <controls:CardRows>
                  <Button Name="ControlsRow" Classes="InspectorRow"
                          Command="{Binding $parent[stage:StagePage].((vm:ControlsViewModel)DataContext).OpenTargetCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="78,Auto,*,Auto">
                      <TextBlock Classes="RowLabel" Text="Controls"/>
                      <Border Grid.Column="1" Classes="RowIcon">
                        <Panel>
                          <PathIcon Data="{Binding TargetIconKey, Converter={x:Static conv:IconConverters.Resource}}"
                                    IsVisible="{Binding !HasAppIcon}"/>
                          <Image Name="TargetAppIcon" Width="16" Height="16" Source="{Binding AppIcon}" IsVisible="{Binding HasAppIcon}"/>
                        </Panel>
                      </Border>
                      <TextBlock Name="TargetText" Grid.Column="2" Classes="RowValue" Classes.none="{Binding IsNotSetUp}"
                                 Text="{Binding TargetLabel}"/>
                      <PathIcon Grid.Column="3" Classes="RowChevron" Data="{StaticResource Icon.ChevronRight}"/>
                    </Grid>
                  </Button>
                  <ToggleButton Name="ResponseToggle" Classes="SectionHeader" IsChecked="{Binding IsAdvancedOpen, Mode=TwoWay}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Classes="SectionLabel" Text="Response"/>
                      <TextBlock Name="ResponseSummaryText" Grid.Column="1" Classes="Caption" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Text="{Binding ResponseSummary}"/>
                      <PathIcon Grid.Column="2" Classes="SectionChevron" Data="{StaticResource Icon.ChevronRight}"/>
                    </Grid>
                  </ToggleButton>
                  <Border Name="ResponseBody" Classes="Nested" IsVisible="{Binding IsAdvancedOpen}">
                    <StackPanel Classes="SectionBody">
                      <ListBox Name="CurveList" Classes="Curves" SelectedIndex="{Binding CurveIndex, Mode=TwoWay}">
                        <ListBox.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                          </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBoxItem ToolTip.Tip="Linear">
                          <StackPanel Spacing="3">
                            <Path Classes="CurveGraph" Data="M1,19 L19,1"/>
                            <TextBlock Text="Linear"/>
                          </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem ToolTip.Tip="Logarithmic">
                          <StackPanel Spacing="3">
                            <Path Classes="CurveGraph" Data="M1,19 C1,8 8,1 19,1"/>
                            <TextBlock Text="Log"/>
                          </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem ToolTip.Tip="Exponential">
                          <StackPanel Spacing="3">
                            <Path Classes="CurveGraph" Data="M1,19 C12,19 19,12 19,1"/>
                            <TextBlock Text="Exp"/>
                          </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem ToolTip.Tip="S-curve">
                          <StackPanel Spacing="3">
                            <Path Classes="CurveGraph" Data="M1,19 C10,19 10,1 19,1"/>
                            <TextBlock Text="S-curve"/>
                          </StackPanel>
                        </ListBoxItem>
                      </ListBox>
                      <Grid ColumnDefinitions="90,*,44">
                        <TextBlock Text="Dead zone" Classes="Secondary" VerticalAlignment="Center"/>
                        <Slider Name="DeadZoneSlider" Grid.Column="1" Minimum="0" Maximum="0.45"
                                Value="{Binding DeadZonePercent, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Classes="Caption" VerticalAlignment="Center" TextAlignment="Right"
                                   Text="{Binding DeadZonePercent, StringFormat={}{0:P0}}"/>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Reverse" Classes="Secondary" VerticalAlignment="Center"/>
                        <ToggleSwitch Name="InvertSwitch" Grid.Column="1" OnContent="" OffContent=""
                                      IsChecked="{Binding Invert, Mode=TwoWay}"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </controls:CardRows>
              </Border>
            </StackPanel>
          </Panel>
        </StackPanel>
      </StackPanel>
    </Panel>

    <!-- Hardware: its pin and Remove, from the controller draft -->
    <inspector:HardwareSection Name="HardwareSection"
                               Wiring="{Binding $parent[stage:StagePage].Hardware.InspectedSlider, FallbackValue={x:Null}}"
                               HasProblem="{Binding $parent[stage:StagePage].Hardware.InspectedSlider.HasProblem, FallbackValue=False}"
                               IsMissing="{Binding IsMissing}"
                               RemoveMissingCommand="{Binding RemoveLastCommand}">
      <inspector:HardwareSection.IsVisible>
        <!-- A control the controller lacks says so even on a stage without the draft -->
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="IsMissing"/>
          <Binding Path="$parent[stage:StagePage].Hardware" Converter="{x:Static ObjectConverters.IsNotNull}"/>
        </MultiBinding>
      </inspector:HardwareSection.IsVisible>
      <inspector:HardwareSection.CanRemoveMissing>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsMissing"/>
          <Binding Path="IsLast"/>
        </MultiBinding>
      </inspector:HardwareSection.CanRemoveMissing>
    </inspector:HardwareSection>
  </StackPanel>
</UserControl>
