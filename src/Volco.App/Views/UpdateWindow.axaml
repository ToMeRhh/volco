<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Volco.App.Views.UpdateWindow"
        Title="Volco — Software Update"
        Width="560" Height="460"
        CanMaximize="False"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="16" MaxWidth="520" HorizontalAlignment="Left">

      <TextBlock Text="Software Update" Classes="SectionHeader"/>

      <StackPanel Spacing="2">
        <TextBlock Name="CurrentVersionText" Text="Current version: v0.0.0"/>
        <TextBlock Name="StatusText"
                   Text="Click &quot;Check for Updates&quot; to begin."
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <ProgressBar Name="Progress"
                   IsIndeterminate="False"
                   Minimum="0" Maximum="1" Value="0"
                   IsVisible="False"/>

      <TextBlock Name="NotesText"
                 Classes="Caption"
                 TextWrapping="Wrap"
                 IsVisible="False"/>

      <StackPanel Spacing="6">
        <TextBlock Text="GitHub token (needs repo + actions:read scope)"/>
        <TextBox Name="TokenBox" PasswordChar="●" Watermark="ghp_..."/>
        <TextBlock Text="Volco is a private repository, so a token is required to check for and download updates. It is stored in your local config."
                   Classes="Caption"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <CheckBox Name="UseCiCheckBox"
                Content="Update from the latest CI build instead of a release (advanced)"/>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="CheckButton" Content="Check for Updates"/>
        <Button Name="UpdateButton" Content="Update Now" Classes="accent" IsEnabled="False"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Window>
