<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Volco</AssemblyName>
    <RootNamespace>Volco.Windows</RootNamespace>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>volco.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Publish trimming. Partial mode trims only assemblies marked
       trimmable (the framework, the Windows SDK projection, Avalonia); Volco's own assemblies,
       EspDotNet and Google.Protobuf are kept whole. -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Trimmed apps turn [ComImport] COM off by default; the audio engine (CsWin32's Core Audio
         interfaces, DefaultDevicePolicy's IPolicyConfig) depends on it. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Trimmed apps also turn reflection-based System.Text.Json off. Volco's config has its own
         source-generated context, but EspDotNet reads its flasher stubs (embedded JSON) by
         reflection; it isn't marked trimmable, so its types survive whole. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- No EventSource tracing (dotnet-trace) or debugger support in the published exe. -->
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Windows backends only (Program.UseWindowsBackends), not Avalonia.Desktop, which also
         carries the Linux and macOS ones. -->
    <PackageReference Include="Avalonia.Win32" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.2" />
    <!-- The USB firmware flasher (spec 8.6); only this project may reference it. -->
    <PackageReference Include="EspDotNet" Version="5.0.2" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.335">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ANGLE (Avalonia's GPU path on Windows) comes with Avalonia.Win32; Volco renders in software
       (Program.UseWindowsBackends), so the published exe doesn't carry it. -->
  <Target Name="DropAngle" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'av_libglesv2.dll'" />
    </ItemGroup>
  </Target>

  <!-- The controller firmware (spec 9.3): CI downloads it into Firmware/esp32; local builds have none. -->
  <ItemGroup>
    <EmbeddedResource Include="Firmware\esp32\*" LogicalName="Firmware/esp32/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- CI sets RequireFirmware: the build fails without the firmware, or with firmware from another build. -->
  <Target Name="CheckFirmware" BeforeTargets="BeforeBuild" Condition="'$(RequireFirmware)' == 'true'">
    <PropertyGroup>
      <_VolcoFirmwareManifest>$(MSBuildProjectDirectory)\Firmware\esp32\firmware-manifest.json</_VolcoFirmwareManifest>
    </PropertyGroup>
    <Error Condition="!Exists('$(_VolcoFirmwareManifest)')" Text="RequireFirmware: $(_VolcoFirmwareManifest) is missing." />
    <Error Condition="'$(VolcoFirmwareBuildId)' == ''" Text="RequireFirmware: VolcoFirmwareBuildId is not set." />
    <PropertyGroup>
      <_VolcoFirmwareManifestText>$([System.IO.File]::ReadAllText('$(_VolcoFirmwareManifest)'))</_VolcoFirmwareManifestText>
    </PropertyGroup>
    <Error Condition="!$(_VolcoFirmwareManifestText.Contains('&quot;version&quot;: &quot;$(VolcoFirmwareBuildId)&quot;'))"
           Text="RequireFirmware: the embedded firmware isn't build $(VolcoFirmwareBuildId)." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Volco.Core\Volco.Core.csproj" />
    <ProjectReference Include="..\Volco.App\Volco.App.csproj" />
  </ItemGroup>
</Project>
