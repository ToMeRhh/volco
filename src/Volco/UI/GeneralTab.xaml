<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Volco.UI.GeneralTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24"
            Spacing="16">
        <TextBlock Text="General Settings"
                Style="{StaticResource SubtitleTextBlockStyle}"/>

        <CheckBox x:Name="DebugLoggingCheckBox"
                Content="Enable debug logging"
                Checked="DebugLogging_Changed"
                Unchecked="DebugLogging_Changed"/>
    </StackPanel>
</Page>
