<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Volco.UI.GeneralTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    x:DefaultBindMode="OneWay">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}"
                    Spacing="{StaticResource SpaceL}"
                    MaxWidth="{StaticResource SettingsCardMaxWidth}"
                    HorizontalAlignment="Left">

            <!-- ── Page header ──────────────────────────────────────── -->
            <TextBlock Text="General Settings"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4"/>

            <!-- ── Debug logging ────────────────────────────────────── -->
            <tk:SettingsCard Header="Debug Logging"
                             Description="Write verbose diagnostic output to the app log file">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEBE8;" Foreground="{StaticResource IconAccentBrush}"/>
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DebugLogging, Mode=TwoWay}"
                              OnContent="Enabled"
                              OffContent="Disabled"/>
            </tk:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
