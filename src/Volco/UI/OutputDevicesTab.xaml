<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Volco.UI.OutputDevicesTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    x:DefaultBindMode="OneWay">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource SpaceXl}"
                    Spacing="{StaticResource SpaceL}"
                    MaxWidth="{StaticResource SettingsCardMaxWidth}"
                    HorizontalAlignment="Left">

            <!-- ── Page header ──────────────────────────────────────── -->
            <TextBlock Text="Output Device Toggle"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4"/>

            <!-- ── Caption ─────────────────────────────────────────── -->
            <TextBlock Text="Configure the two devices to switch between when using the Toggle Output Device action."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"/>

            <!-- ── Device 1 ─────────────────────────────────────────── -->
            <tk:SettingsCard Header="Device 1"
                             Description="First output device in the toggle pair">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F3;" Foreground="{StaticResource IconAccentBrush}"/>
                </tk:SettingsCard.HeaderIcon>
                <ComboBox ItemsSource="{x:Bind ViewModel.OutputDeviceNames}"
                          SelectedItem="{x:Bind ViewModel.Device1, Mode=TwoWay}"
                          Width="{StaticResource ComboBoxStandardWidth}"
                          PlaceholderText="Select device…"/>
            </tk:SettingsCard>

            <!-- ── Device 2 ─────────────────────────────────────────── -->
            <tk:SettingsCard Header="Device 2"
                             Description="Second output device in the toggle pair">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F3;" Foreground="{StaticResource IconAccentBrush}"/>
                </tk:SettingsCard.HeaderIcon>
                <ComboBox ItemsSource="{x:Bind ViewModel.OutputDeviceNames}"
                          SelectedItem="{x:Bind ViewModel.Device2, Mode=TwoWay}"
                          Width="{StaticResource ComboBoxStandardWidth}"
                          PlaceholderText="Select device…"/>
            </tk:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
