<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Volco.UI.ConnectionTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:Volco.UI.Converters"
    x:DefaultBindMode="OneWay">

    <Page.Resources>
        <converters:ConnectionStatusToBrushConverter x:Key="StatusToBrush"/>
        <converters:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
        <converters:IntToDoubleConverter             x:Key="IntToDouble"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource SpaceXl}"
                    Spacing="{StaticResource SpaceL}"
                    MaxWidth="{StaticResource SettingsCardMaxWidth}"
                    HorizontalAlignment="Left">

            <!-- ── Page header ──────────────────────────────────────── -->
            <TextBlock Text="Connection"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4"/>

            <!-- ── Live status bar ──────────────────────────────────── -->
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource SpaceS}"
                        VerticalAlignment="Center">
                <Ellipse Width="12" Height="12"
                         Fill="{x:Bind ViewModel.Status, Converter={StaticResource StatusToBrush}}"/>
                <TextBlock Text="{x:Bind ViewModel.StatusText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ── Connection type ──────────────────────────────────── -->
            <tk:SettingsCard Header="Connection Type"
                             Description="Choose how Volco connects to the hardware controller">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE703;" Foreground="{StaticResource IconAccentBrush}"/>
                </tk:SettingsCard.HeaderIcon>
                <ComboBox SelectedIndex="{x:Bind ViewModel.ConnectionTypeIndex, Mode=TwoWay}"
                          Width="{StaticResource ComboBoxStandardWidth}">
                    <ComboBoxItem Content="Serial (USB)"/>
                    <ComboBoxItem Content="UDP (Wireless)"/>
                    <ComboBoxItem Content="WebSocket"/>
                </ComboBox>
            </tk:SettingsCard>

            <!-- ── Serial settings (visible when IsSerial) ─────────── -->
            <StackPanel Spacing="{StaticResource SpaceXs}"
                        Visibility="{x:Bind ViewModel.IsSerial, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="Serial Settings"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,4"/>

                <tk:SettingsCard Header="COM Port"
                                 Description="Select the serial port for the controller">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <ComboBox ItemsSource="{x:Bind ViewModel.ComPorts}"
                                  SelectedItem="{x:Bind ViewModel.ComPort, Mode=TwoWay}"
                                  Width="{StaticResource ComboBoxStandardWidth}"
                                  PlaceholderText="Select port…"/>
                        <Button Command="{x:Bind ViewModel.RefreshComPortsCommand}"
                                ToolTipService.ToolTip="Refresh port list">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Baud Rate"
                                 Description="Must match the firmware setting">
                    <ComboBox SelectedIndex="{x:Bind ViewModel.BaudRateIndex, Mode=TwoWay}"
                              Width="{StaticResource ComboBoxStandardWidth}">
                        <ComboBoxItem Content="9600"/>
                        <ComboBoxItem Content="19200"/>
                        <ComboBoxItem Content="38400"/>
                        <ComboBoxItem Content="57600"/>
                        <ComboBoxItem Content="115200"/>
                    </ComboBox>
                </tk:SettingsCard>

            </StackPanel>

            <!-- ── UDP settings (visible when IsUdp) ───────────────── -->
            <StackPanel Spacing="{StaticResource SpaceXs}"
                        Visibility="{x:Bind ViewModel.IsUdp, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="UDP Settings"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,4"/>

                <tk:SettingsCard Header="Listen Port"
                                 Description="Local UDP port to receive controller data (1024–65535)">
                    <NumberBox Value="{x:Bind ViewModel.UdpListenPort, Mode=TwoWay, Converter={StaticResource IntToDouble}}"
                               Minimum="1024"
                               Maximum="65535"
                               SpinButtonPlacementMode="Compact"
                               Width="160"/>
                </tk:SettingsCard>

            </StackPanel>

            <!-- ── WebSocket settings (visible when IsWebSocket) ────── -->
            <StackPanel Spacing="{StaticResource SpaceXs}"
                        Visibility="{x:Bind ViewModel.IsWebSocket, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="WebSocket Settings"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,4"/>

                <tk:SettingsCard Header="Port"
                                 Description="WebSocket server port (1024–65535)">
                    <NumberBox Value="{x:Bind ViewModel.WebSocketPort, Mode=TwoWay, Converter={StaticResource IntToDouble}}"
                               Minimum="1024"
                               Maximum="65535"
                               SpinButtonPlacementMode="Compact"
                               Width="160"/>
                </tk:SettingsCard>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
