<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Volco.UI.SlidersTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Volco.UI.ViewModels"
    xmlns:converters="using:Volco.UI.Converters"
    x:DefaultBindMode="OneWay">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource SpaceXl}"
                    Spacing="{StaticResource SpaceL}"
                    MaxWidth="{StaticResource SettingsCardMaxWidth}"
                    HorizontalAlignment="Left">

            <!-- ── Page header ──────────────────────────────────────── -->
            <TextBlock Text="Slider Mappings"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4"/>

            <!-- ── Per-slider cards ─────────────────────────────────── -->
            <ItemsRepeater x:Name="SliderRepeater"
                           ItemsSource="{x:Bind ViewModel.Items}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:SliderItemViewModel">
                        <Border Padding="{StaticResource SpaceM}"
                                Margin="0,0,0,8"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource SurfaceStrokeBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="{StaticResource SpaceS}">

                                <!-- Title row: "Slider N" -->
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="Slider "/>
                                    <Run Text="{x:Bind Index}"/>
                                </TextBlock>

                                <!-- Live level bar -->
                                <StackPanel Spacing="{StaticResource SpaceXs}">
                                    <TextBlock Text="Live Level"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ProgressBar Minimum="0"
                                                 Maximum="1"
                                                 Value="{x:Bind LiveLevel, Mode=OneWay}"
                                                 Height="6"
                                                 HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <!-- Mapping type selector -->
                                <StackPanel Spacing="{StaticResource SpaceXs}">
                                    <TextBlock Text="Mapping Type"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox SelectedIndex="{x:Bind MappingTypeIndex, Mode=TwoWay}"
                                              Width="{StaticResource ComboBoxStandardWidth}">
                                        <ComboBoxItem Content="Processes"/>
                                        <ComboBoxItem Content="Output Device"/>
                                        <ComboBoxItem Content="Unmapped"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Process input (visible when IsProcessesVisible) -->
                                <StackPanel Spacing="{StaticResource SpaceXs}"
                                            Visibility="{x:Bind IsProcessesVisible, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Processes (comma-separated)"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <AutoSuggestBox Width="300"
                                                    PlaceholderText="e.g. spotify.exe, chrome.exe"
                                                    Text="{x:Bind ProcessesText, Mode=TwoWay}"
                                                    TextChanged="ProcessBox_TextChanged"
                                                    SuggestionChosen="ProcessBox_SuggestionChosen"/>
                                </StackPanel>

                                <!-- Device picker (visible when IsDeviceVisible) -->
                                <StackPanel Spacing="{StaticResource SpaceXs}"
                                            Visibility="{x:Bind IsDeviceVisible, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Output Device"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{x:Bind OutputDeviceNames}"
                                              SelectedItem="{x:Bind DeviceName, Mode=TwoWay}"
                                              Width="300"
                                              PlaceholderText="Select device…"/>
                                </StackPanel>

                                <!-- Invert toggle -->
                                <CheckBox Content="Invert"
                                          IsChecked="{x:Bind Invert, Mode=TwoWay}"/>

                                <!-- ── Tuning controls ──────────────────── -->
                                <TextBlock Text="Tuning"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"/>

                                <!-- Response curve -->
                                <StackPanel Spacing="{StaticResource SpaceXs}">
                                    <TextBlock Text="Response Curve"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox SelectedIndex="{x:Bind CurveIndex, Mode=TwoWay}"
                                              Width="{StaticResource ComboBoxStandardWidth}">
                                        <ComboBoxItem Content="Linear"/>
                                        <ComboBoxItem Content="Logarithmic"/>
                                        <ComboBoxItem Content="Exponential"/>
                                        <ComboBoxItem Content="S-Curve"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Dead zone -->
                                <StackPanel Spacing="{StaticResource SpaceXs}">
                                    <TextBlock Text="Dead Zone"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Slider Minimum="0"
                                            Maximum="0.45"
                                            Value="{x:Bind DeadZonePercent, Mode=TwoWay}"
                                            Width="{StaticResource SliderStandardWidth}"
                                            HorizontalAlignment="Left"
                                            StepFrequency="0.01"
                                            TickFrequency="0.05"
                                            TickPlacement="Outside"/>
                                </StackPanel>

                                <!-- Smoothing -->
                                <StackPanel Spacing="{StaticResource SpaceXs}">
                                    <TextBlock Text="Smoothing"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Slider Minimum="0"
                                            Maximum="0.95"
                                            Value="{x:Bind SmoothingFactor, Mode=TwoWay}"
                                            Width="{StaticResource SliderStandardWidth}"
                                            HorizontalAlignment="Left"
                                            StepFrequency="0.01"
                                            TickFrequency="0.1"
                                            TickPlacement="Outside"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </StackPanel>
    </ScrollViewer>
</Page>
