<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Volco.UI.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Volco.UI">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="16" MaxWidth="520" HorizontalAlignment="Left">

                <TextBlock Text="Software Update"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>

                <StackPanel Spacing="2">
                    <TextBlock x:Name="CurrentVersionText"
                               Text="Current version: v0.0.0"
                               Style="{StaticResource BodyTextBlockStyle}"/>
                    <TextBlock x:Name="StatusText"
                               Text="Click &quot;Check for Updates&quot; to begin."
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <ProgressBar x:Name="Progress"
                             IsIndeterminate="False"
                             Minimum="0" Maximum="1" Value="0"
                             Visibility="Collapsed"/>

                <TextBlock x:Name="NotesText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <CheckBox x:Name="UseCiCheckBox"
                          Content="Update from the latest CI build (advanced)"
                          Checked="OnUseCiChanged"
                          Unchecked="OnUseCiChanged"/>

                <StackPanel x:Name="TokenPanel" Spacing="6" Visibility="Collapsed">
                    <PasswordBox x:Name="TokenBox"
                                 Header="GitHub token (needs actions:read scope)"
                                 PlaceholderText="ghp_..."/>
                    <TextBlock Text="A token is required because GitHub Action artifacts are only downloadable when authenticated. The token is stored in your local config."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CheckButton"
                            Content="Check for Updates"
                            Click="OnCheckClicked"/>
                    <Button x:Name="UpdateButton"
                            Content="Update Now"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="False"
                            Click="OnUpdateClicked"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
