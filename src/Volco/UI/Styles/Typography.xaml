<?xml version="1.0" encoding="utf-8"?>
<!--
    Typography.xaml — named TextBlock styles based on WinUI built-in styles.

    BasedOn choices:
    - SectionHeaderTextStyle  → SubtitleTextBlockStyle  (larger, semi-bold; used for tab section headings)
    - CardTitleTextStyle       → BodyStrongTextBlockStyle (medium weight; used for settings card titles)
    - CaptionTextStyle         → CaptionTextBlockStyle    (12pt, secondary; used for hints and units)

    All three apply TextSecondaryBrush or TextPrimaryBrush as appropriate,
    using {ThemeResource} so they respond to theme switches.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Section heading (e.g. "Connection", "Audio Sliders") -->
    <Style x:Key="SectionHeaderTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="Margin"     Value="0,0,0,8"/>
    </Style>

    <!-- Settings card title (primary label on a SettingsCard) -->
    <Style x:Key="CardTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
    </Style>

    <!-- Caption / hint / unit label -->
    <Style x:Key="CaptionTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
    </Style>

</ResourceDictionary>
