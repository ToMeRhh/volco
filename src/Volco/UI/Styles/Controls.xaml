<?xml version="1.0" encoding="utf-8"?>
<!--
    Controls.xaml — shared control styles.

    Kept minimal (YAGNI). Provides:
    - SectionContainerStyle: a StackPanel style for tab section containers,
      with consistent vertical spacing between items.
    - SettingsGroupStyle: a StackPanel style for grouping related SettingsCards
      within a section, with tighter spacing.

    These styles do NOT require any custom template — they only set
    Spacing and Margin via setters, which are valid StackPanel properties
    in WinUI 3 (StackPanel.Spacing was added in WinUI / Windows 10 1803).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Outer container for a settings tab section -->
    <Style x:Key="SectionContainerStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Spacing"     Value="16"/>
        <Setter Property="Margin"      Value="0,0,0,24"/>
    </Style>

    <!-- Inner group of SettingsCards within a section -->
    <Style x:Key="SettingsGroupStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Spacing"     Value="4"/>
    </Style>

</ResourceDictionary>
