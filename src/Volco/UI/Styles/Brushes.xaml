<?xml version="1.0" encoding="utf-8"?>
<!--
    Brushes.xaml — semantic SolidColorBrush resources.

    Brushes are defined as top-level resources (NOT inside ThemeDictionaries).
    Each brush references its theme-scoped color from Colors.xaml via
    {ThemeResource}, which performs theme-aware lookup across all merged
    dictionaries' ThemeDictionaries. This is the correct WinUI pattern —
    {StaticResource} does not consult ThemeDictionaries of other merged
    dictionaries and would throw XamlParseException at load time.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AccentBrush"        Color="{ThemeResource AccentColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"       Color="{ThemeResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceCardBrush"   Color="{ThemeResource SurfaceCardColor}"/>
    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{ThemeResource SurfaceStrokeColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{ThemeResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="IconAccentBrush"    Color="{ThemeResource IconAccentColor}"/>

</ResourceDictionary>
