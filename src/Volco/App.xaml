<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Volco.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI controls must be first -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <!-- Design-system resource dictionaries (order matters: Tokens → Colors → Brushes → Typography → Controls) -->
                <ResourceDictionary Source="ms-appx:///UI/Styles/Tokens.xaml"/>
                <ResourceDictionary Source="ms-appx:///UI/Styles/Colors.xaml"/>
                <ResourceDictionary Source="ms-appx:///UI/Styles/Brushes.xaml"/>
                <ResourceDictionary Source="ms-appx:///UI/Styles/Typography.xaml"/>
                <ResourceDictionary Source="ms-appx:///UI/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
